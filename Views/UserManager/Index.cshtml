@{
    var currentRole = ViewBag.UserRole as string ?? Context.Session.GetString("UserRole") ?? "";
    var isAdmin = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background: linear-gradient(135deg, #f4f7fb 0%, #eef3fb 100%);
            color: #14213d;
        }

        .container {
            background: white;
            padding: 28px;
            border-radius: 18px;
            box-shadow: 0 18px 50px rgba(31, 55, 92, 0.12);
            margin-top: 32px;
            max-width: 1240px;
        }

        .page-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .page-heading h2 { margin: 0; font-weight: 750; }
        .page-heading p { margin: 4px 0 0; color: #6b7890; }
        .user-count {
            background: #eaf1ff;
            color: #245edb;
            padding: 7px 12px;
            border-radius: 999px;
            font-weight: 700;
        }

        .table-wrap { border: 1px solid #e4eaf3; border-radius: 14px; overflow: hidden; }
        .table { margin: 0; }
        .table thead th { background: #14213d; padding: 14px; border: 0; }
        .table tbody td { padding: 14px; vertical-align: middle; }
        .toolbar { gap: 12px; }
        .state-row td { padding: 42px !important; color: #748198; }
        .role-badge { background: #edf3ff; color: #285fc6; border-radius: 999px; padding: 6px 11px; font-weight: 650; }
        .role-badge.pending { background: #fff4de; color: #a15c00; }
        .project-stack { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
        .project-badge { background: #ecfdf5; color: #047857; border: 1px solid #bbf7d0; border-radius: 999px; padding: 5px 9px; font-size: 12px; font-weight: 700; }
        .project-badge.pending { background: #fff7ed; color: #c2410c; border-color: #fed7aa; }
        .project-access-editor { border: 1px solid #e4eaf3; border-radius: 12px; padding: 10px; background: #f8fbff; }
        .project-access-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 10px; border: 1px solid #dbe7f5; border-radius: 10px; background: #fff; margin-top: 8px; }
        .project-access-row strong { display: block; color: #14213d; }
        .project-access-row small { color: #65758b; font-weight: 700; }
        .action-button { border-radius: 8px; min-width: 72px; }

        @@media (max-width: 768px) {
            .container { margin: 12px; padding: 18px; }
            .page-heading, .toolbar { align-items: stretch !important; flex-direction: column; }
            #searchInput { width: 100% !important; }
        }

        .modal-content {
            border-radius: 8px;
        }

        .form-control {
            border-radius: 6px;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <button type="button" class="btn btn-outline-secondary mb-3" onclick="goBack()">&#8592; Back</button>
        <div class="page-heading">
            <div>
                <h2>User Management</h2>
                <p>Search, update, and manage application access.</p>
            </div>
            <span class="user-count" id="userCount">0 users</span>
        </div>

        <div class="toolbar d-flex justify-content-between mb-3">
            <input type="text" id="searchInput" class="form-control w-50" placeholder="Search Users..." onkeyup="searchUsers()">
            <button class="btn btn-primary" onclick="openUserModal()">+ Add New User</button>
        </div>

        <div class="table-wrap">
        <table class="table table-hover text-center">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                        <th>Project</th>
                    <th>
                        Role
     
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                    <tr class="state-row"><td colspan="5">Loading users...</td></tr>
            </tbody>
        </table>
        </div>

        <nav>
            <ul class="pagination justify-content-center" id="pagination">
                <!-- Pagination buttons will be injected here -->
            </ul>
        </nav>

    </div>



<!-- Add/Edit User Modal -->
    <div class="modal fade" id="userModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">User Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="userForm">
                        <input type="hidden" id="userId" name="Id">

                        <div class="mb-3">
                            <label class="form-label">Name:</label>
                            <input type="text" id="userName" name="FullName" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email:</label>
                            <input type="email" id="userEmail" name="Email" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Project:</label>
                            <select id="userProjectId" name="ProjectId" class="form-control mb-2">
                                <option value="">-- Select Project --</option>
                            </select>
                            <input type="text" id="userProjectDisplay" class="form-control mb-2" readonly style="display:none;" />
                            <input type="hidden" id="userProjectName" name="ProjectName" />
                            <label class="form-label">Role:</label>
                            <select id="userRole" name="Role" class="form-control">
                                @if (string.Equals(Context.Session.GetString("UserRole"), "Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="Admin">Admin</option>
                                }
                                <option value="Manager">Manager</option>
                                <option value="Surveyor">Surveyor</option>
                                <option value="User">User</option>
                            </select>
                            <div class="project-access-editor mt-3" id="projectAccessEditor">
                                <div>
                                    <strong>Project access</strong>
                                    <div class="small text-muted">Select a project and role, then use Save to apply changes.</div>
                                </div>
                                <div id="projectAccessList" class="mt-2"></div>
                            </div>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-3">
                            <label class="form-label">Password:</label>
                            <input type="password" id="userPassword" name="Password" class="form-control" disabled>

                        </div>

                        <!-- Confirm Password Field -->
                        <div class="mb-3">
                            <label class="form-label">Confirm Password:</label>
                            <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-control" disabled>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-success" onclick="saveUser()">Save</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<!-- ✅ jQuery AJAX Script -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
               // Globals
        let allUsers = [];
        let manageableProjects = [];
        let projectAccessDraft = [];
        let currentPage = 1;
        const usersPerPage = 10;
        const currentUserRole = "@currentRole";
        const isCurrentUserAdmin = currentUserRole.toLowerCase() === "admin";
                const currentProjectId = "@(ViewBag.ProjectId ?? "")";
        const currentProjectName = "@(ViewBag.ProjectName ?? "")";
                console.log("USER MANAGER DEBUG", {
            currentUserRole,
            isCurrentUserAdmin,
            currentProjectId,
            currentProjectName
        });
        // Load users on page ready
        $(document).ready(function () {
            loadUsers();
        });

        // Go Back Logic
                function goBack() {
            window.location.href = "/Home/AdminDashboard";
        }

        // Load Users
        function loadUsers() {
            $("#userTableBody").html('<tr class="state-row"><td colspan="5">Loading users...</td></tr>');
            $.ajax({
                url: "/UserManager/GetAll",
                type: "GET",
                success: function (users) {
                    allUsers = Array.isArray(users) ? users : [];
                    currentPage = 1;
                    $("#userCount").text(`${allUsers.length} ${allUsers.length === 1 ? "user" : "users"}`);
                    renderTable(currentPage);
                    renderPagination();
                },
                error: function (xhr) {
                    const message = xhr.responseText || "Unable to load users. Please sign in again.";
                    $("#userTableBody").html(`<tr class="state-row"><td colspan="5">${escapeHtml(message)}</td></tr>`);
                    $("#userCount").text("Unavailable");
                }
            });
        }

        function escapeHtml(value) {
            return $("<div>").text(value ?? "").html();
        }

        function normalizeProjectAccess(row) {
            const projectId = Number(row.projectId ?? row.ProjectId ?? 0);
            const project = manageableProjects.find(p => Number(p.id ?? p.Id) === projectId);
            return {
                Id: Number(row.id ?? row.Id ?? 0),
                UserId: Number(row.userId ?? row.UserId ?? 0),
                ProjectId: projectId,
                ProjectName: row.projectName ?? row.ProjectName ?? project?.name ?? project?.Name ?? "",
                ProjectCode: row.projectCode ?? row.ProjectCode ?? project?.code ?? project?.Code ?? "",
                RoleId: Number(row.roleId ?? row.RoleId ?? 0) || null,
                RoleName: row.roleName ?? row.RoleName ?? "",
                IsActive: row.isActive ?? row.IsActive ?? true,
                IsApproved: row.isApproved ?? row.IsApproved ?? true,
                IsRejected: row.isRejected ?? row.IsRejected ?? false
            };
        }

        function renderProjectAccessEditor() {
            const list = $("#projectAccessList");
            const selectedRole = ($("#userRole").val() || "").toLowerCase();
            const isAdminRole = selectedRole === "admin";
            $("#projectAccessEditor").toggle(!isAdminRole);

            list.empty();
            if (isAdminRole) return;

            const activeRows = projectAccessDraft.filter(x => x.ProjectId > 0 && x.IsRejected !== true);
            if (!activeRows.length) {
                list.html('<div class="small text-muted mt-2">No project access added yet.</div>');
                return;
            }

            activeRows.forEach(row => {
                list.append(`
                    <div class="project-access-row">
                        <div>
                            <strong>${escapeHtml(row.ProjectName || "Project")}</strong>
                            <small>${escapeHtml(row.RoleName || "Role not selected")}</small>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeProjectAccess(${row.ProjectId})">Remove</button>
                    </div>`);
            });
        }

        function addOrUpdateProjectAccess(showAlerts = true) {
            const selectedRole = $("#userRole").val();
            if ((selectedRole || "").toLowerCase() === "admin") return true;

            const projectId = Number($("#userProjectId").val() || 0);
            if (projectId <= 0) {
                if (showAlerts) alert("Please select a project.");
                return false;
            }

            if (!selectedRole) {
                if (showAlerts) alert("Please select a role.");
                return false;
            }

            const projectName = $("#userProjectId option:selected").text();
            const roleId = Number($("#userRole option:selected").data("role-id") || 0) || null;
            const existingIndex = projectAccessDraft.findIndex(x => Number(x.ProjectId) === projectId);
            const nextRow = {
                Id: existingIndex >= 0 ? projectAccessDraft[existingIndex].Id : 0,
                UserId: Number($("#userId").val() || 0),
                ProjectId: projectId,
                ProjectName: projectName,
                RoleId: roleId,
                RoleName: selectedRole,
                IsActive: true,
                IsApproved: true,
                IsRejected: false
            };

            if (existingIndex >= 0)
                projectAccessDraft.splice(existingIndex, 1, nextRow);
            else
                projectAccessDraft.push(nextRow);

            renderProjectAccessEditor();
            return true;
        }

        function removeProjectAccess(projectId) {
            projectAccessDraft = projectAccessDraft.filter(x => Number(x.ProjectId) !== Number(projectId));
            const remaining = projectAccessDraft[0];
            if (Number($("#userProjectId").val() || 0) === Number(projectId)) {
                if (remaining) {
                    $("#userProjectId").val(remaining.ProjectId);
                    $("#userProjectName").val(remaining.ProjectName || "");
                    loadRoles(remaining.ProjectId, remaining.RoleName || null);
                } else {
                    $("#userProjectId").val("");
                    $("#userProjectName").val("");
                    $("#userRole").val("");
                }
            }
            renderProjectAccessEditor();
        }

        // Search Users
        function searchUsers() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let filtered = allUsers.filter(user =>
                (user.fullName || "").toLowerCase().includes(input) ||
                (user.email || "").toLowerCase().includes(input) ||
                (user.role || "").toLowerCase().includes(input) ||
                (user.requestedRole || "").toLowerCase().includes(input) ||
                getProjectAccessText(user).toLowerCase().includes(input) ||
                getStatusText(user).toLowerCase().includes(input)
            );
            renderFilteredTable(filtered);
            renderFilteredPagination(filtered);
        }

        // Filter Users by Role
        function filterUsers() {
            let filter = document.getElementById("roleFilter").value;
            let filtered = allUsers.filter(user => filter === "" || user.role === filter);
            renderFilteredTable(filtered);
            renderFilteredPagination(filtered);
        }

        // Render Full Table
        function renderTable(page) {
            let start = (page - 1) * usersPerPage;
            let end = start + usersPerPage;
            let paginated = allUsers.slice(start, end);
            renderRows(paginated);
        }

        // Render Filtered Table
        function renderFilteredTable(filteredUsers) {
            let startIndex = (currentPage - 1) * usersPerPage;
            let endIndex = startIndex + usersPerPage;
            let paginated = filteredUsers.slice(startIndex, endIndex);
            renderRows(paginated);
        }

        // Render Rows
        function renderRows(users) {
            let tableBody = $("#userTableBody");
            tableBody.empty();
            if (!users.length) {
                tableBody.html('<tr class="state-row"><td colspan="5">No users found.</td></tr>');
                return;
            }
            users.forEach(user => {
                const isPending = user.isApproved === false && user.requestedRole;
                const roleText = isPending ? `Pending: ${user.requestedRole}` : user.role;
                const roleClass = isPending ? "role-badge pending" : "role-badge";
                const projectHtml = renderProjectBadges(user);
                const statusText = getStatusText(user);
                let row = `<tr>
                    <td class="fw-semibold">
                        ${escapeHtml(user.fullName)}
                        <div class="small text-muted">${escapeHtml(statusText)}</div>
                    </td>
                            <td>${escapeHtml(user.email)}</td>
        <td>${projectHtml}</td>
        <td><span class="${roleClass}">${escapeHtml(roleText)}</span></td>
                    <td>
                        <button class="btn btn-outline-primary btn-sm action-button" onclick="editUser(${user.id})">Edit</button>
                        <button class="btn btn-outline-danger btn-sm action-button" onclick="deleteUser(${user.id})">Delete</button>
                    </td>
                </tr>`;
                tableBody.append(row);
            });
        }

        function getProjectAccesses(user) {
            const rows = user.projectAccesses || user.ProjectAccesses || [];
            return Array.isArray(rows) ? rows : [];
        }

        function getPrimaryProjectId(user) {
            const projectId = Number(user.projectId || user.ProjectId || 0);
            if (projectId > 0) return projectId;
            const rows = getProjectAccesses(user).filter(row => row && row.isRejected !== true && row.IsRejected !== true);
            if (!rows.length) return 0;
            return Number(rows[0].projectId || rows[0].ProjectId || 0);
        }

        function getProjectAccessText(user) {
            const rows = getProjectAccesses(user);
            if (rows.length) {
                return rows.map(row => {
                    const name = row.projectName || row.ProjectName || "Project";
                    const role = row.roleName || row.RoleName || user.role || "";
                    return `${name} ${role}`.trim();
                }).join(", ");
            }
            return user.projectName || user.ProjectName || "-";
        }

        function renderProjectBadges(user) {
            const rows = getProjectAccesses(user);
            if (rows.length) {
                const html = rows.map(row => {
                    const name = row.projectName || row.ProjectName || "Project";
                    const role = row.roleName || row.RoleName || "";
                    const pending = row.isApproved === false || row.IsApproved === false;
                    return `<span class="project-badge ${pending ? "pending" : ""}">${escapeHtml(name)}${role ? " - " + escapeHtml(role) : ""}</span>`;
                }).join("");
                return `<div class="project-stack">${html}</div>`;
            }
            return `<span class="project-badge">${escapeHtml(user.projectName || user.ProjectName || "-")}</span>`;
        }

        function getStatusText(user) {
            if (user.isRejected === true || user.IsRejected === true) return "Rejected";
            if (user.isApproved === false || user.IsApproved === false) return "Pending";
            return "Approved";
        }

        // Render Full Pagination
        function renderPagination() {
            let totalPages = Math.ceil(allUsers.length / usersPerPage);
            let pagination = $("#pagination");
            pagination.empty();
            for (let i = 1; i <= totalPages; i++) {
                pagination.append(`<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-outline-primary'} me-1" onclick="gotoPage(${i})">${i}</button>`);
            }
        }

        // Render Filtered Pagination
        function renderFilteredPagination(filteredUsers) {
            let pageCount = Math.ceil(filteredUsers.length / usersPerPage);
            let pagination = $("#pagination");
            pagination.empty();
            for (let i = 1; i <= pageCount; i++) {
                let active = i === currentPage ? "active" : "";
                pagination.append(`<li class="page-item ${active}">
                    <a class="page-link" href="#" onclick="changeFilteredPage(${i})">${i}</a>
                </li>`);
            }
        }

        function gotoPage(page) {
            currentPage = page;
            renderTable(page);
            renderPagination();
        }

        function changeFilteredPage(page) {
            currentPage = page;
            searchUsers(); // Re-applies filtering + pagination
        }

        // Open Add User Modal
        function openUserModal() {
            $("#userId").val("");
            $("#userName").val("");
            $("#userEmail").val("");
            projectAccessDraft = [];
                   loadProjects(null).then(() => {
            const defaultRole = isCurrentUserAdmin ? "User" : "Surveyor";
            if ($("#userRole option[value='" + defaultRole + "']").length) {
                $("#userRole").val(defaultRole);
            }
            renderProjectAccessEditor();
        });
         if (!isCurrentUserAdmin) {
            $("#userRole option[value='Admin']").remove();
        }
            $("#userPassword").val("").prop("disabled", false).parent().show();
            $("#confirmPassword").val("").prop("disabled", false).parent().show();
            $("#userModal").modal("show");
        }

        // Edit User
               // Edit User
        function editUser(id) {
            $.ajax({
                url: `/UserManager/GetById/${id}`,
                type: "GET",
                success: async function (user) {
                    $("#userId").val(user.id);
                    $("#userName").val(user.fullName);
                    $("#userEmail").val(user.email);
                            if (!isCurrentUserAdmin && (user.role || "").toLowerCase() === "admin") {
            alert("You do not have permission to access Admin users.");
            return;
        }

        if (!isCurrentUserAdmin) {
            $("#userRole option[value='Admin']").remove();
        }

                            projectAccessDraft = getProjectAccesses(user)
                                .filter(row => row && row.isRejected !== true && row.IsRejected !== true)
                                .map(normalizeProjectAccess)
                                .filter(row => row.ProjectId > 0);

                            const editProjectId = getPrimaryProjectId(user) || currentProjectId;
        const editRole = user.role || user.roleName || user.requestedRole;

        await loadProjects(editProjectId);
        await loadRoles(editProjectId, editRole);
        renderProjectAccessEditor();
                    $("#userPassword").val("").prop("disabled", true).parent().hide();
                    $("#confirmPassword").val("").prop("disabled", true).parent().hide();
                    $("#userModal").modal("show");
                },
                error: function () {
                    alert("Failed to fetch user.");
                }
            });
        }
              async function loadProjects(selectedProjectId) {
            const select = $("#userProjectId");
            const display = $("#userProjectDisplay");

            select.html('<option value="">-- Select Project --</option>');

            display.hide();
            select.show().prop("disabled", false);

                    const projectResponse = await $.getJSON("/UserManager/Projects");
        const projects = Array.isArray(projectResponse) ? projectResponse : [];
        manageableProjects = projects;

        projects.forEach(project => {
                const id = project.id ?? project.Id;
                const name = project.name ?? project.Name;

                if (!id || !name) return;

                select.append(`<option value="${id}">${escapeHtml(name)}</option>`);
            });

            const preferredProjectId = selectedProjectId || (!isCurrentUserAdmin && projects.length === 1 ? (projects[0].id ?? projects[0].Id) : null);

            if (preferredProjectId) {
                select.val(preferredProjectId);
                const projectName = $("#userProjectId option:selected").text();
                $("#userProjectName").val(projectName);
                await loadRoles(preferredProjectId, null);
            }
        }

                async function loadRoles(projectId, selectedRole) {
            const roleSelect = $("#userRole");
            roleSelect.html('<option value="">-- Select Role --</option>');
                    if (isCurrentUserAdmin) {
            roleSelect.append('<option value="Admin" data-role-id="">Admin</option>');
        }
            if (!projectId) return;

                    const roleResponse = await $.getJSON(`/UserManager/Roles?projectId=${projectId}`);
        const roles = Array.isArray(roleResponse) ? roleResponse : [];

        roles.forEach(role => {
                const roleName = role.roleName ?? role.RoleName;

                if (!roleName) return;

                if (!isCurrentUserAdmin && roleName.toLowerCase() === "admin")
                    return;

                        const roleId = role.id ?? role.Id;
        roleSelect.append(`<option value="${escapeHtml(roleName)}" data-role-id="${roleId || ""}">${escapeHtml(roleName)}</option>`);
            });

            if (selectedRole)
                roleSelect.val(selectedRole);
        }
                $("#userRole").on("change", function () {
            const selectedRole = ($(this).val() || "").toLowerCase();

            if (isCurrentUserAdmin && selectedRole === "admin") {
                $("#userProjectId").val("").prop("disabled", true);
                $("#userProjectName").val("All Projects");
            } else if (isCurrentUserAdmin) {
                $("#userProjectId").prop("disabled", false);
            }
            renderProjectAccessEditor();
        });
                 $("#userProjectId").on("change", async function () {
            const projectName = $("#userProjectId option:selected").text();
            $("#userProjectName").val(projectName);

            await loadRoles($(this).val(), null);
        });
        // Save User
        function saveUser() {
            let id = parseInt($("#userId").val()) || 0;
            let isNew = id === 0;
            let password = $("#userPassword").val();
            let confirmPassword = $("#confirmPassword").val();

            if (isNew) {
                if (!password || !confirmPassword) {
                    alert("Password and Confirm Password are required.");
                    return;
                }
                if (password !== confirmPassword) {
                    alert("Passwords do not match.");
                    return;
                }
            }
                    if (!isCurrentUserAdmin && ($("#userRole").val() || "").toLowerCase() === "admin") {
            alert("Only Admin can create Admin users.");
            return;
        }
            const selectedRole = $("#userRole").val();
            const isAdminRole = (selectedRole || "").toLowerCase() === "admin";
            const selectedProjectId = Number($("#userProjectId").val() || 0);

            if (!isAdminRole && selectedProjectId > 0 && selectedRole) {
                addOrUpdateProjectAccess(false);
            }

            if (!isAdminRole && !projectAccessDraft.length) {
                alert("Please select at least one project access.");
                return;
            }

            const firstAccess = isAdminRole ? null : projectAccessDraft[0];

            let user = {
                Id: id,
                FullName: $("#userName").val(),
                Email: $("#userEmail").val(),
                Role: selectedRole,
                     ProjectId: isAdminRole
            ? null
            : firstAccess.ProjectId,

        ProjectName: isAdminRole
            ? "All Projects"
            : firstAccess.ProjectName,
        RoleName: isAdminRole ? selectedRole : firstAccess.RoleName,
        RoleId: isAdminRole ? Number($("#userRole option:selected").data("role-id") || 0) : firstAccess.RoleId,
                ProjectAccesses: isAdminRole ? [] : projectAccessDraft,
                ReplaceProjectAccesses: true,
                IsApproved: true,
                RequestedRole: null,
                Password: isNew ? password : null
            };

            $.ajax({
                url: "/UserManager/SaveUser",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(user),
                success: function (res) {
                    if (res.success) {
                        alert("User saved.");
                        $("#userModal").modal("hide");
                        loadUsers();
                    } else {
                        alert("Save failed: " + res.message);
                    }
                },
                error: function () {
                    alert("An error occurred while saving.");
                }
            });
        }
                function deleteUser(id) {
            if (confirm("Are you sure you want to delete this user?")) {
                $.ajax({
                    url: `/UserManager/Delete/${id}`,
                    type: "POST", // ✅ use POST, not DELETE
                    success: function () {
                        loadUsers();
                    },
                    error: function (xhr) {
                        const message = xhr.responseText || "Failed to delete user.";
                        alert(message);
                    }
                });
            }
        }

</script>
</body>
</html>
