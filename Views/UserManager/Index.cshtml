@{
    var currentRole = ViewBag.UserRole as string ?? Context.Session.GetString("UserRole") ?? "";
    var isAdmin = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background: linear-gradient(135deg, #f4f7fb 0%, #eef3fb 100%);
            color: #14213d;
        }

        .container {
            background: white;
            padding: 28px;
            border-radius: 18px;
            box-shadow: 0 18px 50px rgba(31, 55, 92, 0.12);
            margin-top: 32px;
            max-width: 1240px;
        }

        .page-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .page-heading h2 { margin: 0; font-weight: 750; }
        .page-heading p { margin: 4px 0 0; color: #6b7890; }
        .user-count {
            background: #eaf1ff;
            color: #245edb;
            padding: 7px 12px;
            border-radius: 999px;
            font-weight: 700;
        }

        .table-wrap { border: 1px solid #e4eaf3; border-radius: 14px; overflow: hidden; }
        .table { margin: 0; }
        .table thead th { background: #14213d; padding: 14px; border: 0; }
        .table tbody td { padding: 14px; vertical-align: middle; }
        .toolbar { gap: 12px; }
        .state-row td { padding: 42px !important; color: #748198; }
        .role-badge { background: #edf3ff; color: #285fc6; border-radius: 999px; padding: 6px 11px; font-weight: 650; }
        .role-badge.pending { background: #fff4de; color: #a15c00; }
        .action-button { border-radius: 8px; min-width: 72px; }

        @@media (max-width: 768px) {
            .container { margin: 12px; padding: 18px; }
            .page-heading, .toolbar { align-items: stretch !important; flex-direction: column; }
            #searchInput { width: 100% !important; }
        }

        .modal-content {
            border-radius: 8px;
        }

        .form-control {
            border-radius: 6px;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <button type="button" class="btn btn-outline-secondary mb-3" onclick="goBack()">&#8592; Back</button>
        <div class="page-heading">
            <div>
                <h2>User Management</h2>
                <p>Search, update, and manage application access.</p>
            </div>
            <span class="user-count" id="userCount">0 users</span>
        </div>

        <div class="toolbar d-flex justify-content-between mb-3">
            <input type="text" id="searchInput" class="form-control w-50" placeholder="Search Users..." onkeyup="searchUsers()">
            <button class="btn btn-primary" onclick="openUserModal()">+ Add New User</button>
        </div>

        <div class="table-wrap">
        <table class="table table-hover text-center">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                        <th>Project</th>
                    <th>
                        Role
     
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                    <tr class="state-row"><td colspan="5">Loading users...</td></tr>
            </tbody>
        </table>
        </div>

        <nav>
            <ul class="pagination justify-content-center" id="pagination">
                <!-- Pagination buttons will be injected here -->
            </ul>
        </nav>

    </div>



<!-- Add/Edit User Modal -->
    <div class="modal fade" id="userModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">User Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="userForm">
                        <input type="hidden" id="userId" name="Id">

                        <div class="mb-3">
                            <label class="form-label">Name:</label>
                            <input type="text" id="userName" name="FullName" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email:</label>
                            <input type="email" id="userEmail" name="Email" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Project:</label>
                            <select id="userProjectId" name="ProjectId" class="form-control mb-2">
                                <option value="">-- Select Project --</option>
                            </select>
                            <input type="text" id="userProjectDisplay" class="form-control mb-2" readonly style="display:none;" />
                            <input type="hidden" id="userProjectName" name="ProjectName" />
                            <label class="form-label">Role:</label>
                            <select id="userRole" name="Role" class="form-control">
                                @if (string.Equals(Context.Session.GetString("UserRole"), "Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="Admin">Admin</option>
                                }
                                <option value="Manager">Manager</option>
                                <option value="Surveyor">Surveyor</option>
                                <option value="User">User</option>
                            </select>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-3">
                            <label class="form-label">Password:</label>
                            <input type="password" id="userPassword" name="Password" class="form-control" disabled>

                        </div>

                        <!-- Confirm Password Field -->
                        <div class="mb-3">
                            <label class="form-label">Confirm Password:</label>
                            <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-control" disabled>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-success" onclick="saveUser()">Save</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<!-- ✅ jQuery AJAX Script -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
               // Globals
        let allUsers = [];
        let currentPage = 1;
        const usersPerPage = 10;
        const currentUserRole = "@currentRole";
        const isCurrentUserAdmin = currentUserRole.toLowerCase() === "admin";
                const currentProjectId = "@(ViewBag.ProjectId ?? "")";
        const currentProjectName = "@(ViewBag.ProjectName ?? "")";
                console.log("USER MANAGER DEBUG", {
            currentUserRole,
            isCurrentUserAdmin,
            currentProjectId,
            currentProjectName
        });
        // Load users on page ready
        $(document).ready(function () {
            loadUsers();
        });

        // Go Back Logic
                function goBack() {
            window.location.href = "/Home/AdminDashboard";
        }

        // Load Users
        function loadUsers() {
            $("#userTableBody").html('<tr class="state-row"><td colspan="5">Loading users...</td></tr>');
            $.ajax({
                url: "/UserManager/GetAll",
                type: "GET",
                success: function (users) {
                    allUsers = Array.isArray(users) ? users : [];
                    currentPage = 1;
                    $("#userCount").text(`${allUsers.length} ${allUsers.length === 1 ? "user" : "users"}`);
                    renderTable(currentPage);
                    renderPagination();
                },
                error: function (xhr) {
                    const message = xhr.responseText || "Unable to load users. Please sign in again.";
                    $("#userTableBody").html(`<tr class="state-row"><td colspan="4">${escapeHtml(message)}</td></tr>`);
                    $("#userCount").text("Unavailable");
                }
            });
        }

        function escapeHtml(value) {
            return $("<div>").text(value ?? "").html();
        }

        // Search Users
        function searchUsers() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let filtered = allUsers.filter(user =>
                (user.fullName || "").toLowerCase().includes(input) ||
                (user.email || "").toLowerCase().includes(input) ||
                (user.role || "").toLowerCase().includes(input) ||
                (user.requestedRole || "").toLowerCase().includes(input)
            );
            renderFilteredTable(filtered);
            renderFilteredPagination(filtered);
        }

        // Filter Users by Role
        function filterUsers() {
            let filter = document.getElementById("roleFilter").value;
            let filtered = allUsers.filter(user => filter === "" || user.role === filter);
            renderFilteredTable(filtered);
            renderFilteredPagination(filtered);
        }

        // Render Full Table
        function renderTable(page) {
            let start = (page - 1) * usersPerPage;
            let end = start + usersPerPage;
            let paginated = allUsers.slice(start, end);
            renderRows(paginated);
        }

        // Render Filtered Table
        function renderFilteredTable(filteredUsers) {
            let startIndex = (currentPage - 1) * usersPerPage;
            let endIndex = startIndex + usersPerPage;
            let paginated = filteredUsers.slice(startIndex, endIndex);
            renderRows(paginated);
        }

        // Render Rows
        function renderRows(users) {
            let tableBody = $("#userTableBody");
            tableBody.empty();
            if (!users.length) {
                tableBody.html('<tr class="state-row"><td colspan="5">No users found.</td></tr>');
                return;
            }
            users.forEach(user => {
                const isPending = user.isApproved === false && user.requestedRole;
                const roleText = isPending ? `Pending: ${user.requestedRole}` : user.role;
                const roleClass = isPending ? "role-badge pending" : "role-badge";
                let row = `<tr>
                    <td class="fw-semibold">${escapeHtml(user.fullName)}</td>
                            <td>${escapeHtml(user.email)}</td>
        <td>${escapeHtml(user.projectName || "-")}</td>
        <td><span class="${roleClass}">${escapeHtml(roleText)}</span></td>
                    <td>
                        <button class="btn btn-outline-primary btn-sm action-button" onclick="editUser(${user.id})">Edit</button>
                        <button class="btn btn-outline-danger btn-sm action-button" onclick="deleteUser(${user.id})">Delete</button>
                    </td>
                </tr>`;
                tableBody.append(row);
            });
        }

        // Render Full Pagination
        function renderPagination() {
            let totalPages = Math.ceil(allUsers.length / usersPerPage);
            let pagination = $("#pagination");
            pagination.empty();
            for (let i = 1; i <= totalPages; i++) {
                pagination.append(`<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-outline-primary'} me-1" onclick="gotoPage(${i})">${i}</button>`);
            }
        }

        // Render Filtered Pagination
        function renderFilteredPagination(filteredUsers) {
            let pageCount = Math.ceil(filteredUsers.length / usersPerPage);
            let pagination = $("#pagination");
            pagination.empty();
            for (let i = 1; i <= pageCount; i++) {
                let active = i === currentPage ? "active" : "";
                pagination.append(`<li class="page-item ${active}">
                    <a class="page-link" href="#" onclick="changeFilteredPage(${i})">${i}</a>
                </li>`);
            }
        }

        function gotoPage(page) {
            currentPage = page;
            renderTable(page);
            renderPagination();
        }

        function changeFilteredPage(page) {
            currentPage = page;
            searchUsers(); // Re-applies filtering + pagination
        }

        // Open Add User Modal
        function openUserModal() {
            $("#userId").val("");
            $("#userName").val("");
            $("#userEmail").val("");
                   loadProjects(null).then(() => {
            const defaultRole = isCurrentUserAdmin ? "User" : "Surveyor";
            if ($("#userRole option[value='" + defaultRole + "']").length) {
                $("#userRole").val(defaultRole);
            }
        });
         if (!isCurrentUserAdmin) {
            $("#userRole option[value='Admin']").remove();
        }
            $("#userPassword").val("").prop("disabled", false).parent().show();
            $("#confirmPassword").val("").prop("disabled", false).parent().show();
            $("#userModal").modal("show");
        }

        // Edit User
               // Edit User
        function editUser(id) {
            $.ajax({
                url: `/UserManager/GetById/${id}`,
                type: "GET",
                success: async function (user) {
                    $("#userId").val(user.id);
                    $("#userName").val(user.fullName);
                    $("#userEmail").val(user.email);
                            if (!isCurrentUserAdmin && (user.role || "").toLowerCase() === "admin") {
            alert("You do not have permission to access Admin users.");
            return;
        }

        if (!isCurrentUserAdmin) {
            $("#userRole option[value='Admin']").remove();
        }

                            const editProjectId = user.projectId || currentProjectId;
        const editRole = user.role || user.roleName || user.requestedRole;

        await loadProjects(editProjectId);
        await loadRoles(editProjectId, editRole);
                    $("#userPassword").val("").prop("disabled", true).parent().hide();
                    $("#confirmPassword").val("").prop("disabled", true).parent().hide();
                    $("#userModal").modal("show");
                },
                error: function () {
                    alert("Failed to fetch user.");
                }
            });
        }
              async function loadProjects(selectedProjectId) {
            const select = $("#userProjectId");
            const display = $("#userProjectDisplay");

            select.html('<option value="">-- Select Project --</option>');

            if (!isCurrentUserAdmin) {
                select.hide().prop("disabled", true);

                $("#userProjectId").html(`<option value="${currentProjectId}">${currentProjectName}</option>`);
                $("#userProjectId").val(currentProjectId);

                display.val(currentProjectName || "Current Project").show();

                $("#userProjectName").val(currentProjectName);

                await loadRoles(currentProjectId, null);
                return;
            }

            display.hide();
            select.show().prop("disabled", false);

                    const projectResponse = await $.getJSON("/UserManager/Projects");
        const projects = Array.isArray(projectResponse) ? projectResponse : [];

        projects.forEach(project => {
                const id = project.id ?? project.Id;
                const name = project.name ?? project.Name;

                if (!id || !name) return;

                select.append(`<option value="${id}">${escapeHtml(name)}</option>`);
            });

            if (selectedProjectId) {
                select.val(selectedProjectId);
                const projectName = $("#userProjectId option:selected").text();
                $("#userProjectName").val(projectName);
                await loadRoles(selectedProjectId, null);
            }
        }

                async function loadRoles(projectId, selectedRole) {
            const roleSelect = $("#userRole");
            roleSelect.html('<option value="">-- Select Role --</option>');
                    if (isCurrentUserAdmin) {
            roleSelect.append('<option value="Admin" data-role-id="">Admin</option>');
        }
            if (!projectId) return;

                    const roleResponse = await $.getJSON(`/UserManager/Roles?projectId=${projectId}`);
        const roles = Array.isArray(roleResponse) ? roleResponse : [];

        roles.forEach(role => {
                const roleName = role.roleName ?? role.RoleName;

                if (!roleName) return;

                if (!isCurrentUserAdmin && roleName.toLowerCase() === "admin")
                    return;

                        const roleId = role.id ?? role.Id;
        roleSelect.append(`<option value="${escapeHtml(roleName)}" data-role-id="${roleId || ""}">${escapeHtml(roleName)}</option>`);
            });

            if (selectedRole)
                roleSelect.val(selectedRole);
        }
                $("#userRole").on("change", function () {
            const selectedRole = ($(this).val() || "").toLowerCase();

            if (isCurrentUserAdmin && selectedRole === "admin") {
                $("#userProjectId").val("").prop("disabled", true);
                $("#userProjectName").val("All Projects");
            } else if (isCurrentUserAdmin) {
                $("#userProjectId").prop("disabled", false);
            }
        });
                 $("#userProjectId").on("change", async function () {
            if (!isCurrentUserAdmin) return;

            const projectName = $("#userProjectId option:selected").text();
            $("#userProjectName").val(projectName);

            await loadRoles($(this).val(), null);
        });
        // Save User
        function saveUser() {
            let id = parseInt($("#userId").val()) || 0;
            let isNew = id === 0;
            let password = $("#userPassword").val();
            let confirmPassword = $("#confirmPassword").val();

            if (isNew) {
                if (!password || !confirmPassword) {
                    alert("Password and Confirm Password are required.");
                    return;
                }
                if (password !== confirmPassword) {
                    alert("Passwords do not match.");
                    return;
                }
            }
                    if (!isCurrentUserAdmin && ($("#userRole").val() || "").toLowerCase() === "admin") {
            alert("Only Admin can create Admin users.");
            return;
        }
            let user = {
                Id: id,
                FullName: $("#userName").val(),
                Email: $("#userEmail").val(),
                Role: $("#userRole").val(),
                     ProjectId: ($("#userRole").val() || "").toLowerCase() === "admin"
            ? null
            : Number((isCurrentUserAdmin ? $("#userProjectId").val() : currentProjectId) || 0),

        ProjectName: ($("#userRole").val() || "").toLowerCase() === "admin"
            ? "All Projects"
            : (isCurrentUserAdmin ? $("#userProjectName").val() : currentProjectName),
        RoleName: $("#userRole").val(),
        RoleId: Number($("#userRole option:selected").data("role-id") || 0),
                IsApproved: true,
                RequestedRole: null,
                Password: isNew ? password : null
            };

            $.ajax({
                url: "/UserManager/SaveUser",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(user),
                success: function (res) {
                    if (res.success) {
                        alert("User saved.");
                        $("#userModal").modal("hide");
                        loadUsers();
                    } else {
                        alert("Save failed: " + res.message);
                    }
                },
                error: function () {
                    alert("An error occurred while saving.");
                }
            });
        }
                function deleteUser(id) {
            if (confirm("Are you sure you want to delete this user?")) {
                $.ajax({
                    url: `/UserManager/Delete/${id}`,
                    type: "POST", // ✅ use POST, not DELETE
                    success: function () {
                        loadUsers();
                    },
                    error: function (xhr) {
                        const message = xhr.responseText || "Failed to delete user.";
                        alert(message);
                    }
                });
            }
        }

</script>
</body>
</html>
