<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Certificate Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Font Awesome (optional, only if you use fa icons) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">



    <style>
        body {
            background: url('/images/.png') no-repeat top center;
            background-size:900px auto; /* Adjust width and height as needed */
            background-attachment: fixed;
            background-color: #121212; /* fallback background */
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
        }



        .navbar {
            background-color: #1f1f1f;
            border-bottom: 2px solid #f5c518;
        }

            .navbar .nav-link {
                color: #fff !important;
            }

                .navbar .nav-link.active, .navbar .nav-link:hover {
                    color: #f5c518 !important;
                    font-weight: bold;
                }

        .card {
            background-color: #1e1e1e;
            border: none;
            color: #fff;
        }

        .card-header {
            background-color: #2a2a2a;
            border-bottom: 1px solid #333;
            font-weight: bold;
        }

        .btn-primary, .btn-outline-primary {
            background-color: #f5c518;
            color: #000;
            border: none;
        }

            .btn-outline-primary:hover {
                background-color: #ffe066;
                color: #000;
            }

        .table {
            color: #fff;
        }

            .table thead {
                background-color: #333;
                color: #f5c518;
            }

        .table-hover tbody tr:hover {
            background-color: #2a2a2a;
        }

        .modal-content {
            background-color: #2c2c2c;
            color: #fff;
        }

        .modal-header {
            border-bottom: 1px solid #444;
        }
    </style>

</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg px-4">
        <a class="navbar-brand d-flex align-items-center gap-2 text-white" href="#">
            <img src="~/images/Mainlogo.png" alt="Logo" width="35" height="35" class="rounded-circle">
            <span class="fw-bold">Certificate Management</span>
        </a>



        <div class="ms-auto d-flex align-items-center gap-4">
            <p class="text-white mb-0">Hi, @Context.Session.GetString("UserFullName")</p>

          

            <ul class="navbar-nav flex-row gap-3">
                <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Auth")"><i class="fa fa-user-circle"></i></a></li>
                <li class="nav-item"><a class="nav-link" href="@Url.Action("ChangePassword", "Auth")"><i class="fa fa-key"></i></a></li>
                <li class="nav-item"><a class="nav-link text-danger" href="#" onclick="logoutUser()"><i class="fa fa-sign-out-alt"></i></a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Dashboard Cards -->
    <div class="container mt-5 text-center">
    @*     <h2 class="mb-4">Certificate Management</h2> *@

        <div class="row justify-content-center g-4">
            <!-- Form Manager -->
            <div class="col-md-4">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">Form Manager</div>
                    <div class="card-body">
                        <p>Manage and Create Certificates.</p>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCertificateModal">
                                Create Certificate
                            </button>
                            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#viewCertificatesModal">
                                View Demo Certificates
                            </button>
                        </div>
                        <div class="modal fade" id="viewCertificatesModal" tabindex="-1" aria-labelledby="viewCertificatesModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content shadow">
                                    <div class="modal-header bg-secondary text-white">
                                        <h5 class="modal-title" id="viewCertificatesModalLabel">Select Certificate Type</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <p>Please select a certificate type to view:</p>
                                        <div class="d-grid gap-2">
                                            <a asp-controller="Home" asp-action="TowageDemo" class="btn btn-outline-primary">Towage Certificate</a>
                                            <a asp-controller="Home" asp-action="SeaFasteningDemo" class="btn btn-outline-success">SeaFastening Certificate</a>
                                            <a asp-controller="Home" asp-action="LoadoutDemo" class="btn btn-outline-warning">Loadout Certificate</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
 
    <!-- Modal: Create Certificate -->
    <div class="modal fade" id="createCertificateModal" tabindex="-1" aria-labelledby="createCertificateModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="createCertificateModalLabel">Create Certificate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="certificateForm">
                        <div class="mb-3">
                            <label for="documentTypeSelect" class="form-label">Select Document Type:</label>
                            <select class="form-control" id="documentTypeSelect">
                                <option value="">-- Select Document Type --</option>
                                <option value="Certificate">Certificate</option>
                                <option value="QHSE Form">QHSE Form</option>
                                <option value="Survey Division Form">Survey Division Form</option>
                                <option value="Reports">Reports</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="templateSelect" class="form-label">Select Certificate Template:</label>
                            <select class="form-control" id="templateSelect" disabled>
                                <option value="">-- Select Certificate Template --</option>
                                <option value="Towage">Towage Certificate</option>
                                    <option value="SeaFastening">Sea Fastening Certificate</option>

                                <option value="Loadout">Loadout Certificate</option>
                            </select>
                        </div>
                        <div class="text-end">
                            <button type="button" id="generateCertificateBtn" class="btn btn-success" disabled>Proceed</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
            
    <!-- Script Section -->
    @section Scripts {
        <script>

                         function logoutUser() {
                        if (confirm("Are you sure you want to log out?")) {
                            window.location.href = '@Url.Action("Logout", "Home")';
                        }
                    }

                  
                            $("#documentTypeSelect").change(function () {
                    const selectedDoc = $(this).val();
                    const isCert = selectedDoc === "Certificate";

                    $("#templateSelect").prop("disabled", !isCert);
                    $("#generateCertificateBtn").prop("disabled", !isCert);
                });

        $("#generateCertificateBtn").click(function (e) {
        e.preventDefault();

        const documentType = $("#documentTypeSelect").val();
        const selectedTemplate = $("#templateSelect").val();

        if (!documentType || !selectedTemplate) {
        alert("Please select both document type and certificate template.");
        return;
        }

        // Handle based on selected template
        switch (selectedTemplate) {
        case "SeaFastening":
        window.location.href = "/SeaFastening/Create";
        break;

        case "Towage":
        window.location.href = "/Towage/Create";
        break;

        case "Loadout":
        window.location.href = "/Loadout/Create";
        break;

        default:
        alert("Selected template is not supported yet.");
        }
        });


   
            </script>
    }
</body>
</html>
