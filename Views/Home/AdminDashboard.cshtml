@model AdminDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Dashboard";

    var counts = Model.CertificateCounts;
    var surveys = Model.SurveySummary;
    var pendingCount = Model.PendingUsers.Count;
    var displayName = Context.Session.GetString("UserFullName")
        ?? Context.Session.GetString("UserEmail")
        ?? "User";
    string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "?" : value.Trim()[..1].ToUpperInvariant();
    var userRole = Context.Session.GetString("UserRole") ?? "";
    var isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var projectName = Context.Session.GetString("ProjectName") ?? "";
    var isClient = string.Equals(userRole, "Client", StringComparison.OrdinalIgnoreCase);
    var isIhmProject = string.Equals(projectName, "IHM", StringComparison.OrdinalIgnoreCase);
    var isExProject = string.Equals(projectName, "EX Survey", StringComparison.OrdinalIgnoreCase);
    var isAurasProject = string.Equals(projectName, "AURAS", StringComparison.OrdinalIgnoreCase);
    bool HasProjectAccess(string name) =>
        isAdmin ||
        Model.ManageableProjects.Any(project => string.Equals(project.Name, name, StringComparison.OrdinalIgnoreCase)) ||
        string.Equals(projectName, name, StringComparison.OrdinalIgnoreCase);

    var canSeeIhm = HasProjectAccess("IHM");
    var canSeeEx = HasProjectAccess("EX Survey");
    var canSeeAuras = HasProjectAccess("AURAS");
    var canSeeUsers = !isClient;
    var canApproveUsers = isAdmin || Model.ManageableProjects.Any();
    var profileTitle = isAdmin ? "Administrator" : "Manager";
    var canSeeClientRemarks = isAdmin || (!isClient && canSeeIhm);
    var ihmJobs = canSeeIhm ? surveys.IhmSurveyJobs : 0;
    var ihmReportCount = Model.SavedReports.Count(x =>
    string.Equals(x.ReportType, "ihm", StringComparison.OrdinalIgnoreCase));
    var exReportCount = Model.SavedReports.Count(x =>
    string.Equals(x.ReportType, "exsurvey", StringComparison.OrdinalIgnoreCase));

    var liveIhmJobs = surveys.IhmLiveJobs > 0 || surveys.IhmCompletedJobs > 0
        ? surveys.IhmLiveJobs
        : surveys.LiveIhmJobs;
    var exJobs = canSeeEx ? surveys.ExSurveyJobs : 0;
    var liveExJobs = canSeeEx ? surveys.ExSurveyLiveJobs : 0;
    var attentionJobs = surveys.AttentionJobs;
    var recentActivity = new List<(string Title, string Meta, string Tone)>();

    foreach (var pending in Model.PendingUsers.Take(2))
    {
        recentActivity.Add((
            $"{pending.FullName} requested {pending.RequestedRole} approval",
            pending.Email,
            "warning"
        ));
    }

    foreach (var report in Model.SavedReports
        .OrderByDescending(x => x.SavedAt ?? (x.SavedDate.HasValue ? x.SavedDate.Value.ToDateTime(TimeOnly.MinValue) : DateTime.MinValue))
        .Take(3))
    {
        var typeLabel = report.ReportType == "ihm" ? "IHM" :
            report.ReportType == "seafastening" ? "Sea Fastening" :
            System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(report.ReportType ?? "report");
        var vesselName = string.IsNullOrWhiteSpace(report.VesselName) ? "Vessel" : report.VesselName;
        var savedAt = report.SavedAt?.ToString("MMM d, yyyy")
     ?? report.SavedDate?.ToString("MMM d, yyyy")
     ?? "Recently";
        recentActivity.Add(($"{typeLabel} report saved for {vesselName}", savedAt, "success"));
    }

    if (!recentActivity.Any() && Model.FleetSummary.Any())
    {
        foreach (var vessel in Model.FleetSummary.Take(3))
        {
            recentActivity.Add((
                $"{(string.IsNullOrWhiteSpace(vessel.Name) ? "Unnamed vessel" : vessel.Name)} added to Vessel Master",
                string.IsNullOrWhiteSpace(vessel.Location) ? "Vessel master" : vessel.Location,
                "success"
            ));
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="brand">
                <span class="brand-mark"><i class="fa-solid fa-shield-halved"></i></span>
                <span><strong>AURAS</strong><small>Administration</small></span>
                <button class="sidebar-close" id="sidebarClose" type="button" aria-label="Close menu"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <nav class="side-nav" aria-label="Admin navigation">
                <a class="active" href="#overview"><i class="fa-solid fa-table-columns"></i><span>Overview</span></a>
                @if (canApproveUsers)
                {
                    <a href="@Url.Action("PendingUsers", "Auth")"><i class="fa-solid fa-user-check"></i><span>Approvals</span><b>@pendingCount</b></a>
                }
                @if (canSeeUsers)
                {
                    <a href="@Url.Action("Index", "UserManager")"><i class="fa-solid fa-users"></i><span>Users</span></a>
                }
                @if (isAdmin)
                {
                    <a href="@Url.Action("UsageAnalytics", "Home")"><i class="fa-solid fa-chart-line"></i> Usage Analytics</a>
                }
                <a href="@Url.Action("SavedReports", "Home")"><i class="fa-solid fa-file-lines"></i><span>Reports</span></a>
                @if (canSeeClientRemarks)
                {
                    <a href="@Url.Action("ClientReportRemarks", "Home")">
                        <i class="fa-regular fa-comments"></i>
                        <span>Client Remarks</span>
                        <b id="clientRemarkUnreadBadge" hidden></b>
                    </a>
                }
                <a href="@Url.Action("Index", "Vessel")"><i class="fa-solid fa-ship"></i><span>Vessels</span></a>
                <a href="@Url.Action("Index", "Auth")"><i class="fa-solid fa-user-circle"></i><span>Profile</span></a>

            </nav>


            <div class="side-actions">
                <div class="sidebar-profile">
                    <span class="avatar">@Initial(displayName)</span>
                    <span><strong>@displayName</strong><small>@profileTitle</small></span>
                </div>
                <a class="logout" href="@Url.Action("Logout", "Home")"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out</a>
            </div>
        </aside>


        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <main class="admin-main">
            <header class="topbar">
                <button class="menu-toggle" id="menuToggle" type="button" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
                <div class="topbar-spacer"></div>

            </header>

            <div class="dashboard-content">
                @if (TempData["Success"] != null)
                {
                    <div class="status-banner success"><i class="fa-solid fa-circle-check"></i>@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="status-banner error"><i class="fa-solid fa-triangle-exclamation"></i>@TempData["Error"]</div>
                }

                <section class="metric-grid" id="overview" aria-label="Operational summary">
                    @if (canSeeIhm)
                    {
                        <article class="metric-card blue">
                            <span class="metric-icon"><i class="fa-solid fa-clipboard-check"></i></span>
                            <div><small>IHM Survey jobs</small><strong>@ihmJobs</strong><span>IHM survey jobs</span></div>
                        </article>
                    }

                    @if (canSeeAuras)
                    {
                        <article class="metric-card green">
                            <span class="metric-icon"><i class="fa-solid fa-certificate"></i></span>
                            <div><small>AURAS Certificates</small><strong>@counts.TotalCertificates</strong><span>@counts.TowageCount towage</span></div>
                        </article>
                    }

                    @if (canSeeUsers)
                    {
                        <article class="metric-card violet">
                            <span class="metric-icon"><i class="fa-solid fa-users"></i></span>
                            <div><small>Active users</small><strong>@Model.TotalUsers</strong><span>@projectName roles</span></div>
                        </article>
                    }

                    @if (!isClient)
                    {
                        <article class="metric-card amber">
                            <span class="metric-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
                            <div><small>Attention</small><strong>@attentionJobs</strong><span>Assigned, not started</span></div>
                        </article>
                    }

                    <article class="metric-card teal">
                        <span class="metric-icon"><i class="fa-solid fa-ship"></i></span>
                        <div>
                            <small>Vessels</small>
                            <strong>@Model.TotalVessels</strong>
                            <span>Created vessels</span>
                        </div>
                    </article>

                    @if (isAdmin)
{
    <article class="metric-card blue">
        <span class="metric-icon"><i class="fa-solid fa-clipboard-list"></i></span>
        <div>
            <small>EX-SURVEY JOBS</small>
            <strong>@surveys.ExSurveyJobs</strong>
            <span>EX-Survey jobs</span>
        </div>
    </article>

    <article class="metric-card violet">
        <span class="metric-icon"><i class="fa-solid fa-users"></i></span>
        <div>
            <small>IHM USERS</small>
            <strong>@surveys.IhmUsersCount</strong>
            <span>IHM roles</span>
        </div>
    </article>

    <article class="metric-card green">
        <span class="metric-icon"><i class="fa-solid fa-user-check"></i></span>
        <div>
            <small>EX-SURVEY USERS</small>
            <strong>@surveys.ExSurveyUsersCount</strong>
            <span>EX-Survey roles</span>
        </div>
    </article>
}
                </section>

                <section class="applications-section" aria-label="Dashboard applications">
                    <div class="app-grid">
                        @if (canSeeAuras)
                        {
                            <article class="app-card primary">
                                <div class="app-card-top">
                                    <span class="app-icon green"><i class="fa-solid fa-shield-halved"></i></span>
                                    <b class="status-pill active">Active</b>
                                </div>
                                <h2>Auras SurveyApp</h2>
                                <p>Certifcicates Creation For Towage,Seafastening,and Loadout</p>
                                <div class="app-meta">
                                    <span><strong>@counts.TotalCertificates</strong> certificates</span>
                                    <span><strong>@Model.TotalUsers</strong> users</span>
                                </div>
                                <button type="button" class="app-action dark" data-bs-toggle="modal" data-bs-target="#createCertificateModal">
                                    Open workspace <i class="fa-solid fa-arrow-right"></i>
                                </button>
                            </article>
                        }
                        @if (canSeeIhm)
                        {
                            <article class="app-card">
                                <div class="app-card-top">
                                    <span class="app-icon blue"><i class="fa-solid fa-briefcase"></i></span>
                                    <b class="status-pill beta">Beta</b>
                                </div>
                                <h2>IHM All Jobs</h2>
                                <p>View all IHM survey jobs and job details.</p>
                                <div class="app-meta">
                                    <span><strong>@ihmJobs</strong> job@(ihmJobs == 1 ? "" : "s")</span>
                                </div>
                                <a class="app-action light" href="@Url.Action("Ihm", "SurveyJobs")">
                                    Open jobs <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </article>

                            <article class="app-card">
                                <div class="app-card-top">
                                    <span class="app-icon green"><i class="fa-solid fa-file-lines"></i></span>
                                    <b class="status-pill active">Reports</b>
                                </div>
                                <h2>IHM Reports</h2>
                                <p>View saved IHM survey reports.</p>
                                <div class="app-meta">
                                    <span><strong>@ihmReportCount</strong> report@(ihmReportCount == 1 ? "" : "s")</span>
                                </div>
                                <a class="app-action light" href="@Url.Action("SavedReports", "Home")">
                                    Open reports <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </article>

                            @if (!isAdmin)
                            {
                                <article class="app-card">
                                    <div class="app-card-top">
                                        <span class="app-icon coral"><i class="fa-solid fa-spinner"></i></span>
                                        <b class="status-pill soon">Live</b>
                                    </div>
                                    <h2>IHM Live Jobs</h2>
                                    <p>Ongoing IHM jobs currently in progress.</p>
                                    <div class="app-meta">
                                        <span><strong>@liveIhmJobs</strong> ongoing job@(liveIhmJobs == 1 ? "" : "s")</span>
                                    </div>
                                    <a class="app-action light" href="@Url.Action("Ihm", "SurveyJobs", new { ihmCompletionFilter = "live" })">
                                        Open live jobs <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                </article>
                            }
                        }

                        @if (isAdmin && (canSeeIhm || canSeeEx))
                        {
                            <article class="app-card live-jobs-card">
                                <div class="app-card-top">
                                    <span class="app-icon coral"><i class="fa-solid fa-spinner"></i></span>
                                    <b class="status-pill soon">Live</b>
                                </div>
                                <h2>Live Jobs</h2>
                                <p>Ongoing jobs currently in progress across active survey projects.</p>
                                <div class="live-summary-grid">
                                    @if (canSeeIhm)
                                    {
                                        <span class="live-summary-item">
                                            <strong>@liveIhmJobs</strong>
                                            <small>IHM live jobs</small>
                                        </span>
                                    }
                                    @if (canSeeEx)
                                    {
                                        <span class="live-summary-item">
                                            <strong>@liveExJobs</strong>
                                            <small>EX-Survey live jobs</small>
                                        </span>
                                    }
                                </div>
                                <div class="live-action-row">
                                    @if (canSeeIhm)
                                    {
                                        <a class="app-action light" href="@Url.Action("Ihm", "SurveyJobs", new { ihmCompletionFilter = "live" })">
                                            Open IHM <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    }
                                    @if (canSeeEx)
                                    {
                                        <a class="app-action light" href="@Url.Action("Ex", "SurveyJobs", new { jobCompletionFilter = "live" })">
                                            Open EX <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    }
                                </div>
                            </article>
                        }
                        @if (canSeeEx)
                        {
                            <article class="app-card">
                                <div class="app-card-top">
                                    <span class="app-icon blue"><i class="fa-solid fa-clipboard-list"></i></span>
                                    <b class="status-pill beta">EX-Survey</b>
                                </div>
                                <h2>EX-Survey All Jobs</h2>
                                <p>View all accessible EX-Survey jobs and job details.</p>
                                <div class="app-meta">
                                    <span><strong>@exJobs</strong> job@(exJobs == 1 ? "" : "s")</span>
                                </div>
                                <a class="app-action light" href="@Url.Action("Ex", "SurveyJobs")">
                                    Open jobs <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </article>

                            <article class="app-card">
                                <div class="app-card-top">
                                    <span class="app-icon green"><i class="fa-solid fa-file-lines"></i></span>
                                    <b class="status-pill active">Reports</b>
                                </div>
                                <h2>EX-Survey Reports</h2>
                                <p>View saved EX-Survey report documents.</p>
                                <div class="app-meta">
                                    <span><strong>@exReportCount</strong> report@(exReportCount == 1 ? "" : "s")</span>
                                </div>
                                <a class="app-action light" href="@Url.Action("SavedReports", "Home", new { category = "exsurvey" })">
                                    Open reports <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </article>

                            @if (!isAdmin)
                            {
                                <article class="app-card">
                                    <div class="app-card-top">
                                        <span class="app-icon coral"><i class="fa-solid fa-spinner"></i></span>
                                        <b class="status-pill soon">Live</b>
                                    </div>
                                    <h2>EX-Survey Live Jobs</h2>
                                    <p>Ongoing EX-Survey jobs currently in progress.</p>
                                    <div class="app-meta">
                                        <span><strong>@liveExJobs</strong> ongoing job@(liveExJobs == 1 ? "" : "s")</span>
                                    </div>
                                    <a class="app-action light" href="@Url.Action("Ex", "SurveyJobs", new { jobCompletionFilter = "live" })">
                                        Open live jobs <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                </article>
                            }
                        }
                    </div>
                </section>

                <section class="lower-grid">
                    <article class="panel fleet-panel">
                            <div class="panel-heading">
                                <div><h2>Vessel Master</h2></div>
                                <a class="panel-link" href="@Url.Action("Index", "Vessel")">
                                    All vessels <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.FleetErrorMessage))
                            {
                                <div class="saved-side-empty fleet-empty-state">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    <span>@Model.FleetErrorMessage</span>
                                </div>
                            }
                            else if (Model.FleetSummary == null || !Model.FleetSummary.Any())
                            {
                                <div class="saved-side-empty fleet-empty-state">
                                    <i class="fa-solid fa-ship"></i>
                                    <span>No vessels available</span>
                                </div>
                            }
                            else
                            {
                                <div class="fleet-grid">
                                    @foreach (var vessel in Model.FleetSummary)
                                    {
                                        var statusText = string.IsNullOrWhiteSpace(vessel.Status)
                                        ? "Available"
                                        : vessel.Status;

                                        var statusClass = statusText.ToLowerInvariant() switch
                                        {
                                            "on survey" => "on-survey",
                                            "certified" => "certified",
                                            "towage" => "towage",
                                            "issued" => "issued",
                                            _ => "on-survey"
                                        };

                                        <div class="fleet-item">
                                            <span class="fleet-icon">
                                                <i class="fa-solid fa-ship"></i>
                                            </span>

                                            <div class="fleet-copy">
                                                <strong>@(string.IsNullOrWhiteSpace(vessel.Name) ? "Unnamed vessel" : vessel.Name)</strong>
                                                <small>
                                                    <i class="fa-solid fa-location-dot"></i>
                                                    @(string.IsNullOrWhiteSpace(vessel.Location) ? "Location unknown" : vessel.Location)
                                                </small>
                                            </div>

                                            <span class="fleet-status @statusClass">@statusText</span>
                                        </div>
                                    }
                                </div>
                            }
                    </article>
                    <article class="panel activity-panel">
                        <div class="panel-heading">
                            <div><h2>Recent activity</h2></div>
                            <a class="panel-link" href="@Url.Action("SavedReports", "Home")">View all</a>
                        </div>

                        @if (!recentActivity.Any())
                        {
                            <div class="saved-side-empty fleet-empty-state">
                                <i class="fa-regular fa-clock"></i>
                                <span>No recent activity available</span>
                            </div>
                        }
                        else
                        {
                            <div class="activity-list">
                                @foreach (var item in recentActivity.Take(5))
                                {
                                    <div class="activity-item">
                                        <span class="activity-dot @item.Tone"></span>
                                        <div>
                                            <strong>@item.Title</strong>
                                            <small>@item.Meta</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                </section>

            
            </div>
        </main>
    </div>

    <div class="modal fade" id="createCertificateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content certificate-modal">
                <div class="modal-header"><div><span class="eyebrow">New document</span><h2>Create certificate</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <p>Choose a certificate workflow to begin.</p>
                    <div class="certificate-options">
                        <a href="/Towage/Create"><span><i class="fa-solid fa-ship"></i></span><strong>Towage</strong><small>Towage approval certificate</small></a>
                        <a href="/SeaFastening/Create"><span><i class="fa-solid fa-anchor"></i></span><strong>Sea Fastening</strong><small>Sea fastening certificate</small></a>
                        <a href="/Loadout/Create"><span><i class="fa-solid fa-truck-ramp-box"></i></span><strong>Loadout</strong><small>Loadout operation certificate</small></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function loadClientRemarkUnreadCount() {
            const badge = document.getElementById("clientRemarkUnreadBadge");
            if (!badge) return;

            try {
                const response = await fetch("@Url.Action("ClientReportRemarkUnreadCount", "Home")", {
                    headers: { "Accept": "application/json" }
                });

                if (!response.ok) return;

                const payload = await response.json();
                const count = Number(payload.count || payload.Count || 0);

                badge.hidden = count <= 0;
                badge.textContent = count > 9 ? "9+" : count.toString();
            } catch {
                badge.hidden = true;
            }
        }

        loadClientRemarkUnreadCount();
        setInterval(loadClientRemarkUnreadCount, 30000);
    </script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
</body>
</html>
