@model List<SavedReportViewModel>
@{
    Layout = null;

    string NormalizeType(string? type) => (type ?? string.Empty).Trim().ToLowerInvariant();
    string TypeLabel(string? type) => NormalizeType(type) switch
    {
        "ihm" => "IHM Report",
        "seafastening" => "Sea Fastening Report",
        "loadout" => "Loadout Report",
        "towage" => "Towage Report",
        _ => "Report"
    };
    string DateLabel(SavedReportViewModel report) =>
        report.SavedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
        ?? report.SavedDate?.ToString("dd MMM yyyy")
        ?? "Date unavailable";

    var aurasReports = Model
        .Where(x => NormalizeType(x.ReportType) is "towage" or "seafastening" or "loadout")
        .ToList();
    var ihmReports = Model
        .Where(x => NormalizeType(x.ReportType) == "ihm")
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reports</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/saved-reports.css" asp-append-version="true" />
</head>
<body>
    <header class="reports-topbar">
        <a class="back-link" href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-arrow-left"></i><span>Dashboard</span></a>
    
    </header>

    <main class="reports-page">
        <section class="reports-hero">
            <div><span class="eyebrow">Document centre</span><h1>Reports</h1><p>Browse saved Auras certificate reports and IHM survey/job reports with secure role-based access.</p></div>
            <div class="hero-stat"><i class="fa-solid fa-file-shield"></i><span><strong>@Model.Count</strong> documents available</span></div>
        </section>

        @if (ViewBag.LoadError != null)
        {
            <div class="load-error"><i class="fa-solid fa-triangle-exclamation"></i>@ViewBag.LoadError</div>
        }

        <section class="report-categories" aria-label="Report categories">
            <button class="category-card active" type="button" data-category="auras">
                <span><i class="fa-solid fa-certificate"></i></span>
                <strong>Auras Reports</strong>
                <small>Towage, Sea Fastening and Loadout</small>
                <b>@aurasReports.Count</b>
            </button>
            <button class="category-card" type="button" data-category="ihm">
                <span><i class="fa-solid fa-flask-vial"></i></span>
                <strong>IHM Reports</strong>
                <small>IHM survey and job reports only</small>
                <b>@ihmReports.Count</b>
            </button>
        </section>

        <section class="report-toolbar">
            <label class="report-search"><i class="fa-solid fa-magnifying-glass"></i><input id="reportSearch" type="search" placeholder="Search vessel, job, report type, created by or date..." autocomplete="off" /></label>
            <div class="type-filters">
                <button class="active" type="button" data-type="">All</button>
                <button type="button" data-type="towage">Towage</button>
                <button type="button" data-type="seafastening">Sea Fastening</button>
                <button type="button" data-type="loadout">Loadout</button>
                <button type="button" data-type="ihm">IHM</button>
            </div>
        </section>

        <section class="reports-section active" data-panel="auras">
            <div class="section-heading">
                <div><span class="eyebrow">Auras Reports</span><h2>Towage, Sea Fastening and Loadout Reports</h2></div>
            </div>
            <div class="report-table-wrap">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Vessel / Job</th>
                            <th>Report Type</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in aurasReports)
                        {
                            var type = NormalizeType(report.ReportType);
                            var typeLabel = TypeLabel(report.ReportType);
                            var vessel = string.IsNullOrWhiteSpace(report.VesselName) ? "Vessel not specified" : report.VesselName;
                            var title = string.IsNullOrWhiteSpace(report.Title) ? $"{typeLabel} Report" : report.Title;
                            var reference = string.IsNullOrWhiteSpace(report.Reference) ? "No job/reference" : report.Reference;
                            var status = string.IsNullOrWhiteSpace(report.Status) ? "Saved" : report.Status;
                            var createdBy = string.IsNullOrWhiteSpace(report.CreatedBy) ? "Not confirmed" : report.CreatedBy;
                            var date = DateLabel(report);
                            var searchText = $"{vessel} {title} {reference} {typeLabel} {createdBy} {status} {date}".ToLowerInvariant();
                            var editUrl = Url.Action("EditSavedPdf", "Home", new { type = report.ReportType, id = report.Id, title });
                            <tr class="report-row" data-type="@type" data-search="@searchText">
                                <td><span class="status-pill">@status</span></td>
                                <td><strong>@vessel</strong><small>@title</small><em>@reference</em></td>
                                <td><span class="type-badge">@typeLabel</span></td>
                                <td>@createdBy</td>
                                <td>@date</td>
                                <td>
                                    <div class="report-actions">
                                        <a class="edit-report" href="@editUrl"><i class="fa-regular fa-pen-to-square"></i>Edit</a>
                                        <a class="view-report" target="_blank" rel="noopener" href="@Url.Action("SavedReportFile", "Home", new { type = report.ReportType, id = report.Id })"><i class="fa-regular fa-eye"></i>View</a>
                                        <a class="download-report" href="@Url.Action("SavedReportFile", "Home", new { type = report.ReportType, id = report.Id, download = true })"><i class="fa-solid fa-download"></i>Download</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="reports-section" data-panel="ihm">
            <div class="section-heading">
                <div><span class="eyebrow">IHM Reports</span><h2>IHM Survey/Job Reports</h2></div>
            </div>
            <div class="report-table-wrap">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Vessel / Job</th>
                            <th>Report Type</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
            @foreach (var report in Model)
            {
                if (NormalizeType(report.ReportType) != "ihm")
                {
                    continue;
                }

                var type = NormalizeType(report.ReportType);
                var typeLabel = TypeLabel(report.ReportType);
                var vessel = string.IsNullOrWhiteSpace(report.VesselName) ? "Vessel not specified" : report.VesselName;
                var title = string.IsNullOrWhiteSpace(report.Title) ? $"{typeLabel} Report" : report.Title;
                var reference = string.IsNullOrWhiteSpace(report.Reference) ? "No job/reference" : report.Reference;
                var status = string.IsNullOrWhiteSpace(report.Status) ? "Saved" : report.Status;
                var createdBy = string.IsNullOrWhiteSpace(report.CreatedBy) ? "Not confirmed" : report.CreatedBy;
                var date = DateLabel(report);
                var searchText = $"{vessel} {title} {reference} {typeLabel} {createdBy} {status} {date}".ToLowerInvariant();
                var editUrl = Url.Action("EditSavedPdf", "Home",
                    new { type = report.ReportType, id = report.Id, title });
                <tr class="report-row" data-type="@type" data-search="@searchText">
                    <td><span class="status-pill">@status</span></td>
                    <td><strong>@vessel</strong><small>@title</small><em>@reference</em></td>
                    <td><span class="type-badge">@typeLabel</span></td>
                    <td>@createdBy</td>
                    <td>@date</td>
                    <td>
                        <div class="report-actions">
                            <a class="edit-report" href="@editUrl"><i class="fa-regular fa-pen-to-square"></i>Edit</a>
                            <a class="view-report" target="_blank" rel="noopener" href="@Url.Action("SavedReportFile", "Home", new { type = report.ReportType, id = report.Id })"><i class="fa-regular fa-eye"></i>View</a>
                            <a class="download-report" href="@Url.Action("SavedReportFile", "Home", new { type = report.ReportType, id = report.Id, download = true })"><i class="fa-solid fa-download"></i>Download</a>
                        </div>
                    </td>
                </tr>
            }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="reports-empty @(Model.Any() ? "" : "show")" id="reportsEmpty">
            <span><i class="fa-regular fa-folder-open"></i></span><h2>No reports found</h2><p>Saved reports will appear here after a report is generated.</p>
        </div>
    </main>
    <script src="~/js/saved-reports.js" asp-append-version="true"></script>
</body>
</html>
