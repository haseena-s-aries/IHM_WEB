@model Survey_Certification_App.Models.TotalCertificateCountDto

@{
    ViewData["Title"] = "Survey Dashboard";
}

<style>
    html,
    body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100%;
        overflow-x: hidden;
    }

        body > .container,
        body > .container-fluid,
        main,
        .pb-3 {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

    .top-bar {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        border-radius: 0;
    }

    body {
        margin: 0;
        background: #eef4fb;
        color: #102033;
        font-family: 'Segoe UI', sans-serif;
        overflow-x: hidden;
    }

    .top-bar {
        width: 100%;
        min-height: 56px;
        background: linear-gradient(90deg, #6b4fd3, #384a9f);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        font-weight: 800;
        box-shadow: 0 4px 16px rgba(0,0,0,.12);
        box-sizing: border-box;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .top-bar-title {
        font-size: 16px;
        white-space: nowrap;
    }

    .top-bar-actions {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

        .top-bar-actions a {
            color: #fff;
            text-decoration: none;
        }

    .dashboard-wrap {
        width: 100%;
        max-width: 100%;
        padding: 22px;
        box-sizing: border-box;
    }


    .hero {
        position: relative;
        overflow: hidden;
        border-radius: 18px;
        padding: 34px 38px;
        background: linear-gradient(135deg, #14558f, #2d8bd4);
        color: #fff;
        min-height: 145px;
        box-shadow: 0 14px 28px rgba(21, 85, 143, .22);
    }

        .hero::before,
        .hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.09);
        }

        .hero::before {
            width: 140px;
            height: 140px;
            right: -35px;
            top: -45px;
        }

        .hero::after {
            width: 105px;
            height: 105px;
            right: 85px;
            bottom: -55px;
        }

    .hero-small {
        font-size: 12px;
        letter-spacing: 2px;
        font-weight: 800;
        opacity: .75;
        text-transform: uppercase;
    }

    .hero h1 {
        margin: 12px 0 8px;
        font-size: 27px;
        font-weight: 900;
    }

    .hero p {
        margin: 0 0 20px;
        color: rgba(255,255,255,.78);
        font-size: 14px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 15px;
        border-radius: 30px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.18);
        font-size: 11px;
        font-weight: 900;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        background: #43f0b3;
        border-radius: 50%;
    }

    .module-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-top: 22px;
    }

    .module-card {
        border: 0;
        min-height: 118px;
        border-radius: 16px;
        color: #fff;
        text-decoration: none;
        padding: 18px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 12px 22px rgba(0,0,0,.16);
        transition: .2s;
    }

        .module-card:hover {
            transform: translateY(-3px);
            color: #fff;
        }

    .green {
        background: linear-gradient(135deg, #159b90, #28c875);
    }

    .blue {
        background: linear-gradient(135deg, #4558d8, #2379ff);
    }

    .orange {
        background: linear-gradient(135deg, #ff3f74, #ff6538);
    }

    .module-icon {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,.18);
        margin-bottom: 12px;
    }

    .module-title {
        font-size: 15px;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .module-text {
        font-size: 12px;
        color: rgba(255,255,255,.8);
        line-height: 1.4;
    }

    .section-title {
        font-size: 16px;
        font-weight: 900;
        margin: 24px 0 12px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #d7e3f1;
        border-radius: 14px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 92px;
        box-shadow: 0 6px 18px rgba(34, 64, 100, .08);
    }

    .summary-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        font-size: 18px;
    }

    .i-green {
        background: #dff8f1;
        color: #0aa384;
    }

    .i-blue {
        background: #e4e6ff;
        color: #4455cc;
    }

    .i-red {
        background: #ffe8e0;
        color: #ff5735;
    }

    .i-cyan {
        background: #dff8ff;
        color: #00aeca;
    }

    .summary-number {
        font-size: 28px;
        font-weight: 900;
        line-height: 1;
    }

    .summary-label {
        margin-top: 8px;
        color: #28506f;
        font-size: 13px;
        font-weight: 700;
    }

    .quick-list {
        display: grid;
        gap: 12px;
    }

    .quick-item {
        min-height: 76px;
        border-radius: 14px;
        border: 1px solid #d7e3f1;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        color: #102033;
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(34, 64, 100, .08);
    }

    .quick-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .quick-title {
        font-weight: 900;
        font-size: 15px;
    }

    .quick-sub {
        font-size: 13px;
        color: #52708d;
        margin-top: 3px;
    }

    .arrow {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: #eef4fb;
        color: #52708d;
    }

    @@media(max-width: 768px) {
        .module-grid,
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .top-bar {
            min-height: 52px;
            padding: 0 14px;
        }

        .top-bar-title {
            font-size: 14px;
        }

        .top-bar-actions {
            gap: 12px;
        }

        .dashboard-wrap {
            padding: 14px;
        }

        .hero {
            padding: 26px;
        }
    }
</style>

<div class="top-bar">
    <div class="top-bar-title">Survey Dashboard</div>

    <div class="top-bar-actions">
        <i class="fa-solid fa-moon"></i>

        <a href="@Url.Action("Logout", "Home")">
            <i class="fa-solid fa-right-from-bracket"></i>
        </a>
    </div>
</div>

<div class="dashboard-wrap">

    <section class="hero">
        <div class="hero-small">Marine Operations</div>
        <h1>Welcome, @(ViewData["FullName"] ?? "Surveyor")</h1>
        <p>Everything is organized and ready for review.</p>

        <div class="status-pill">
            <span class="status-dot"></span>
            SYSTEM ONLINE
        </div>
    </section>

    <div class="module-grid">
        @* <a class="module-card green" href="#" data-bs-toggle="modal" data-bs-target="#createCertificateModal">
            <div>
                <div class="module-icon"><i class="fa-solid fa-certificate"></i></div>
                <div class="module-title">Certificates</div>
                <div class="module-text">Loadout · Towage<br />Seafastening</div>
            </div>
            <strong>Open <i class="fa-solid fa-arrow-right"></i></strong>
        </a> *@

        <a class="module-card blue" href="@Url.Action("Ihm", "SurveyJobs")">
            <div>
                <div class="module-icon"><i class="fa-solid fa-box-archive"></i></div>
                <div class="module-title">IHM Survey</div>
                <div class="module-text">Inventory of<br />Hazardous Materials</div>
            </div>
            <strong>Open <i class="fa-solid fa-arrow-right"></i></strong>
        </a>

        <a class="module-card orange" href="@Url.Action("Ex", "SurveyJobs")">
            <div>
                <div class="module-icon"><i class="fa-solid fa-route"></i></div>
                <div class="module-title">Ex-Survey</div>
                <div class="module-text">Explosion-proof<br />Equipment Survey</div>
            </div>
            <strong>Open <i class="fa-solid fa-arrow-right"></i></strong>
        </a>
    </div>

    <div class="section-title">Survey Summary</div>

    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-icon i-green"><i class="fa-solid fa-clipboard-check"></i></div>
            <div>
                <div class="summary-number">@Model.TotalSurveyJobs</div>
                <div class="summary-label">Survey Jobs</div>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon i-blue"><i class="fa-solid fa-box-archive"></i></div>
            <div>
                <div class="summary-number">@Model.IhmSurveyJobs</div>
                <div class="summary-label">IHM Survey</div>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon i-red"><i class="fa-solid fa-route"></i></div>
            <div>
                <div class="summary-number">@Model.ExSurveyJobs</div>
                <div class="summary-label">Ex-Survey</div>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon i-cyan"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <div>
                <div class="summary-number">@Model.SubmittedSurveyJobs</div>
                <div class="summary-label">Submitted</div>
            </div>
        </div>
    </div>

    <div class="section-title">Quick Actions</div>

    <div class="quick-list">
        <a class="quick-item" href="@Url.Action("Ihm", "SurveyJobs")">
            <div class="quick-left">
                <div class="summary-icon i-blue"><i class="fa-solid fa-box-archive"></i></div>
                <div>
                    <div class="quick-title">IHM Survey Jobs</div>
                    <div class="quick-sub">Open all IHM survey jobs</div>
                </div>
            </div>
            <div class="arrow"><i class="fa-solid fa-chevron-right"></i></div>
        </a>

        <a class="quick-item" href="@Url.Action("Ex", "SurveyJobs")">
            <div class="quick-left">
                <div class="summary-icon i-blue"><i class="fa-solid fa-route"></i></div>
                <div>
                    <div class="quick-title">Ex-Survey Jobs</div>
                    <div class="quick-sub">Open all Ex-Survey jobs</div>
                </div>
            </div>
            <div class="arrow"><i class="fa-solid fa-chevron-right"></i></div>
        </a>
    </div>

</div>