@using System.Text.Json
@model SurveyJobsPageViewModel
@{
    Layout = null;
    var isIhm = Model.SurveyType == "IHM Survey";
    var backUrl = Model.IsAdmin ? "/Home/AdminDashboard" : "/Home/Index";
    var userRole = Context.Session.GetString("UserRole") ?? string.Empty;
    var currentUserIdText =
    Context.Session.GetString("UserId") ??
    Context.Session.GetString("UserID") ??
    Context.Session.GetString("CurrentUserId");

    var currentUserId = int.TryParse(currentUserIdText, out var parsedUserId)
        ? parsedUserId
        : 0;

    var isManager = string.Equals(userRole, "Manager", StringComparison.OrdinalIgnoreCase);
    var isSurveyor = string.Equals(userRole, "Surveyor", StringComparison.OrdinalIgnoreCase);
    var hasIhmCompletionFilter = isIhm && !string.IsNullOrWhiteSpace(Model.IhmCompletionFilter);
    var ihmFilterQuery = hasIhmCompletionFilter
        ? $"&ihmCompletionFilter={Uri.EscapeDataString(Model.IhmCompletionFilter!)}"
        : "";
    var ihmFilterFirstQuery = hasIhmCompletionFilter
        ? $"?ihmCompletionFilter={Uri.EscapeDataString(Model.IhmCompletionFilter!)}"
        : "";
    var listRefreshUrl = isIhm ? $"/SurveyJobs/Ihm{ihmFilterFirstQuery}" : "/SurveyJobs/Ex";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.SurveyType Jobs</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body { margin:0; background:#f4f6fa; color:#1a2333; font-family:"Segoe UI",Arial,sans-serif; }
        .header { padding:24px; background:linear-gradient(135deg,#0b1d33,#132b4a,#1e3a5f); color:white; border-radius:0 0 20px 20px; box-shadow:0 4px 12px #0003; }
        .header-row { display:flex; align-items:center; gap:14px; }
        .header-icon,.back-btn,.refresh-btn { width:44px; height:44px; border-radius:10px; background:#ffffff1a; color:white; border:0; display:flex; align-items:center; justify-content:center; text-decoration:none; }
        .title { font-size:20px; font-weight:800; margin:0; }
        .sub { color:#ffffff88; font-size:12px; margin:2px 0 0; }
        .count-pill { padding:8px 14px; border-radius:20px; background:#ffffff1a; border:1px solid #ffffff25; font-size:12px; font-weight:700; }
        .new-btn { background:#1976d2; color:white; border:0; border-radius:10px; padding:10px 16px; font-weight:800; }
        .search-box { margin-top:16px; background:#ffffff1a; border:1px solid #ffffff18; border-radius:12px; display:flex; align-items:center; padding:0 14px; }
        .search-box input { flex:1; background:transparent; border:0; outline:0; color:white; padding:14px 8px; }
        .search-box input::placeholder { color:#ffffff66; }
    
        .content { padding:16px; }
        .job-card { background:white; border:1px solid #e0e4ec; border-radius:14px; padding:18px; margin-bottom:12px; box-shadow:0 3px 10px #0000000a; cursor:pointer; transition:.16s; }
        .job-card:hover { transform:translateY(-1px); box-shadow:0 8px 22px #00000012; }

        .job-head {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .job-icon { width:46px; height:46px; border-radius:12px; background:linear-gradient(135deg,#0b1d33,#1e3a5f); color:white; display:flex; align-items:center; justify-content:center; }
        .job-title { font-size:16px; font-weight:800; margin:0; }
        .client { color:#607080; font-size:12px; margin:2px 0 0; }
        .status { padding:6px 11px; border-radius:20px; font-size:11px; font-weight:800; white-space:nowrap; border:1px solid transparent; }
        .status-completed { background:#43a04718; color:#2e7d32; border-color:#43a04730; }
        .status-pending { background:#ffa7261f; color:#9a5b00; border-color:#ffa72638; }
        .status-in-progress { background:#1976d21a; color:#1976d2; border-color:#1976d230; }
        .status-not-started { background:#90a0b01f; color:#607080; border-color:#90a0b040; }

        .marked-image-status {
            position: absolute;
            left: 50%;
            top: 4px;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 7px;
            max-width: 55%;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            background: #eef4ff;
            color: #315a9b;
            border: 1px solid #d9e6ff;
            white-space: nowrap;
        }

            .marked-image-status.ready {
                background: #edf8f1;
                color: #247044;
                border-color: #cbead6;
            }

            .marked-image-status.processing {
                background: #fff8e8;
                color: #9a6500;
                border-color: #ffe4a8;
            }

            .marked-image-status.failed {
                background: #fff0f0;
                color: #b42318;
                border-color: #ffd0d0;
            }
        .line { border-top:1px solid #e0e4ec; margin:14px 0 12px; }
        .info-row { display:flex; gap:8px; align-items:center; color:#607080; font-size:13px; margin-bottom:6px; }
        .info-row strong { width:58px; color:#607080; }
        .info-row span { color:#1a2333; font-weight:600; }

        .job-meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 8px;
            margin: 12px 0;
        }

        .meta-tile {
            min-height: 58px;
            padding: 9px 10px;
            border-radius: 10px;
            background: #f7faff;
            border: 1px solid #e0e8f3;
        }

            .meta-tile .meta-label {
                display: flex;
                align-items: center;
                gap: 6px;
                color: #607080;
                font-size: 11px;
                font-weight: 800;
                text-transform: uppercase;
            }

            .meta-tile .meta-value {
                margin-top: 4px;
                color: #1a2333;
                font-size: 13px;
                font-weight: 800;
                overflow-wrap: anywhere;
            }

        .meta-date-form {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 6px;
        }

            .meta-date-form input {
                flex: 1;
                min-width: 0;
                border: 1px solid #c8dcf3;
                border-radius: 8px;
                padding: 7px 9px;
                font-size: 12px;
                font-weight: 700;
                color: #1a2333;
                background: #fff;
            }

            .meta-date-form button {
                border: 0;
                border-radius: 8px;
                background: #1976d2;
                color: #fff;
                padding: 7px 10px;
                font-size: 12px;
                font-weight: 900;
                white-space: nowrap;
            }

        .page-busy {
            cursor: wait;
        }

            .page-busy::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: 9998;
                background: rgba(255, 255, 255, 0.45);
                cursor: wait;
            }

        .pending-layout-row {
            max-width: 100%;
        }

        .pending-file-name {
            max-width: 100%;
            overflow-wrap: anywhere;
            word-break: break-word;
            line-height: 1.25;
        }

        .pending-layout-row .btn {
            flex: 0 0 auto;
        }

        .page-loading-indicator {
            position: fixed;
            top: 18px;
            right: 18px;
            z-index: 9999;
            display: none;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 999px;
            background: #0d6efd;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 8px 24px rgba(13, 110, 253, .25);
        }

        .page-busy .page-loading-indicator {
            display: none;
        }

        .loading-dot {
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,.45);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .75s linear infinite;
        }

        @@keyframes spin {
            to{
            transform: rotate(360deg);
        }

        }

            .page-busy a,
            .page-busy button,
            .page-busy label {
                pointer-events: none;
                opacity: .75;
            }

        .survey-date-box { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:12px 0; padding:9px 10px; border-radius:8px; background:#1976d20f; color:#1976d2; font-size:12px; font-weight:800; }
        .survey-date-box input { border:1px solid #b8d8f7; border-radius:7px; padding:5px 7px; color:#1a2333; background:#fff; }
        .survey-date-box button { border:0; border-radius:7px; background:#1976d2; color:#fff; padding:6px 10px; font-size:12px; font-weight:800; }
        .assigned { margin:12px 0; padding:9px 10px; border-radius:8px; background:#43a04714; color:#43a047; font-size:12px; font-weight:700; }
        .actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
        .action-btn { border:0; border-radius:8px; padding:8px 12px; font-size:12px; font-weight:800; text-decoration:none; display:inline-flex; align-items:center; gap:5px; }
        .blue { background:#1976d214; color:#1976d2; }
        .teal { background:#00897b14; color:#00897b; }
        .green { background:#43a04714; color:#43a047; }
        .purple { background:#512da814; color:#512da8; }
        .amber { background:#ffa72618; color:#d98200; }
        .red { background:#ef535014; color:#d93636; }
        .empty { text-align:center; padding:70px 20px; color:#607080; }
        .modal-content { border-radius:16px; border:0; }
        .modal-header { background:linear-gradient(135deg,#0b1d33,#132b4a,#1e3a5f); color:white; border-radius:16px 16px 0 0; }
        .form-control,.form-select { border-radius:8px; padding:12px; }
    </style>
</head>

<body>
    <div class="page-loading-indicator">
        <span class="loading-dot"></span>
        <span>Please wait...</span>
    </div>
    <header class="header">
        <div class="header-row">
            <a class="back-btn" href="@backUrl"><i class="fa-solid fa-chevron-left"></i></a>
            <div class="header-icon"><i class="fa-solid @(isIhm ? "fa-clipboard-list" : "fa-helmet-safety")"></i></div>

            <div class="flex-grow-1">
                <h1 class="title">@Model.SurveyType Jobs</h1>
                <p class="sub">Survey Job Management</p>
            </div>

            <span class="count-pill"><i class="fa-regular fa-briefcase"></i> @Model.Jobs.Count Jobs</span>
            <a class="refresh-btn" href="@listRefreshUrl"><i class="fa-solid fa-rotate-right"></i></a>

            @if (Model.IsAdmin)
            {
                <button type="button" class="new-btn" data-bs-toggle="modal" data-bs-target="#createJobModal">
                    <i class="fa-solid fa-plus"></i> New Job
                </button>
            }
        </div>

        <div class="search-box">
            <i class="fa-solid fa-search"></i>
            <input id="jobSearch" placeholder="Search by job number, client, vessel, status..." />
        </div>
    </header>

    <main class="content">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="empty">
                <i class="fa-solid fa-triangle-exclamation fa-3x text-danger"></i>
                <p class="mt-3">@Model.ErrorMessage</p>
            </div>
        }
        else if (!Model.Jobs.Any())
        {
            <div class="empty">
                <i class="fa-regular fa-clipboard fa-3x"></i>
                <p class="mt-3">No @Model.SurveyType jobs found.</p>
            </div>
        }
        else
        {
            foreach (var job in Model.Jobs)
            {
                var jobOpenUrl = Model.IsAdmin
                    ? $"/SurveyJobs/ProjectInfo?jobId={job.Id}{ihmFilterQuery}"
                    : $"/SurveyJobs/Work?jobId={job.Id}&surveyType={Uri.EscapeDataString(Model.SurveyType)}{ihmFilterQuery}";
                var jobModuleType = (job.ModuleType ?? "").Trim();
                var jobSurveyType =
                jobModuleType.Equals("IhmSurvey", StringComparison.OrdinalIgnoreCase) ||
                jobModuleType.Equals("IHM Survey", StringComparison.OrdinalIgnoreCase) ||
                jobModuleType.Equals("2", StringComparison.OrdinalIgnoreCase)
                ? "IHM Survey"
                : "EX Survey";

                var jobSurveyFilterQuery =
                jobSurveyType == "IHM Survey" && hasIhmCompletionFilter
                ? ihmFilterQuery
                : "";

                var jobSurveyUrl = $"/SurveyJobs/Work?jobId={job.Id}&surveyType={Uri.EscapeDataString(jobSurveyType)}{jobSurveyFilterQuery}";
                var surveyDateText = job.SurveyDate.HasValue
                    ? job.SurveyDate.Value.ToLocalTime().ToString("dd-MM-yyyy")
                    : "Not selected";
                var surveyDateValue = job.SurveyDate.HasValue
                    ? job.SurveyDate.Value.ToString("yyyy-MM-dd")
                    : "";
                var displayStatus = string.IsNullOrWhiteSpace(job.DisplayStatus)
                    ? "Not Started"
                    : job.DisplayStatus;
                var statusCss = displayStatus switch
                {
                    "Completed" => "completed",
                    "Pending" => "pending",
                    "In Progress" => "in-progress",
                    _ => "not-started"
                };
                var statusIcon = displayStatus switch
                {
                    "Completed" => "fa-circle-check",
                    "Pending" => "fa-clock",
                    "In Progress" => "fa-spinner",
                    _ => "fa-circle"
                };

                <article class="job-card" data-card-href="@jobOpenUrl" data-search="@($"{job.JobNumber} {job.ClientName} {job.VesselName} {job.SiteName} {job.Status} {displayStatus}".ToLower())">
                    <div class="job-head">
                        <div class="job-icon"><i class="fa-solid @(isIhm ? "fa-clipboard-list" : "fa-helmet-safety")"></i></div>

                        <div class="flex-grow-1">
                            <h2 class="job-title">@job.JobNumber</h2>
                            @if (!string.IsNullOrWhiteSpace(job.ClientName))
                            {
                                <p class="client">@job.ClientName</p>
                            }
                        </div>

                        <span class="status status-@statusCss" title="@($"{job.CompletedItems}/{job.TotalItems} complete")">
                            <i class="fa-solid @statusIcon"></i> @displayStatus
                        </span>
                    </div>

                    <div class="line"></div>

                    @if (!string.IsNullOrWhiteSpace(job.VesselName))
                    {
                        <div class="info-row"><i class="fa-solid fa-ship"></i><strong>Vessel</strong><span>@job.VesselName</span></div>
                    }

                    @if (!string.IsNullOrWhiteSpace(job.ImoNumber))
                    {
                        <div class="info-row"><i class="fa-solid fa-tag"></i><strong>IMO</strong><span>@job.ImoNumber</span></div>
                    }

                    @if (!string.IsNullOrWhiteSpace(job.SiteName))
                    {
                        <div class="info-row"><i class="fa-solid fa-location-dot"></i><strong>Site</strong><span>@job.SiteName</span></div>
                    }

                  

                    @{
                        var primarySurveyorName = job.Assignments?
                        .FirstOrDefault(x => job.PrimarySurveyorUserId.HasValue &&
                        x.SurveyorUserId == job.PrimarySurveyorUserId.Value)
                        ?.SurveyorName;

                        var secondarySurveyorName = job.Assignments?
                        .FirstOrDefault(x => job.SecondarySurveyorUserId.HasValue &&
                        x.SurveyorUserId == job.SecondarySurveyorUserId.Value)
                        ?.SurveyorName;

                        if (string.IsNullOrWhiteSpace(primarySurveyorName) && job.PrimarySurveyorUserId.HasValue)
                        {
                            primarySurveyorName = Model.Surveyors
                            .FirstOrDefault(x => x.Id == job.PrimarySurveyorUserId.Value)
                            ?.FullName;
                        }

                        if (string.IsNullOrWhiteSpace(secondarySurveyorName) && job.SecondarySurveyorUserId.HasValue)
                        {
                            secondarySurveyorName = Model.Surveyors
                            .FirstOrDefault(x => x.Id == job.SecondarySurveyorUserId.Value)
                            ?.FullName;
                        }

                        var hasAssignedSurveyor = !string.IsNullOrWhiteSpace(primarySurveyorName) ||
                        !string.IsNullOrWhiteSpace(secondarySurveyorName) ||
                        !string.IsNullOrWhiteSpace(job.AssignedSurveyorName);
                    }

                    <div class="job-meta-grid">
                        <div class="meta-tile">
                            <div class="meta-label"><i class="fa-regular fa-calendar-check"></i> Survey Date</div>

                            @if (!isSurveyor)
                            {
                                <div class="meta-value">@surveyDateText</div>
                            }
                            else
                            {
                                <form method="post" action="/SurveyJobs/UpdateSurveyDate" class="meta-date-form">
                                    <input type="hidden" name="jobId" value="@job.Id" />
                                    <input type="hidden" name="surveyType" value="@Model.SurveyType" />
                                    @if (hasIhmCompletionFilter)
                                    {
                                        <input type="hidden" name="ihmCompletionFilter" value="@Model.IhmCompletionFilter" />
                                    }
                                    <input type="date" name="surveyDate" value="@surveyDateValue" required />
                                    <button type="submit">@(job.SurveyDate.HasValue ? "Change" : "Select")</button>
                                </form>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(primarySurveyorName))
                        {
                            <div class="meta-tile">
                                <div class="meta-label"><i class="fa-regular fa-user"></i> Primary Surveyor</div>
                                <div class="meta-value">@primarySurveyorName</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(secondarySurveyorName))
                        {
                            <div class="meta-tile">
                                <div class="meta-label"><i class="fa-regular fa-user"></i> Secondary Surveyor</div>
                                <div class="meta-value">@secondarySurveyorName</div>
                            </div>
                        }

                        @if (string.IsNullOrWhiteSpace(primarySurveyorName) &&
                                        string.IsNullOrWhiteSpace(secondarySurveyorName) &&
                                        !string.IsNullOrWhiteSpace(job.AssignedSurveyorName))
                        {
                            <div class="meta-tile">
                                <div class="meta-label"><i class="fa-regular fa-user"></i> Surveyor</div>
                                <div class="meta-value">@job.AssignedSurveyorName</div>
                            </div>
                        }
                    </div>

                    <div class="actions">
                        @if (Model.IsAdmin)
                        {
                            <a class="action-btn blue" href="/SurveyJobs/ProjectInfo?jobId=@job.Id@ihmFilterQuery">
                                <i class="fa-solid fa-up-right-from-square"></i> Open
                            </a>
                        }
                        else
                        {
                            <a class="action-btn blue" href="@jobSurveyUrl">
                                <i class="fa-solid fa-up-right-from-square"></i> Open
                            </a>
                        }

                        @if (job.CanEdit)
                        {
                            <button class="action-btn amber" data-bs-toggle="modal" data-bs-target="#editJobModal-@job.Id">
                                <i class="fa-regular fa-pen-to-square"></i> Edit
                            </button>

                            <button class="action-btn teal" data-bs-toggle="modal" data-bs-target="#assignModal-@job.Id">
                                <i class="fa-solid @(hasAssignedSurveyor ? "fa-repeat" : "fa-user-plus")"></i>
                                @(hasAssignedSurveyor ? "Reassign Surveyor" : "Assign Surveyor")
                            </button>

                              <form method="post" action="/SurveyJobs/Delete" class="d-inline" onsubmit="return confirm('Delete job @job.JobNumber? This cannot be undone.');">
                                <input type="hidden" name="jobId" value="@job.Id" />
                                <input type="hidden" name="surveyType" value="@Model.SurveyType" />
                                @if (hasIhmCompletionFilter)
                                {
                                    <input type="hidden" name="ihmCompletionFilter" value="@Model.IhmCompletionFilter" />
                                }
                                <button type="submit" class="action-btn red">
                                    <i class="fa-regular fa-trash-can"></i> Delete
                                </button>
                            </form>


                        }

                        @if (Model.IsAdmin && isIhm)
                        {
                            var hasVscpChecklist = !string.IsNullOrWhiteSpace(job.VscpChecklistFilePath);
                            var checklistQuery = hasIhmCompletionFilter
                                ? $"&ihmCompletionFilter={Uri.EscapeDataString(Model.IhmCompletionFilter!)}"
                                : string.Empty;

                            <form method="post" enctype="multipart/form-data" action="/SurveyJobs/UploadIhmExcel" class="d-inline">
                                <input type="hidden" name="jobId" value="@job.Id" />
                                @if (hasIhmCompletionFilter)
                                {
                                    <input type="hidden" name="ihmCompletionFilter" value="@Model.IhmCompletionFilter" />
                                }
                                <input type="file" name="file" accept=".xlsx" hidden onchange="showPageLoading('Uploading...'); this.form.submit();" id="excel-@job.Id" />
                                @if (hasVscpChecklist)
                                {
                                    <a class="action-btn purple" href="/SurveyJobs/ViewVscpChecklist?jobId=@job.Id@checklistQuery">
                                        <i class="fa-regular fa-eye"></i> View VSCP Checklist
                                    </a>
                                    <label class="action-btn green" for="excel-@job.Id">
                                        <i class="fa-regular fa-file-excel"></i> Replace VSCP Checklist Template
                                    </label>
                                }
                                else
                                {
                                    <label class="action-btn green" for="excel-@job.Id">
                                        <i class="fa-regular fa-file-excel"></i> Upload VSCP Checklist Template
                                    </label>
                                }
                            </form>

                            <a class="action-btn purple" href="/IhmReportInfo/Index?jobId=@job.Id">
                                <i class="fa-regular fa-file-pdf"></i> IHM Report
                            </a>

                            <button class="action-btn amber" type="button" data-bs-toggle="modal" data-bs-target="#layoutModal-@job.Id">
                                <i class="fa-regular fa-map"></i> Upload Layouts
                            </button>
                            <a class="action-btn blue" href="@jobSurveyUrl">
                                <i class="fa-solid fa-clipboard-check"></i> Survey
                            </a>
                        }
                    </div>
                </article>

                @if (job.CanEdit)
                {
                <div class="modal fade" id="editJobModal-@job.Id" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <form class="modal-content" method="post" action="/SurveyJobs/Edit">
                            <div class="modal-header">
                                <h5 class="modal-title">Edit Job - @job.JobNumber</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                <input type="hidden" name="jobId" value="@job.Id" />
                                <input type="hidden" name="SurveyType" value="@Model.SurveyType" />
                                <input type="hidden" name="SurveyDate" value="@(job.SurveyDate?.ToString("yyyy-MM-dd"))" />
                                @if (hasIhmCompletionFilter)
                                {
                                    <input type="hidden" name="ihmCompletionFilter" value="@Model.IhmCompletionFilter" />
                                }

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Project Name</label>
                                        <input class="form-control" name="ProjectName" value="@job.ProjectName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Audit Port *</label>
                                        <input class="form-control" name="AuditPort" value="@(job.AuditPort ?? job.SiteName)" required />
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label">Audit Address</label>
                                        <input class="form-control" name="AuditAddress" value="@job.AuditAddress" />
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label">Select Vessel *</label>
                                        <select class="form-select" name="VesselId" required>
                                            <option value="">Select vessel</option>
                                            @foreach (var vessel in Model.Vessels)
                                            {
                                                <option value="@vessel.Id" selected="@(job.VesselId == vessel.Id ? "selected" : null)">
                                                    @vessel.VesselName @(string.IsNullOrWhiteSpace(vessel.ImoNumber) ? "" : $" - IMO {vessel.ImoNumber}")
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-12">
