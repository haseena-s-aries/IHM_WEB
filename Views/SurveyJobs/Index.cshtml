    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
                document.addEventListener("DOMContentLoaded", function () {
            const vesselSelect = document.getElementById("VesselId");
            const currentProjectId = @(isIhm ? 1 : 2);
            const clientNameInput = document.getElementById("ClientName");

            if (!vesselSelect || !clientNameInput) return;
                    Array.from(vesselSelect.options).forEach(option => {
            if (!option.value) return;

            const vesselProjectId = Number(option.getAttribute("data-project-id") || 0);

            if (vesselProjectId && vesselProjectId !== currentProjectId) {
                option.remove();
            }
        });
            vesselSelect.addEventListener("change", function () {
                const selectedOption = vesselSelect.options[vesselSelect.selectedIndex];
                const clientName = selectedOption.getAttribute("data-client-name") || "";

                clientNameInput.value = clientName;
            });
        });
        document.getElementById("jobSearch").addEventListener("input", function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll(".job-card").forEach(card => {
                card.style.display = card.dataset.search.includes(q) ? "" : "none";
            });
        });
                document.querySelectorAll(".job-card .actions a, .job-card .actions button, .job-card .actions label, .job-card .actions form").forEach(element => {
            element.addEventListener("click", function (event) {
                event.stopPropagation();
            });
        });

                document.querySelectorAll(".area-layout-form").forEach(form => {
            const modal = form.closest(".modal");
            if (!modal) return;

            modal.addEventListener("show.bs.modal", function () {
                loadLayoutOptions(form);
            });

                    form.addEventListener("submit", function (event) {
            if (!form.querySelector(".pending-layout-row")) {
                event.preventDefault();
                event.stopImmediatePropagation();
                alert("Please add at least one layout file to the pending list.");
                updateLayoutUploadSubmitState(form);
                return false;
            }
        });
        });

        document.querySelectorAll(".area-layout-select").forEach(select => {
            select.addEventListener("change", function () {
                const form = this.closest(".area-layout-form");
                const newFields = form.querySelector(".new-area-fields");
                const newName = newFields.querySelector("input");
                const hint = form.querySelector(".area-location-hint");
                const option = this.options[this.selectedIndex];
                const isNew = this.value === "new";

                newFields.hidden = !isNew;
                newName.required = isNew;

                if (this.value === "common") {
                    hint.textContent = "Common is shown only where no specific area layout is uploaded.";
                } else if (isNew) {
                    hint.textContent = "The images will be mapped only to the new area.";
                } else {
                    hint.textContent = option.dataset.locations
                        ? `Checkpoint locations: ${option.dataset.locations}`
                        : "These images will appear only inside this survey area.";
                }

                updateAttachment(form, option);
            });

            const form = select.closest(".area-layout-form");
            updateAttachment(form, select.options[select.selectedIndex]);
                    form.querySelector(".layout-add-to-list").addEventListener("click", function () {
            addLayoutUploadToList(form);
        });
        });
                function updateLayoutUploadSubmitState(form) {
            const submitButton = form.querySelector(".layout-upload-submit");
            if (!submitButton) return;

            submitButton.disabled = !form.querySelector(".pending-layout-row");
        }
                function addLayoutUploadToList(form) {
            const select = form.querySelector(".area-layout-select");
            const option = select.options[select.selectedIndex];
            const fileInput = form.querySelector(".layout-file-input");
            const newNameInput = form.querySelector(".new-area-fields input");
            const pendingList = form.querySelector(".pending-list");
            const pendingEmpty = form.querySelector(".pending-empty");

            if (!option) {
                alert("Please select a layout visibility.");
                return;
            }

            if (select.value === "new" && !newNameInput.value.trim()) {
                alert("Enter the new area name.");
                newNameInput.focus();
                return;
            }

            if (!fileInput.files.length) {
                alert("Please choose a layout file.");
                fileInput.focus();
                return;
            }

            const file = fileInput.files[0];
            const target = select.value;
            const targetLabel = option.textContent.trim();
            const newAreaName = select.value === "new" ? newNameInput.value.trim() : "";

            const duplicate = pendingList.querySelector(`[data-target="${CSS.escape(target)}"]`);
            if (duplicate) {
                duplicate.remove();
            }

            const row = document.createElement("div");
            row.className = "pending-layout-row border rounded p-2 d-flex align-items-start justify-content-between gap-2 overflow-hidden";
            row.dataset.target = target;

            const text = document.createElement("div");
            text.className = "min-w-0 flex-grow-1 overflow-hidden";
            text.innerHTML = `
                <div class="fw-semibold text-truncate">${escapeHtml(targetLabel)}</div>
                <div class="small text-muted pending-file-name">${escapeHtml(file.name)}</div>
            `;

            const removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.className = "btn btn-sm btn-outline-danger";
            removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
            removeBtn.addEventListener("click", function () {
                row.remove();
                pendingEmpty.classList.toggle("d-none", pendingList.children.length > 0);
                updateLayoutUploadSubmitState(form);
            });

            const targetInput = document.createElement("input");
            targetInput.type = "hidden";
            targetInput.name = "layoutTargets";
            targetInput.value = target;

            const newAreaInput = document.createElement("input");
            newAreaInput.type = "hidden";
            newAreaInput.name = "newAreaNames";
            newAreaInput.value = newAreaName;

            fileInput.name = "files";
            fileInput.required = false;
            fileInput.classList.add("d-none");

            row.appendChild(text);
            row.appendChild(removeBtn);
            row.appendChild(targetInput);
            row.appendChild(newAreaInput);
            row.appendChild(fileInput);
            pendingList.appendChild(row);

            const replacement = document.createElement("input");
            replacement.className = "form-control layout-file-input";
            replacement.type = "file";
            replacement.accept = ".jpg,.jpeg,.png,.webp,.pdf";

            const addButton = form.querySelector(".layout-add-to-list");
            addButton.parentElement.insertBefore(replacement, addButton);

                    pendingEmpty.classList.add("d-none");
        updateLayoutUploadSubmitState(form);
        updateAttachment(form, option);
        }

        function escapeHtml(value) {
            return String(value || "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }
        function updateAttachment(form, option) {
            const details = form.querySelector(".attachment-details");
            const empty = form.querySelector(".attachment-empty");
            const link = form.querySelector(".attachment-link");
            const badge = details.querySelector(".badge");
            if (!option) return;
            const deleteButton = details.querySelector(".attachment-delete-layout");
            const fileName = option.dataset.fileName;
            const filePath = option.dataset.filePath;

            if (fileName && filePath) {
                empty.classList.add("d-none");
                details.classList.remove("d-none");
                details.classList.add("d-flex");
                link.href = filePath;
                link.textContent = fileName;
                badge.textContent = "Saved";
                badge.className = "badge bg-success";
                        if (deleteButton) {
            deleteButton.dataset.target = option.value;
            deleteButton.onclick = () => deleteSavedLayoutAttachment(form, option.value);
        }
            } else {
                details.classList.add("d-none");
                details.classList.remove("d-flex");
                empty.classList.remove("d-none");
                empty.textContent = option.value === "common"
                    ? "No Common Layout uploaded."
                    : "No specific attachment uploaded. Flutter will use Common Layout.";
            }
        }

        async function loadLayoutOptions(form) {
            if (form.dataset.layoutLoading === "true") {
                return;
            }

            const jobId = form.dataset.jobId;
            const select = form.querySelector(".area-layout-select");
            const fileInput = form.querySelector(".layout-file-input");
            const hint = form.querySelector(".area-location-hint");
            const previousValue = select.value || "common";
            const requestUrl = `/SurveyJobs/IhmLayoutOptions?jobId=${encodeURIComponent(jobId)}`;

            form.dataset.layoutLoading = "true";
            select.disabled = true;
            fileInput.disabled = true;
            hint.textContent = "Loading layout options...";

            try {
                debugLayoutOptions("request", { jobId, url: requestUrl });
                const response = await fetch(requestUrl, {
                    headers: { "Accept": "application/json" }
                });
                const responseText = await response.text();
                debugLayoutOptions("response", {
                    jobId,
                    url: requestUrl,
                    status: response.status,
                    body: responseText
                });

                if (!response.ok) {
                    throw new Error(readLayoutError(responseText) || `Unable to load layout options. (${response.status})`);
                }

                const data = responseText ? JSON.parse(responseText) : {};
                const areas = data.areas || data.Areas || [];
                const attachments = data.attachments || data.Attachments || [];
                const attachmentMap = new Map();

                attachments.forEach(item => {
                    const target = String(item.target || item.Target || "");
                    if (target) attachmentMap.set(target, item);
                });

                const commonLayout = data.commonLayout || data.CommonLayout || {};
                const commonAttachment = attachmentMap.get("common") || commonLayout || {};
                select.innerHTML = "";
                select.appendChild(createLayoutOption(
                    commonLayout.value || commonLayout.Value || "common",
                    commonLayout.label || commonLayout.Label || "Common Layout - fallback for every location",
                    "",
                    commonAttachment.originalFileName || commonAttachment.OriginalFileName,
                    commonAttachment.filePath || commonAttachment.FilePath
                ));

                areas.forEach(area => {
                    const areaId = String(area.id || area.Id || "").trim();
                    const areaValue = area.value || area.Value || (areaId ? `area:${areaId}` : "");
                    if (!areaValue) return;
                    const attachment = attachmentMap.get(areaId) || area || {};
                    select.appendChild(createLayoutOption(
                        areaValue,
                        area.label || area.Label || area.areaName || area.AreaName || "Survey area",
                        area.locationSummary || area.LocationSummary || "",
                        attachment.originalFileName || attachment.OriginalFileName,
                        attachment.filePath || attachment.FilePath
                    ));
                });

                select.value = Array.from(select.options).some(option => option.value === previousValue)
                    ? previousValue
                    : "common";

                form.dataset.layoutLoaded = "true";
                select.dispatchEvent(new Event("change"));
                if (!areas.length) {
                    hint.textContent = "No survey areas found. Upload the checklist Excel first.";
                }
            } catch (error) {
                form.dataset.layoutLoaded = "false";
                hint.innerHTML = "";
                const message = document.createElement("span");
                message.textContent = error.message || "Unable to load layout options.";
                hint.appendChild(message);
                hint.appendChild(document.createTextNode(" "));
                const retry = document.createElement("button");
                retry.type = "button";
                retry.className = "btn btn-link btn-sm p-0 align-baseline layout-options-retry";
                retry.textContent = "Retry";
                retry.addEventListener("click", () => loadLayoutOptions(form));
                hint.appendChild(retry);
                updateAttachment(form, select.options[select.selectedIndex]);
            } finally {
                form.dataset.layoutLoading = "false";
                select.disabled = false;
                fileInput.disabled = false;
            }
        }

        function createLayoutOption(value, label, locations, fileName, filePath) {
            const option = document.createElement("option");
            option.value = value;
            option.textContent = label;
            option.dataset.locations = locations || "";
            option.dataset.fileName = fileName || "";
            option.dataset.filePath = filePath || "";
            return option;
        }
                async function deleteSavedLayoutAttachment(form, target) {
            if (!target) return;

            if (!confirm("Delete this layout attachment?")) return;

            const jobId = form.dataset.jobId;
            const button = form.querySelector(".attachment-delete-layout");
            const select = form.querySelector(".area-layout-select");
            const option = select.options[select.selectedIndex];

            if (button) button.disabled = true;

            try {
                const data = new FormData();
                data.append("jobId", jobId);
                data.append("target", target);

                const response = await fetch("/SurveyJobs/DeleteIhmLayoutAttachment", {
                    method: "POST",
                    body: data
                });

                const responseText = await response.text();

                if (!response.ok) {
                    throw new Error(readLayoutError(responseText) || "Failed to delete layout attachment.");
                }

                if (option) {
                    option.dataset.fileName = "";
                    option.dataset.filePath = "";
                }

                updateAttachment(form, option);
                await loadLayoutOptions(form);

                alert("Layout attachment deleted.");
            } catch (error) {
                alert(error.message || "Failed to delete layout attachment.");
            } finally {
                if (button) button.disabled = false;
            }
        }
        function readLayoutError(responseText) {
            if (!responseText) return "";
            try {
                const data = JSON.parse(responseText);
                return data.message || data.Message || data.error || data.Error || responseText;
            } catch {
                return responseText;
            }
        }

        function debugLayoutOptions(stage, data) {
            const isDev = ["localhost", "127.0.0.1"].includes(window.location.hostname);
            if (isDev && window.console) {
                console.debug(`[IHM layout options] ${stage}`, data);
            }
        }

    </script>

