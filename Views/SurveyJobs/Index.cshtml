    <script>
        function showPageLoading(text) {
            const indicatorText = document.querySelector(".page-loading-indicator span:last-child");
            if (indicatorText) indicatorText.textContent = text || "Please wait...";

            document.body.classList.add("page-busy");

            document.querySelectorAll("a, button, input, select, textarea, label").forEach(element => {
                if (element.type !== "hidden") {
                    element.style.pointerEvents = "none";
                }
            });
        }

        document.querySelectorAll("form").forEach(form => {
            form.addEventListener("submit", function () {
                showPageLoading("Processing...");

                const submitButton = form.querySelector('button[type="submit"]');
                if (submitButton) {
                    submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Please wait...';
                    submitButton.disabled = true;
                }
            });
        });
          
        

        function markedSectionCode(item) {
            const raw = item?.sectionTypeCode ?? item?.SectionTypeCode ?? item?.sectionType ?? item?.SectionType ?? item?.sectionTypeText ?? item?.SectionTypeText;
            if (raw === null || raw === undefined) return 0;
            const numeric = Number(raw);
            if (!Number.isNaN(numeric)) return numeric;
            const text = String(raw).toLowerCase();
            if (text === "hazardous") return 1;
            if (text === "appendix4") return 2;
            return 0;
        }

        function markedStatusCode(item) {
            const raw = item?.statusCode ?? item?.StatusCode ?? item?.status ?? item?.Status ?? item?.statusText ?? item?.StatusText;
            if (raw === null || raw === undefined) return 0;
            const numeric = Number(raw);
            if (!Number.isNaN(numeric)) return numeric;
            switch (String(raw).toLowerCase()) {
                case "pending": return 1;
                case "processing": return 2;
                case "completed": return 3;
                case "failed": return 4;
                default: return 0;
            }
        }

       

    
        document.querySelectorAll(".job-card[data-card-href]").forEach(card => {
            card.addEventListener("click", event => {
                if (event.target.closest("a, button, input, select, textarea, label, form")) return;

                showPageLoading("Loading...");
                window.location.href = card.dataset.cardHref;
            });
        });
    </script>
