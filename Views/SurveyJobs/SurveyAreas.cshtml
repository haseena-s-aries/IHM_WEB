@model List<Survery_Certification_App_Consume.Models.IhmAreaOptionDto>
@{
    Layout = null;
    var job = ViewBag.Job as Survery_Certification_App_Consume.Models.SurveyJobDto;
    var jobId = (int)(ViewBag.JobId ?? 0);
    var ihmCompletionFilter = ViewBag.IhmCompletionFilter?.ToString();
    var ihmFilterQuery = string.IsNullOrWhiteSpace(ihmCompletionFilter)
        ? ""
        : $"&ihmCompletionFilter={Uri.EscapeDataString(ihmCompletionFilter!)}";
    var returnUrl = ViewBag.ReturnUrl?.ToString();
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = $"/SurveyJobs/Work?jobId={jobId}&surveyType=IHM%20Survey{ihmFilterQuery}";
    }
    var surveyAreasUrl = $"/SurveyJobs/SurveyAreas?jobId={jobId}{ihmFilterQuery}&returnUrl={Uri.EscapeDataString(returnUrl)}";
    var areaReturnQuery = $"&returnUrl={Uri.EscapeDataString(surveyAreasUrl)}";

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Survey Areas</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef4fb;
            color: #102033;
            font-family: "Segoe UI",Arial,sans-serif;
        }

        /* HEADER */

        .appbar {
            height: 66px;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 0 20px;
            background: #f5f8fd;
            border-bottom: 1px solid #d7e3f1;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .back-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            color: #102033;
            text-decoration: none;
            font-size: 22px;
            flex-shrink: 0;
        }

            .back-btn:hover {
                color: #102033;
                text-decoration: none;
            }

        .title {
            margin: 0;
            font-size: 26px;
            font-weight: 900;
        }

        .page {
            max-width: 1320px; /* reduced */

            margin: auto;
            padding: 18px;
        }

        .sub {
            margin: 0 0 22px;
            color: #607d9a;
            font-size: 16px;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 900;
        }


        /* GRID */

        .grid {
            display: grid;
            gap: 14px;
            grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        }


        /* CARD */

        .area-card {
            background: #fff;
            border: 1px solid #ffe2c5;
            border-radius: 18px;
            overflow: hidden;
            min-height: 220px;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: #102033;
            transition: .18s;
            box-shadow: 0 3px 12px rgba(255,154,61,.07);
        }

            .area-card:hover {
                transform: translateY(-1px);
                color: #102033;
                text-decoration: none;
            }


        /* TOP */

        .card-head {
            background: #fff3e8;
            padding: 14px 16px;
            min-height: 78px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            flex-wrap: wrap;
        }


        /* REMOVE UNDERLINE */

        .name,
        .name:hover,
        .name:focus,
        .name:visited {
            text-decoration: none !important;
            color: #f49b40;
            font-size: 14px;
            font-weight: 750;
            line-height: 1.35;
            max-width: 100%;
            display: block;
            overflow: visible;
            overflow-wrap: anywhere;
            word-break: break-word;
        }


        .layout-btn {
            background: #fff1e2;
            border: 1px solid #ffd4ad;
            color: #f49b40;
            border-radius: 12px;
            padding: 7px 10px;
            font-size: 11px;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            white-space: nowrap;
        }

            .layout-btn:hover {
                color: #f49b40;
                text-decoration: none;
            }


        /* BODY */

        .card-body {
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            flex: 1;
            text-decoration: none;
        }

            .card-body:hover {
                text-decoration: none;
            }


        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
            font-size: 14px;
            color: #607d9a;
        }

        .stat-left {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            overflow-wrap: anywhere;
        }

            .stat-left i {
                width: 16px;
                font-size: 13px;
            }

        .stat-value {
            font-weight: 900;
        }

        .blue {
            color: #1e96ff;
        }

        .purple {
            color: #9475ff;
        }

        .green {
            color: #59bb9a;
        }

        .orange {
            color: #f6a03e;
        }


        /* PROGRESS */

        .progress-wrap {
            margin-top: auto;
            padding-top: 10px;
        }

        .progress-line {
            height: 7px;
            border-radius: 999px;
            background: #d7dfeb;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: #f6a03e;
            border-radius: 999px;
        }

        .progress-text {
            margin-top: 8px;
            font-size: 13px;
            color: #607d9a;
        }



        /* RESPONSIVE */

        /* Desktop XL */

        @@media (max-width:1200px) {
            .grid {
                grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
            }
        }

        @@media (max-width:900px) {
            .grid {
                grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
            }
        }

        @@media (max-width:620px) {
            .page {
                padding: 14px;
            }

            .grid {
                grid-template-columns: 1fr;
            }



            .title {
                font-size: 22px;
            }

            .sub {
                font-size: 14px;
            }

            .area-card {
                min-height: 200px;
            }

            .name {
                font-size: 15px;
            }

            .layout-btn {
                font-size: 10px;
                padding: 6px 8px;
            }

            .stat-row {
                font-size: 13px;
            }
        }


        /* Small mobile */

        @@media (max-width:430px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .area-card {
                min-height: 185px;
            }

            .card-head {
                padding: 12px;
            }

            .card-body {
                padding: 12px;
            }
        }
    </style>
</head>

<body>
    <header class="appbar">
        <a class="back-btn" href="@returnUrl">
            <i class="fa-solid fa-chevron-left"></i>
        </a>
        <h1 class="title">Survey Areas</h1>
    </header>

    <main class="page">
        <p class="sub">Areas — @Model.Count Total</p>

        <div class="grid">
            @foreach (var area in Model)
            {
                var total = area.Checkpoints?.Count ?? 0;
                var visual = area.Checkpoints?.Count(x => x.IsVisual) ?? 0;
                var sample = area.Checkpoints?.Count(x => x.IsSample) ?? 0;
                var audited = area.Checkpoints?.Count(x => x.IsAudited) ?? 0;
                var pending = total - audited;
                var percent = total > 0 ? (int)Math.Round((audited * 100.0) / total) : 0;

                <div class="area-card">
                    <div class="card-head">
                        <a class="name" href="/SurveyJobs/AreaCheckpoints?jobId=@jobId&areaId=@area.Id@ihmFilterQuery@areaReturnQuery">
                            @area.AreaName
                        </a>


                    </div>

                    <a class="card-body" href="/SurveyJobs/AreaCheckpoints?jobId=@jobId&areaId=@area.Id@ihmFilterQuery@areaReturnQuery">
                        <div class="stat-row">
                            <span class="stat-left">
                                <i class="fa-regular fa-circle-check"></i>
                                Total
                            </span>
                            <span class="stat-value">@total</span>
                        </div>

                        <div class="stat-row">
                            <span class="stat-left blue">
                                <i class="fa-regular fa-eye"></i>
                                Visuals
                            </span>
                            <span class="stat-value blue">@visual</span>
                        </div>

                        <div class="stat-row">
                            <span class="stat-left purple">
                                <i class="fa-solid fa-flask"></i>
                                Samples
                            </span>
                            <span class="stat-value purple">@sample</span>
                        </div>

                        <div class="stat-row">
                            <span class="stat-left green">
                                <i class="fa-regular fa-circle-check"></i>
                                Audited
                            </span>
                            <span class="stat-value green">@audited</span>
                        </div>

                        <div class="stat-row">
                            <span class="stat-left orange">
                                <i class="fa-solid fa-hourglass-half"></i>
                                Pending
                            </span>
                            <span class="stat-value orange">@pending</span>
                        </div>

                        <div class="progress-wrap">
                            <div class="progress-line">
                                <div class="progress-fill" style="width:@percent%"></div>
                            </div>
                            <div class="progress-text">@percent% complete</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </main>
</body>
</html>
