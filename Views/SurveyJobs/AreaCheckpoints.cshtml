@model Survery_Certification_App_Consume.Models.IhmAreaOptionDto
@{
    Layout = null;
    var jobId = (int)(ViewBag.JobId ?? 0);

    string Val(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.AreaName Checkpoints</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef4fb;
            color: #102033;
            font-family: "Segoe UI",Arial,sans-serif;
        }

        /* HEADER */

        .appbar {
            height: 62px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 18px;
            background: #f5f8fd;
            border-bottom: 1px solid #d8e3ee;
        }

        .back-btn {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            color: #102033;
            text-decoration: none;
            font-size: 20px;
        }

        .title {
            margin: 0;
            font-size: 20px;
            font-weight: 900;
        }

        .sub {
            margin: 2px 0 0;
            font-size: 13px;
            color: #607d9a;
        }


        /* PAGE */

        .page {
            max-width: 1320px; /* reduced */

            margin: auto;
            padding: 18px;
        }

        .section-title {
            margin: 0 0 18px;
            color: #607d9a;
            font-size: 14px;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 900;
        }


        /* RESPONSIVE GRID */

        .grid {
            display: grid;
            gap: 14px;
            /* default maximum = 4 cards */
            grid-template-columns: repeat(3,minmax(0,1fr));
        }


        /* CARD */

        .cp-card {
            background: #fff;
            border: 1px solid #ffe0e0;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 2px 10px rgba(255,120,120,.05);
            text-decoration: none;
            color: inherit;
            display: block;
        }


        /* TOP */

        .cp-head {
            background: #fff3f3;
            min-height: 72px;
            padding: 16px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .cp-left {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }


        /* BADGE */

        .type-badge {
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 900;
            display: flex;
            gap: 6px;
            align-items: center;
            white-space: nowrap;
        }

        .sample {
            background: #ffd9dd;
            color: #ff5d65;
        }

        .visual {
            background: #e2f1ff;
            color: #1e95ff;
        }

        .normal {
            background: #edf3f8;
            color: #607d9a;
        }


        /* TITLE */

        .cp-title {
            margin: 0;
            font-size: 15px;
            font-weight: 900;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .edit-btn {
            color: #607d9a;
            font-size: 18px;
            text-decoration: none;
        }


        /* BODY */

        .cp-body {
            padding: 16px 18px;
        }

        .info-row {
            display: grid;
            grid-template-columns: 95px 1fr;
            gap: 10px;
            margin-bottom: 10px;
            align-items: start;
        }

        .info-label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #607d9a;
            font-size: 13px;
            font-weight: 600;
        }

            .info-label i {
                width: 14px;
                font-size: 13px;
            }

        .info-value {
            font-size: 13px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .mark-layout-btn {
            margin-top: 10px;
            width: 100%;
            border: 1px solid #1e95ff;
            background: #eef7ff;
            color: #1e95ff;
            border-radius: 10px;
            padding: 9px 12px;
            font-size: 12px;
            font-weight: 900;
        }

        .marker-modal {
            position: fixed;
            inset: 0;
            background: rgba(10, 25, 45, .72);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 16px;
        }

        .marker-panel {
            width: min(100%, 980px);
            max-height: 92vh;
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .marker-head {
            padding: 12px 16px;
            border-bottom: 1px solid #d8e3ee;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .marker-title {
            margin: 0;
            font-size: 15px;
            font-weight: 900;
        }

        .marker-close {
            border: 0;
            background: transparent;
            font-size: 22px;
            line-height: 1;
        }

        .marker-body {
            padding: 14px;
            overflow: auto;
        }

        .marker-image-wrap {
            position: relative;
            width: 100%;
            border: 1px solid #d8e3ee;
            border-radius: 12px;
            overflow: hidden;
            background: #f5f8fd;
        }

        .marker-image {
            width: 100%;
            display: block;
        }

        .marker-pin {
            position: absolute;
            width: 24px;
            height: 24px;
            transform: translate(-50%, -100%);
            color: #ff4d4f;
            font-size: 24px;
            filter: drop-shadow(0 2px 3px rgba(0,0,0,.35));
            pointer-events: none;
        }

        .marker-foot {
            padding: 12px 16px;
            border-top: 1px solid #d8e3ee;
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: center;
            color: #607d9a;
            font-size: 12px;
            font-weight: 700;
        }

        .marker-save {
            border: 0;
            background: #20c997;
            color: white;
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 12px;
            font-weight: 900;
        }

            .marker-save:disabled {
                opacity: .55;
            }
        /* STATUS */

        .status-box {
            margin-top: 12px;
            border: 1px solid #ccd7e4;
            background: #f4f7fa;
            border-radius: 12px;
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 800;
        }

        .status-left {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .result-text {
            color: #607d9a;
        }


        /* BREAKPOINTS */

        @@media (max-width:1200px) {
            .grid

        {
            grid-template-columns: repeat(3,1fr);
        }

        }

        @@media (max-width:900px) {
            .grid

        {
            grid-template-columns: repeat(2,1fr);
        }

        }

        @@media (max-width:620px) {
            .page

        {
            padding: 14px;
        }

        .grid {
            grid-template-columns: 1fr;
        }

        

        .cp-head {
            padding: 14px;
            min-height: 64px;
        }

        .cp-body {
            padding: 14px;
        }

        .title {
            font-size: 18px;
        }

        .cp-title {
            font-size: 14px;
        }

        }

        @@media (max-width:420px) {
            .info-row

        {
            grid-template-columns: 1fr;
            gap: 3px;
        }

        .status-box {
            flex-direction: column;
            align-items: flex-start;
        }

        }
    </style>
</head>

<body>
    <header class="appbar">
        <a class="back-btn" href="/SurveyJobs/SurveyAreas?jobId=@jobId">
            <i class="fa-solid fa-chevron-left"></i>
        </a>
        <div>
            <h1 class="title">@Model.AreaName</h1>
            <p class="sub">@(Model.Checkpoints?.Count ?? 0) checkpoints</p>
        </div>
    </header>

    <main class="page">
        <h2 class="section-title">Checkpoints</h2>

        <div class="grid">
            @foreach (var checkpoint in Model.Checkpoints ?? new List<Survery_Certification_App_Consume.Models.IhmCheckpointOptionDto>())
            {
                var isVisual = checkpoint.IsVisual;
                var isSample = checkpoint.IsSample;

                var typeClass = isVisual ? "visual" : isSample ? "sample" : "normal";
                var typeText = isVisual ? "Visual" : isSample ? "Sample" : "Checkpoint";
                var icon = isVisual ? "fa-eye" : isSample ? "fa-flask" : "fa-location-dot";

                var code = Val(checkpoint.SampleNo ?? checkpoint.Location);
                var surveyStatus = checkpoint.IsAudited ? "Surveyed" : "Not surveyed yet";
                var result = Val(checkpoint.Result ?? checkpoint.CheckResult);

                <a class="cp-card" href="/SurveyJobs/CheckpointDetail?jobId=@jobId&areaId=@Model.Id&checkpointId=@checkpoint.Id">
                    <div class="cp-head">
                        <div class="cp-left">
                            <span class="type-badge @typeClass">
                                <i class="fa-solid @icon"></i>
                                @typeText
                            </span>
                            <h2 class="cp-title">@code</h2>
                        </div>

                        @* <a class="edit-btn"
                           href="/SurveyJobs/EditCheckpoint?jobId=@jobId&checkpointId=@checkpoint.Id">
                            <i class="fa-solid fa-pencil"></i>
                        </a> *@
                    </div>

                    <div class="cp-body">
                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-location-dot"></i>
                                Location
                            </div>
                            <div class="info-value">@Val(checkpoint.Location)</div>
                        </div>

                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-gear"></i>
                                Equipment
                            </div>
                            <div class="info-value">@Val(checkpoint.EquipmentName)</div>
                        </div>

                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-shapes"></i>
                                Component
                            </div>
                            <div class="info-value">@Val(checkpoint.Component)</div>
                        </div>

                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Hazmat
                            </div>
                            <div class="info-value">@Val(checkpoint.Description)</div>
                        </div>
                        <button type="button"
                                class="mark-layout-btn"
                                onclick="event.preventDefault(); event.stopPropagation(); openMarkerModal(this);"
                                data-job-id="@jobId"
                                data-area-id="@Model.Id"
                                data-checkpoint-id="@checkpoint.Id"
                                data-label="@code"
                                data-image-path="@Model.LayoutFilePath">
                            <i class="fa-solid fa-location-dot"></i>
                            Mark Layout
                        </button>
                        <div class="status-box">
                            <div class="status-left">
                                <i class="fa-solid fa-user-check"></i>
                                @surveyStatus
                            </div>
                            <div class="result-text">Result: @result</div>
                        </div>
                    </div>
                </a>
            }
        </div>
    </main>
    <div id="markerModal" class="marker-modal">
        <div class="marker-panel">
            <div class="marker-head">
                <h3 id="markerTitle" class="marker-title">Mark Layout</h3>
                <button type="button" class="marker-close" onclick="closeMarkerModal()">×</button>
            </div>

            <div class="marker-body">
                <div id="markerImageWrap" class="marker-image-wrap">
                    <img id="markerImage" class="marker-image" src="" alt="Layout" />
                    <i id="markerPin" class="fa-solid fa-location-dot marker-pin" style="display:none;"></i>
                </div>
            </div>

            <div class="marker-foot">
                <span id="markerHint">Click on the layout image to place marker.</span>
                <button id="markerSaveBtn" type="button" class="marker-save" onclick="saveMarker()" disabled>
                    Save Marker
                </button>
            </div>
        </div>
    </div>
    <script>
        let markerState = {
            jobId: 0,
            areaId: 0,
            checkpointId: 0,
            imagePath: "",
            label: "",
            xPercent: null,
            yPercent: null
        };

        function normalizeImageUrl(path) {
            if (!path) return "";
            if (path.startsWith("http")) return path;
            return path.startsWith("/") ? path : "/" + path;
        }

        async function openMarkerModal(button) {
            markerState = {
                jobId: Number(button.dataset.jobId),
                areaId: Number(button.dataset.areaId),
                checkpointId: Number(button.dataset.checkpointId),
                imagePath: button.dataset.imagePath || "",
                label: button.dataset.label || "",
                xPercent: null,
                yPercent: null
            };

            if (!markerState.imagePath) {
                alert("Layout image not uploaded for this area.");
                return;
            }

            document.getElementById("markerTitle").innerText =
                "Mark Layout - " + markerState.label;

            document.getElementById("markerImage").src =
                normalizeImageUrl(markerState.imagePath);

            document.getElementById("markerPin").style.display = "none";
            document.getElementById("markerSaveBtn").disabled = true;
            document.getElementById("markerModal").style.display = "flex";

            await loadExistingMarker();
        }

        function closeMarkerModal() {
            document.getElementById("markerModal").style.display = "none";
        }

        function placePin(xPercent, yPercent) {
            markerState.xPercent = xPercent;
            markerState.yPercent = yPercent;

            const pin = document.getElementById("markerPin");
            pin.style.left = xPercent + "%";
            pin.style.top = yPercent + "%";
            pin.style.display = "block";

            document.getElementById("markerSaveBtn").disabled = false;
        }

        async function loadExistingMarker() {
            try {
                const response = await fetch(`/SurveyJobs/GetIhmMarkers?jobId=${markerState.jobId}`);
                if (!response.ok) return;

                const markers = await response.json();
                const normalizedPath = markerState.imagePath.toLowerCase();

                const existing = markers.find(x =>
                    Number(x.ihmCheckpointId ?? x.IhmCheckpointId) === markerState.checkpointId &&
                    String(x.imagePath ?? x.ImagePath ?? "").toLowerCase() === normalizedPath
                );

                if (existing) {
                    placePin(
                        Number(existing.xPercent ?? existing.XPercent),
                        Number(existing.yPercent ?? existing.YPercent)
                    );
                    document.getElementById("markerSaveBtn").disabled = true;
                    document.getElementById("markerHint").innerText =
                        "Existing marker loaded. Click another point to update.";
                } else {
                    document.getElementById("markerHint").innerText =
                        "Click on the layout image to place marker.";
                }
            } catch {
                document.getElementById("markerHint").innerText =
                    "Click on the layout image to place marker.";
            }
        }

        document.getElementById("markerImageWrap").addEventListener("click", function (event) {
            const img = document.getElementById("markerImage");
            const rect = img.getBoundingClientRect();

            if (
                event.clientX < rect.left ||
                event.clientX > rect.right ||
                event.clientY < rect.top ||
                event.clientY > rect.bottom
            ) {
                return;
            }

            const xPercent = ((event.clientX - rect.left) / rect.width) * 100;
            const yPercent = ((event.clientY - rect.top) / rect.height) * 100;

            placePin(
                Math.max(0, Math.min(100, xPercent)),
                Math.max(0, Math.min(100, yPercent))
            );
        });

        async function saveMarker() {
            if (markerState.xPercent === null || markerState.yPercent === null) {
                alert("Please click on layout image first.");
                return;
            }

            const saveBtn = document.getElementById("markerSaveBtn");
            saveBtn.disabled = true;
            saveBtn.innerText = "Saving...";

            try {
                const response = await fetch("/SurveyJobs/SaveIhmMarker", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        surveyJobId: markerState.jobId,
                        ihmAreaId: markerState.areaId,
                        ihmCheckpointId: markerState.checkpointId,
                        imagePath: markerState.imagePath,
                        xPercent: markerState.xPercent,
                        yPercent: markerState.yPercent
                    })
                });

                if (!response.ok) {
                    const text = await response.text();
                    throw new Error(text || "Failed to save marker.");
                }

                document.getElementById("markerHint").innerText = "Marker saved.";
                saveBtn.innerText = "Saved";
                setTimeout(closeMarkerModal, 700);
            } catch (error) {
                alert(error.message || "Failed to save marker.");
                saveBtn.disabled = false;
                saveBtn.innerText = "Save Marker";
            }
        }
    </script>
</body>
</html>