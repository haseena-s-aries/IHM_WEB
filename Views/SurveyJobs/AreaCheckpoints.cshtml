@model Survery_Certification_App_Consume.Models.IhmAreaOptionDto
@{
    Layout = null;
    var jobId = (int)(ViewBag.JobId ?? 0);
    var apiRoot = ViewBag.ApiRoot?.ToString() ?? "";
    var ihmCompletionFilter = ViewBag.IhmCompletionFilter?.ToString();
    var layouts = ViewBag.Layouts as List<Survery_Certification_App_Consume.Models.IhmLayoutAttachmentDto>
        ?? new List<Survery_Certification_App_Consume.Models.IhmLayoutAttachmentDto>();
    var ihmFilterQuery = string.IsNullOrWhiteSpace(ihmCompletionFilter)
        ? ""
        : $"&ihmCompletionFilter={Uri.EscapeDataString(ihmCompletionFilter!)}";
    var returnUrl = ViewBag.ReturnUrl?.ToString();
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = $"/SurveyJobs/SurveyAreas?jobId={jobId}{ihmFilterQuery}";
    }
    var layoutOptionsJson = Newtonsoft.Json.JsonConvert.SerializeObject(layouts.Select(layout => new
    {
        target = layout.Target,
        originalFileName = layout.OriginalFileName,
        filePath = layout.FilePath,
        isCommon = string.Equals(layout.Target, "common", StringComparison.OrdinalIgnoreCase)
    }));

    string Val(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string AuditStatusValue(string? value)
    {
        var normalized = (value ?? "").Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "").Replace("-", "");
        return normalized switch
        {
            "inprogress" or "2" => "Pending",
            "done" or "3" or "completed" or "audited" => "Done",
            _ => "Pending"
        };
    }
    int SampleOrder(string? value)
    {
        var text = (value ?? "").Trim();
        var digits = new string(text.Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var number) ? number : int.MaxValue;
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.AreaName Checkpoints</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef4fb;
            color: #102033;
            font-family: "Segoe UI",Arial,sans-serif;
        }

        /* HEADER */

        .appbar {
            height: 62px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 18px;
            background: #f5f8fd;
            border-bottom: 1px solid #d8e3ee;
        }

        .logout-link {
            margin-left: auto;
            color: #d63b4b;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .back-btn {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            color: #102033;
            text-decoration: none;
            font-size: 20px;
        }

        .title {
            margin: 0;
            font-size: 20px;
            font-weight: 900;
        }

        .sub {
            margin: 2px 0 0;
            font-size: 13px;
            color: #607d9a;
        }


        /* PAGE */

        .page {
            max-width: 1320px; /* reduced */

            margin: auto;
            padding: 18px;
        }

        .section-title {
            margin: 0 0 18px;
            color: #607d9a;
            font-size: 14px;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 900;
        }


        /* RESPONSIVE GRID */

        .grid {
            display: grid;
            gap: 14px;
            /* default maximum = 4 cards */
            grid-template-columns: repeat(3,minmax(0,1fr));
        }


        /* CARD */

        .cp-card {
            background: #fff;
            border: 1px solid #ffe0e0;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 2px 10px rgba(255,120,120,.05);
            text-decoration: none;
            color: inherit;
            display: block;
            cursor: pointer;
        }

            .cp-card:hover {
                color: inherit;
                text-decoration: none;
                transform: translateY(-1px);
            }


        /* TOP */

        .cp-head {
            background: #fff3f3;
            min-height: 72px;
            padding: 16px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .cp-left {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }


        /* BADGE */

        .type-badge {
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 900;
            display: flex;
            gap: 6px;
            align-items: center;
            white-space: nowrap;
        }

        /* Sample / visual number entered manually (S01, V01, ...) */
        .sample-no-btn {
            border: 1px dashed transparent;
            background: transparent;
            border-radius: 8px;
            padding: 3px 6px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-width: 0;
            cursor: pointer;
            color: inherit;
            font: inherit;
        }

        .sample-no-btn:hover {
            border-color: #9fb3c8;
            background: #f5f8fd;
        }

        .sample-no-btn .cp-title.empty {
            color: #8aa0b6;
            font-weight: 700;
        }

        .sample-no-btn i {
            color: #607d9a;
            font-size: 12px;
        }

        .sample-no-panel {
            width: min(100%, 380px);
        }

        .sample-no-input {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #c5d3e0;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sample-no-error {
            color: #d6336c;
            font-size: 12px;
            margin-top: 8px;
            min-height: 16px;
        }

        .sample-no-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 12px 16px;
            border-top: 1px solid #d8e3ee;
        }

        .sample-no-actions button {
            border-radius: 10px;
            padding: 8px 14px;
            font-weight: 800;
            cursor: pointer;
        }

        .sample-no-cancel {
            border: 1px solid #c5d3e0;
            background: #fff;
            color: #374e64;
        }

        .sample-no-save {
            border: 0;
            background: #0b7285;
            color: #fff;
        }

        .sample-no-save:disabled {
            opacity: .6;
            cursor: wait;
        }

        .undecided {
            background: #eef1f5;
            color: #6b7c8f;
        }

        /* Compact [S | V] choice for checkpoints left blank in the Excel */
        .procedure-choice {
            display: inline-flex;
            border-radius: 8px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .procedure-choice button {
            width: 32px;
            height: 26px;
            border: 1px solid;
            font-size: 12px;
            font-weight: 900;
            cursor: pointer;
            padding: 0;
        }

        .procedure-choice button + button {
            border-left: 0;
        }

        .procedure-choice .choice-s {
            background: #fff0f1;
            color: #ff5d65;
            border-color: #ff9aa0;
            border-radius: 8px 0 0 8px;
        }

        .procedure-choice .choice-v {
            background: #eef7ff;
            color: #1e95ff;
            border-color: #8cc8ff;
            border-radius: 0 8px 8px 0;
        }

        .procedure-choice button:hover {
            filter: brightness(.96);
        }

        .procedure-choice button:disabled {
            opacity: .6;
            cursor: wait;
        }

        /* Sample / Visual / Not decided counts */
        .type-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: -4px 0 14px;
        }

        .type-summary span {
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .procedure-toggle {
            border: 1px solid #0b7285;
            background: #fff;
            color: #0b7285;
            border-radius: 999px;
            padding: 4px 9px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
        }

        .procedure-toggle:hover {
            background: #e6fcf5;
        }

        .procedure-toggle:disabled {
            opacity: .6;
            cursor: wait;
        }

        .sample {
            background: #ffd9dd;
            color: #ff5d65;
        }

        .visual {
            background: #e2f1ff;
            color: #1e95ff;
        }

        .normal {
            background: #edf3f8;
            color: #607d9a;
        }


        /* TITLE */

        .cp-title {
            margin: 0;
            font-size: 15px;
            font-weight: 900;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .edit-btn {
            color: #607d9a;
            font-size: 18px;
            text-decoration: none;
        }


        /* BODY */

        .cp-body {
            padding: 16px 18px;
        }

        .info-row {
            display: grid;
            grid-template-columns: 95px 1fr;
            gap: 10px;
            margin-bottom: 10px;
            align-items: start;
        }

        .info-label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #607d9a;
            font-size: 13px;
            font-weight: 600;
        }

            .info-label i {
                width: 14px;
                font-size: 13px;
            }

        .info-value {
            font-size: 13px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .mark-layout-btn {
            margin-top: 10px;
            width: 100%;
            border: 1px solid #1e95ff;
            background: #eef7ff;
            color: #1e95ff;
            border-radius: 10px;
            padding: 9px 12px;
            font-size: 12px;
            font-weight: 900;
        }

        .marker-modal {
            position: fixed;
            inset: 0;
            background: rgba(10, 25, 45, .72);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 16px;
        }

        .marker-panel {
            width: min(100%, 980px);
            max-height: 92vh;
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .marker-head {
            padding: 12px 16px;
            border-bottom: 1px solid #d8e3ee;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .marker-title {
            margin: 0;
            font-size: 15px;
            font-weight: 900;
        }

        .marker-close {
            border: 0;
            background: transparent;
            font-size: 22px;
            line-height: 1;
        }

        .marker-body {
            padding: 14px;
            overflow: auto;
        }

        .marker-image-wrap {
            width: 100%;
            max-height: 70vh;
            overflow: auto;
            border: 1px solid #d8e3ee;
            border-radius: 12px;
            background: #f5f8fd;
        }

        .marker-stage {
            position: relative;
            display: inline-block;
            line-height: 0;
        }

        .marker-image {
            display: block;
            width: 100%;
            max-width: 100%;
            height: auto;
            object-fit: contain;
        }

        .marker-pins {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9;
        }

        .marker-pin {
            position: absolute;
            transform: translate(-50%, -100%);
            color: #ff4d4f;
            filter: drop-shadow(0 2px 3px rgba(0,0,0,.35));
            pointer-events: auto;
            text-align: center;
            cursor: pointer;
        }

            .marker-pin.active {
                color: #1e95ff;
            }

            .marker-pin .pin-label {
                display: block;
                min-width: 34px;
                max-width: 74px;
                margin: 0 auto -3px;
                padding: 3px 7px;
                border: 2px solid #fff;
                border-radius: 999px;
                background: currentColor;
                color: #fff;
                font-size: 11px;
                font-weight: 900;
                line-height: 1.2;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .marker-pin i {
                font-size: 30px;
            }

        .marker-toolbar {
            display: none;
            gap: 10px;
            margin-bottom: 12px;
        }

            .marker-toolbar select {
                width: 100%;
                border: 1px solid #d8e3ee;
                border-radius: 10px;
                padding: 9px 12px;
                font-size: 13px;
                font-weight: 700;
            }

        .marker-foot {
            padding: 12px 16px;
            border-top: 1px solid #d8e3ee;
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: center;
            color: #607d9a;
            font-size: 12px;
            font-weight: 700;
        }

        .marker-save {
            border: 0;
            background: #20c997;
            color: white;
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 12px;
            font-weight: 900;
        }

            .marker-save:disabled {
                opacity: .55;
            }
        /* STATUS */

        .status-box {
            margin-top: 12px;
            border: 1px solid #ccd7e4;
            background: #f4f7fa;
            border-radius: 12px;
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 800;
        }

        .status-left {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .result-text {
            color: #607d9a;
        }

        .audit-status-form {
            margin: 0;
            min-width: 145px;
        }

        .audit-status-select {
            width: 100%;
            min-height: 32px;
            border: 1px solid #c4d3e4;
            border-radius: 9px;
            background: #ffffff;
            color: #4d6d8d;
            font-size: 12px;
            font-weight: 800;
            padding: 4px 28px 4px 9px;
            cursor: pointer;
        }

        .audit-status-select:focus {
            border-color: #3d7eea;
            box-shadow: 0 0 0 3px rgba(61, 126, 234, .15);
            outline: none;
        }


        /* BREAKPOINTS */

        @@media (max-width:1200px) {
            .grid {
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media (max-width:900px) {
            .grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width:620px) {
            .page {
                padding: 14px;
            }

            .grid {
                grid-template-columns: 1fr;
            }



            .cp-head {
                padding: 14px;
                min-height: 64px;
            }

            .cp-body {
                padding: 14px;
            }

            .title {
                font-size: 18px;
            }

            .cp-title {
                font-size: 14px;
            }
        }

        @@media (max-width:420px) {
            .info-row {
                grid-template-columns: 1fr;
                gap: 3px;
            }

            .status-box {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>
    <header class="appbar">
        <a class="back-btn" href="/SurveyJobs/SurveyAreas?jobId=@jobId@(string.IsNullOrWhiteSpace(ihmCompletionFilter) ? "" : $"&ihmCompletionFilter={Uri.EscapeDataString(ihmCompletionFilter)}")">
            <i class="fa-solid fa-chevron-left"></i>
        </a>
        <div>
            <h1 class="title">@Model.AreaName</h1>
            <p class="sub">@(Model.Checkpoints?.Count ?? 0) checkpoints</p>
        </div>
        <a class="logout-link" href="@Url.Action("Logout", "Home")">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            <span>Sign Out</span>
        </a>
    </header>

    <main class="page">
        <h2 class="section-title">Checkpoints</h2>
        @{
            var allCheckpoints = Model.Checkpoints ?? new List<Survery_Certification_App_Consume.Models.IhmCheckpointOptionDto>();
            var sampleCount = allCheckpoints.Count(x => x.IsSample && !x.IsVisual);
            var visualCount = allCheckpoints.Count(x => x.IsVisual);
            var undecidedCount = allCheckpoints.Count(x => !x.IsSample && !x.IsVisual);
        }
        <div class="type-summary">
            <span class="sample"><i class="fa-solid fa-flask"></i>Sample @sampleCount</span>
            <span class="visual"><i class="fa-solid fa-eye"></i>Visual @visualCount</span>
            @if (undecidedCount > 0)
            {
                <span class="undecided"><i class="fa-solid fa-circle-question"></i>Not decided @undecidedCount</span>
            }
        </div>

        <div class="grid">
            @* Keep the order from the API, which is the uploaded Excel row order.
               Do not group Sample above Visual, and do not sort by number. *@
            @foreach (var checkpoint in (Model.Checkpoints ?? new List<Survery_Certification_App_Consume.Models.IhmCheckpointOptionDto>()))
            {
                var isVisual = checkpoint.IsVisual;
                var isSample = checkpoint.IsSample;

                var isUndecided = !isVisual && !isSample;
                var typeClass = isVisual ? "visual" : isSample ? "sample" : "undecided";
                var typeText = isVisual ? "Visual" : isSample ? "Sample" : "Not decided";
                var icon = isVisual ? "fa-eye" : isSample ? "fa-flask" : "fa-circle-question";

                var code = Val(checkpoint.SampleNo ?? checkpoint.Location);
                var surveyStatus = checkpoint.IsAudited ? "Surveyed" : "Not surveyed yet";
                var auditStatus = AuditStatusValue(checkpoint.AuditStatus);

                <article class="cp-card" onclick="window.location.href='/SurveyJobs/CheckpointDetail?jobId=@jobId&areaId=@Model.Id&checkpointId=@checkpoint.Id'">
                    <div class="cp-head">
                        <div class="cp-left">
                            <span class="type-badge @typeClass">
                                <i class="fa-solid @icon"></i>
                                @typeText
                            </span>
                            @{
                                var sampleNo = (checkpoint.SampleNo ?? string.Empty).Trim();
                                var hasNumber = System.Text.RegularExpressions.Regex.IsMatch(sampleNo, "^[SsVv]\\d+$");
                                var numberPrefix = isVisual ? "V" : isSample ? "S" : "";
                            }
                            <button type="button"
                                    class="sample-no-btn"
                                    title="Enter sample / visual number"
                                    data-checkpoint-id="@checkpoint.Id"
                                    data-sample-no="@sampleNo"
                                    data-prefix="@numberPrefix"
                                    data-undecided="@(isUndecided ? "1" : "0")"
                                    onclick="openSampleNoModal(event, this)">
                                <h2 class="cp-title @(hasNumber ? "" : "empty")">@(hasNumber ? sampleNo.ToUpperInvariant() : (isUndecided ? "Enter no." : $"{numberPrefix} · Enter no."))</h2>
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            @if (isVisual || isSample)
                            {
                                <button type="button"
                                        class="procedure-toggle"
                                        data-checkpoint-id="@checkpoint.Id"
                                        data-procedure="@(isVisual ? "V" : "S")"
                                        onclick="toggleCheckpointProcedure(event, this)">
                                    Change to @(isVisual ? "S" : "V")
                                </button>
                            }
                            else
                            {
                                <span class="procedure-choice" onclick="event.stopPropagation()">
                                    <button type="button" class="choice-s" title="Set as Sample"
                                            data-checkpoint-id="@checkpoint.Id"
                                            onclick="setCheckpointProcedure(event, this, 'sample')">S</button>
                                    <button type="button" class="choice-v" title="Set as Visual"
                                            data-checkpoint-id="@checkpoint.Id"
                                            onclick="setCheckpointProcedure(event, this, 'visual')">V</button>
                                </span>
                            }
                        </div>

                        @* <a class="edit-btn"
                           href="/SurveyJobs/EditCheckpoint?jobId=@jobId&checkpointId=@checkpoint.Id">
                            <i class="fa-solid fa-pencil"></i>
                        </a> *@
                    </div>

                    <div class="cp-body">
                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-location-dot"></i>
                                Location
                            </div>
                            <div class="info-value">@Val(checkpoint.Location)</div>
                        </div>

                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-gear"></i>
                                Equipment
                            </div>
                            <div class="info-value">@Val(checkpoint.EquipmentName)</div>
                        </div>

                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-shapes"></i>
                                Component
                            </div>
                            <div class="info-value">@Val(checkpoint.Component)</div>
                        </div>

                        <div class="info-row">
                            <div class="info-label">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Hazardous material
                            </div>
                            <div class="info-value">@Val(checkpoint.HazardousMaterial)</div>
                        </div>
                        <div class="status-box">
                            <div class="status-left">
                                <i class="fa-solid fa-user-check"></i>
                                @surveyStatus
                            </div>
                            <form class="audit-status-form" method="post" action="/SurveyJobs/SaveCheckpointAudit" onclick="event.stopPropagation();">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="JobId" value="@jobId" />
                                <input type="hidden" name="AreaId" value="@Model.Id" />
                                <input type="hidden" name="CheckpointId" value="@checkpoint.Id" />
                                <input type="hidden" name="SampleNo" value="@checkpoint.SampleNo" />
                                <input type="hidden" name="Description" value="@checkpoint.Description" />
                                <input type="hidden" name="TableType" value="@checkpoint.TableType" />
                                <input type="hidden" name="Location" value="@checkpoint.Location" />
                                <input type="hidden" name="EquipmentName" value="@checkpoint.EquipmentName" />
                                <input type="hidden" name="Component" value="@checkpoint.Component" />
                                <input type="hidden" name="MaterialCategory" value="@checkpoint.MaterialCategory" />
                                <input type="hidden" name="HazardousMaterial" value="@checkpoint.HazardousMaterial" />
                                <input type="hidden" name="QuantityUnitKg" value="@checkpoint.QuantityUnitKg" />
                                <input type="hidden" name="QuantityNo" value="@checkpoint.QuantityNo" />
                                <input type="hidden" name="QuantityTotalKg" value="@checkpoint.QuantityTotalKg" />
                                <input type="hidden" name="ManufacturerBrandName" value="@checkpoint.ManufacturerBrandName" />
                                <input type="hidden" name="DocumentAnalysisResult" value="@checkpoint.DocumentAnalysisResult" />
                                <input type="hidden" name="SamplingCheck" value="@checkpoint.SamplingCheck" />
                                <input type="hidden" name="VisualCheck" value="@checkpoint.VisualCheck" />
                                <input type="hidden" name="CheckResult" value="@checkpoint.CheckResult" />
                                <input type="hidden" name="IsPchm" value="@(checkpoint.IsPchm ? "true" : "false")" />
                                <input type="hidden" name="Remarks" value="@checkpoint.Remarks" />
                                <input type="hidden" name="LocationRemarks" value="@checkpoint.LocationRemarks" />
                                <input type="hidden" name="ReturnToAreaList" value="true" />
                                <select name="AuditStatus" class="audit-status-select" aria-label="Audit Result" onchange="event.stopPropagation(); this.form.submit();">
                                    <option value="Pending" selected="@(auditStatus == "Pending")">Pending</option>
                                    
                                    <option value="Done" selected="@(auditStatus == "Done")">Done</option>
                                </select>
                            </form>
                        </div>

                    </div>
                </article>
            }
        </div>
    </main>
    <div id="sampleNoModal" class="marker-modal" onclick="if (event.target === this) closeSampleNoModal()">
        <div class="marker-panel sample-no-panel">
            <div class="marker-head">
                <h3 id="sampleNoTitle" class="marker-title">Sample / Visual Number</h3>
                <button type="button" class="marker-close" onclick="closeSampleNoModal()">×</button>
            </div>
            <div class="marker-body">
                <input id="sampleNoInput" class="sample-no-input" type="text" maxlength="20" autocomplete="off"
                       placeholder="S01"
                       onkeydown="if (event.key === 'Enter') saveSampleNo(); if (event.key === 'Escape') closeSampleNoModal();" />
                <div id="sampleNoError" class="sample-no-error"></div>
            </div>
            <div class="sample-no-actions">
                <button type="button" class="sample-no-cancel" onclick="closeSampleNoModal()">Cancel</button>
                <button id="sampleNoSaveBtn" type="button" class="sample-no-save" onclick="saveSampleNo()">Save</button>
            </div>
        </div>
    </div>
    <div id="markerModal" class="marker-modal">
        <div class="marker-panel">
            <div class="marker-head">
                <h3 id="markerTitle" class="marker-title">Mark Layout</h3>
                <button type="button" class="marker-close" onclick="closeMarkerModal()">×</button>
            </div>

            <div class="marker-body">
                <div id="markerToolbar" class="marker-toolbar">
                    <select id="layoutSelect" onchange="changeLayoutImage(this.value)"></select>
                </div>
                <div id="markerImageWrap" class="marker-image-wrap">
                    <div id="markerStage" class="marker-stage">
                        <img id="markerImage" class="marker-image" src="" alt="Layout" />
                        <div id="markerPins" class="marker-pins"></div>
                    </div>
                </div>
            </div>

            <div class="marker-foot">
                <span id="markerHint">Click on the layout image to place marker.</span>
                <button id="markerSaveBtn" type="button" class="marker-save" onclick="saveMarker()" disabled>
                    Save Marker
                </button>
            </div>
        </div>
    </div>
    <script>
        const layoutOptions = @Html.Raw(layoutOptionsJson);
        const apiRoot = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(apiRoot));
        let loadedMarkers = [];
                let markerClickTimer = null;
                let lastMarkerTapTime = 0;
        const MARKER_CLICK_DELAY = 260;
                let markerState = {
            jobId: 0,
            areaId: 0,
            checkpointId: 0,
            imagePath: "",
            label: "",
            xPercent: null,
            yPercent: null
        };

        function normalizeImageUrl(path) {
            if (!path) return "";
            if (path.startsWith("http")) return path;
            return path.startsWith("/") ? path : "/" + path;
        }

                function normalizeMarkerPath(path) {
            let value = String(path || "").trim();

            if (!value) return "";

            try {
                const url = new URL(value, window.location.origin);
                value = url.pathname;
            } catch {
                value = value.replace(/^https?:\/\/[^/]+/i, "");
            }

            return value
                .replace(/\\/g, "/")
                .replace(/^\/+/, "")
                .toLowerCase();
        }

        function samePath(left, right) {
            return normalizeMarkerPath(left) === normalizeMarkerPath(right);
        }

                function markerValue(marker, camelName, pascalName) {
            return marker[camelName] ?? marker[pascalName];
        }
                function markerValueAny(marker, names) {
            for (const name of names) {
                if (marker && marker[name] !== undefined && marker[name] !== null) {
                    return marker[name];
                }
            }

            return null;
        }

                function markerX(marker) {
            return markerValueAny(marker, [
                "xPercent", "XPercent",
                "xpercent",
                "normalizedX", "NormalizedX",
                "normalizedx",
                "xPercentValue", "XPercentValue"
            ]);
        }

        function markerY(marker) {
            return markerValueAny(marker, [
                "yPercent", "YPercent",
                "ypercent",
                "normalizedY", "NormalizedY",
                "normalizedy",
                "yPercentValue", "YPercentValue"
            ]);
        }
                function markerIdValue(marker) {
            return Number(markerValueAny(marker, [
                "id", "Id",
                "markerId", "MarkerId",
                "localId", "LocalId"
            ]) || 0);
        }

        function normalizeMarkerForState(marker) {
            return {
                id: markerIdValue(marker),
                Id: markerIdValue(marker),
                surveyJobId: Number(markerValue(marker, "surveyJobId", "SurveyJobId") || markerState.jobId),
                SurveyJobId: Number(markerValue(marker, "surveyJobId", "SurveyJobId") || markerState.jobId),
                ihmAreaId: Number(markerValue(marker, "ihmAreaId", "IhmAreaId") || markerState.areaId),
                IhmAreaId: Number(markerValue(marker, "ihmAreaId", "IhmAreaId") || markerState.areaId),
                ihmCheckpointId: Number(markerValue(marker, "ihmCheckpointId", "IhmCheckpointId") || markerState.checkpointId),
                IhmCheckpointId: Number(markerValue(marker, "ihmCheckpointId", "IhmCheckpointId") || markerState.checkpointId),
                imagePath: markerValue(marker, "imagePath", "ImagePath") || markerState.imagePath,
                ImagePath: markerValue(marker, "imagePath", "ImagePath") || markerState.imagePath,
                xPercent: markerX(marker),
                XPercent: markerX(marker),
                yPercent: markerY(marker),
                YPercent: markerY(marker),
                markerLabel: markerLabelText(marker, markerState.label),
                MarkerLabel: markerLabelText(marker, markerState.label)
            };
        }
        function markerLabelText(marker, fallback) {
            return markerValueAny(marker, [
                "markerLabel", "MarkerLabel",
                "checkpointCode", "CheckpointCode",
                "sampleCode", "SampleCode",
                "visualCode", "VisualCode",
                "sampleNo", "SampleNo"
            ]) || fallback || "";
        }
                function percentToUnit(value) {
            const number = Number(value);
            if (!Number.isFinite(number)) return null;

            if (number < 0 || number > 1) {
                console.warn("Invalid marker coordinate", value);
                return null;
            }

            return number;
        }
        function syncMarkerOverlaySize() {
            const img = document.getElementById("markerImage");
            const stage = document.getElementById("markerStage");
            const layer = document.getElementById("markerPins");

            if (!img || !stage || !layer || !img.complete || !img.naturalWidth || !img.naturalHeight) {
                return false;
            }

            const imageWidth = img.clientWidth || img.getBoundingClientRect().width;
            const imageHeight = img.clientHeight || img.getBoundingClientRect().height;

            if (!imageWidth || !imageHeight) {
                return false;
            }

            stage.style.width = `${imageWidth}px`;
            stage.style.height = `${imageHeight}px`;

            layer.style.width = `${imageWidth}px`;
            layer.style.height = `${imageHeight}px`;

            return true;
        }
                function populateLayoutSelect() {
            const toolbar = document.getElementById("markerToolbar");
            const select = document.getElementById("layoutSelect");
            select.innerHTML = "";

            if (!layoutOptions.length) {
                toolbar.style.display = "none";
                return;
            }

            layoutOptions.forEach(layout => {
                const option = document.createElement("option");
                option.value = layout.filePath || "";
                option.textContent = `${layout.isCommon ? "Common" : "Area"} - ${layout.originalFileName || layout.filePath}`;
                select.appendChild(option);
            });

            if (markerState.imagePath) {
                select.value = markerState.imagePath;
            }

            toolbar.style.display = layoutOptions.length > 1 ? "flex" : "none";
        }

        async function openMarkerModal(card) {
            markerState = {
                jobId: Number(card.dataset.jobId),
                areaId: Number(card.dataset.areaId),
                checkpointId: Number(card.dataset.checkpointId),
                imagePath: card.dataset.imagePath || (layoutOptions[0]?.filePath ?? ""),
                label: card.dataset.label || "",
                xPercent: null,
                yPercent: null
            };

            if (!markerState.imagePath) {
                alert("Layout image not uploaded for this area.");
                return;
            }

            document.getElementById("markerTitle").innerText =
                "Mark Layout - " + markerState.label;

                    const markerImage = document.getElementById("markerImage");
        markerImage.onload = function () {
            syncMarkerOverlaySize();
            renderMarkers();
        };
        markerImage.src = normalizeImageUrl(markerState.imagePath);

                    document.getElementById("markerPins").innerHTML = "";
            document.getElementById("markerSaveBtn").disabled = true;
            document.getElementById("markerSaveBtn").innerText = "Save Marker";
            document.getElementById("markerModal").style.display = "flex";
            populateLayoutSelect();

            await loadExistingMarkers();
        }

        function closeMarkerModal() {
            document.getElementById("markerModal").style.display = "none";
        }

        async function changeLayoutImage(imagePath) {
            markerState.imagePath = imagePath;
            markerState.xPercent = null;
            markerState.yPercent = null;
                   const markerImage = document.getElementById("markerImage");
        markerImage.onload = function () {
            syncMarkerOverlaySize();
            renderMarkers();
        };
        markerImage.src = normalizeImageUrl(markerState.imagePath);
                    document.getElementById("markerSaveBtn").disabled = true;
            document.getElementById("markerSaveBtn").innerText = "Save Marker";
            await loadExistingMarkers();
        }

                function setSelectedPin(xPercent, yPercent) {
            markerState.xPercent = xPercent;
            markerState.yPercent = yPercent;
            renderMarkers();

            const saveBtn = document.getElementById("markerSaveBtn");
            saveBtn.disabled = false;
            saveBtn.innerText = "Save Marker";
        }

                function renderMarkers() {
            const container = document.getElementById("markerPins");
            container.innerHTML = "";

            const hasUnsavedSelectedPin = markerState.xPercent !== null && markerState.yPercent !== null;
                  const visibleMarkers = loadedMarkers.filter(marker => {
            const checkpointId = Number(markerValue(marker, "ihmCheckpointId", "IhmCheckpointId"));

            return samePath(markerValue(marker, "imagePath", "ImagePath"), markerState.imagePath) &&
                !(hasUnsavedSelectedPin && checkpointId === markerState.checkpointId);
        });
                    console.log("Visible layout markers", visibleMarkers.map(marker => ({
            id: markerValue(marker, "id", "Id"),
            checkpointId: markerValue(marker, "ihmCheckpointId", "IhmCheckpointId"),
            imagePath: markerValue(marker, "imagePath", "ImagePath"),
            normalizedPath: normalizeMarkerPath(markerValue(marker, "imagePath", "ImagePath")),
            currentPath: normalizeMarkerPath(markerState.imagePath),
            x: markerX(marker),
            y: markerY(marker),
            label: markerLabelText(marker)
        })));

                    visibleMarkers.forEach(marker => {
                const checkpointId = Number(markerValue(marker, "ihmCheckpointId", "IhmCheckpointId"));
                const isActive = checkpointId === markerState.checkpointId;
                        const rawX = markerX(marker);
        const rawY = markerY(marker);

        if (rawX === null || rawX === undefined || rawX === "" || rawY === null || rawY === undefined || rawY === "") {
            console.warn("Skipped marker without xPercent/yPercent", marker);
            return;
        }

        const x = Number(rawX);
        const y = Number(rawY);

        if (!Number.isFinite(x) || !Number.isFinite(y)) {
            console.warn("Skipped marker with invalid coordinate", marker);
            return;
        }
                const label = markerLabelText(marker, isActive ? markerState.label : "");
                addMarkerPin(x, y, label, isActive, markerIdValue(marker));
            });


                    if (hasUnsavedSelectedPin) {
                addMarkerPin(markerState.xPercent, markerState.yPercent, markerState.label, true, 0);
            }
        }

                function addMarkerPin(xPercent, yPercent, label, isActive, markerId) {
            const img = document.getElementById("markerImage");
            const layerReady = syncMarkerOverlaySize();
            if (!layerReady) return;

            const xUnit = percentToUnit(xPercent);
            const yUnit = percentToUnit(yPercent);

                    if (xUnit === null || yUnit === null) {
            console.warn("Skipping marker with invalid/raw pixel coordinate", {
                xPercent,
                yPercent,
                label,
                markerId
            });
            return;
        }

            const imageWidth = img.clientWidth || img.getBoundingClientRect().width;
            const imageHeight = img.clientHeight || img.getBoundingClientRect().height;

            const markerLeft = xUnit * imageWidth;
            const markerTop = yUnit * imageHeight;

            console.log("Rendered marker position", {
                markerId,
                label,
                xPercent,
                yPercent,
                xUnit,
                yUnit,
                renderedImageWidth: imageWidth,
                renderedImageHeight: imageHeight,
                naturalWidth: img.naturalWidth,
                naturalHeight: img.naturalHeight,
                markerLeft,
                markerTop
            });

            const pin = document.createElement("div");
            pin.className = `marker-pin${isActive ? " active" : ""}`;
            pin.style.left = `${markerLeft}px`;
            pin.style.top = `${markerTop}px`;
            pin.title = isActive ? "Selected checkpoint" : "Marked checkpoint";
            pin.dataset.markerId = markerId || "";
            pin.innerHTML = `<span class="pin-label">${escapeHtml(label || "-")}</span><i class="fa-solid fa-location-dot"></i>`;
            function removeThisMarker(event) {
            event.preventDefault();
            event.stopPropagation();

            if (markerClickTimer) {
                clearTimeout(markerClickTimer);
                markerClickTimer = null;
            }

            const id = Number(pin.dataset.markerId || 0);

            if (!id) {
                alert("Please save this marker before removing it.");
                return;
            }

            const ok = window.confirm("Are you sure you want to remove this marker?");
            if (ok) {
                deleteMarker(id, false);
            }
        }

        pin.addEventListener("dblclick", removeThisMarker);

        pin.addEventListener("touchend", function (event) {
            const now = Date.now();

            if (now - lastMarkerTapTime < 400) {
                removeThisMarker(event);
            }

            lastMarkerTapTime = now;
        });

            document.getElementById("markerPins").appendChild(pin);
        }

                function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value ?? "";
            return div.innerHTML;
        }

        // ---- Sample / visual number entered manually (S01, V01, ...) ----
        let sampleNoButton = null;

        function openSampleNoModal(event, button) {
            event.preventDefault();
            event.stopPropagation();
            sampleNoButton = button;

            const prefix = String(button.dataset.prefix || "").toUpperCase();
            const current = String(button.dataset.sampleNo || "").trim().toUpperCase();
            const hasNumber = /^[SV]\d+$/.test(current);

            document.getElementById("sampleNoTitle").innerText =
                prefix === "V" ? "Visual Number" : prefix === "S" ? "Sample Number" : "Sample / Visual Number";
            const input = document.getElementById("sampleNoInput");
            input.value = hasNumber ? current : prefix;
            input.placeholder = `${prefix || "S"}01`;
            document.getElementById("sampleNoError").innerText = "";
            document.getElementById("sampleNoSaveBtn").disabled = false;
            document.getElementById("sampleNoModal").style.display = "flex";
            setTimeout(() => {
                input.focus();
                input.setSelectionRange(input.value.length, input.value.length);
            }, 0);
        }

        function closeSampleNoModal() {
            document.getElementById("sampleNoModal").style.display = "none";
            sampleNoButton = null;
        }

        async function saveSampleNo(allowDuplicate = false) {
            if (!sampleNoButton) return;
            const button = sampleNoButton;
            const checkpointId = Number(button.dataset.checkpointId || 0);
            const prefix = String(button.dataset.prefix || "").toUpperCase();
            const errorBox = document.getElementById("sampleNoError");
            const saveBtn = document.getElementById("sampleNoSaveBtn");
            const value = document.getElementById("sampleNoInput").value.trim().toUpperCase();

            if (!/^[SV]\d+$/.test(value)) {
                errorBox.innerText = `Enter S or V followed by a number, e.g. ${prefix || "S"}01`;
                return;
            }
            if (prefix && !value.startsWith(prefix)) {
                errorBox.innerText = prefix === "S"
                    ? 'This is a Sample checkpoint, so the number must start with S. Use "Change to V" first to make it Visual.'
                    : 'This is a Visual checkpoint, so the number must start with V. Use "Change to S" first to make it Sample.';
                return;
            }

            errorBox.innerText = "";
            saveBtn.disabled = true;
            try {
                const response = await fetch(`${apiRoot}/api/ihm-survey/checkpoints/${checkpointId}/sample-no`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json", "Accept": "application/json" },
                    body: JSON.stringify({ sampleNo: value, allowDuplicate })
                });

                if (response.status === 409) {
                    saveBtn.disabled = false;
                    if (confirm(`${value} is already used by another checkpoint in this job. Save it anyway?`)) {
                        await saveSampleNo(true);
                    }
                    return;
                }

                if (!response.ok) {
                    let message = "";
                    try {
                        const data = await response.json();
                        message = data?.message || data?.Message || "";
                    } catch {
                        message = await response.text().catch(() => "");
                    }
                    throw new Error(message || `HTTP ${response.status}`);
                }

                // Not decided: the letter typed set Sample / Visual, so refresh
                // the card badge. Cards keep the Excel order, so it stays put.
                if (button.dataset.undecided === "1") {
                    window.location.reload();
                    return;
                }

                // Update the card in place so it keeps its position.
                button.dataset.sampleNo = value;
                const title = button.querySelector(".cp-title");
                title.innerText = value;
                title.classList.remove("empty");
                closeSampleNoModal();
            } catch (error) {
                console.error("Failed to save sample number", error);
                errorBox.innerText = error?.message || "Unable to save the number. Please try again.";
                saveBtn.disabled = false;
            }
        }

        // Sets Sample / Visual on a checkpoint left blank in the Excel.
        async function setCheckpointProcedure(event, button, procedureType) {
            event.preventDefault();
            event.stopPropagation();

            const checkpointId = Number(button.dataset.checkpointId || 0);
            if (!checkpointId) return;

            const group = button.closest(".procedure-choice");
            group?.querySelectorAll("button").forEach(b => b.disabled = true);

            try {
                const response = await fetch(`${apiRoot}/api/ihm-survey/checkpoints/${checkpointId}/procedure`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json", "Accept": "application/json" },
                    body: JSON.stringify({ procedureType })
                });
                if (!response.ok) {
                    throw new Error(await response.text() || `HTTP ${response.status}`);
                }
                // Cards keep the Excel order, so a reload does not move the card.
                window.location.reload();
            } catch (error) {
                console.error("Failed to set checkpoint procedure", error);
                group?.querySelectorAll("button").forEach(b => b.disabled = false);
                alert("Unable to update this checkpoint. Please try again.");
            }
        }

        async function toggleCheckpointProcedure(event, button) {
            event.preventDefault();
            event.stopPropagation();

            const checkpointId = Number(button.dataset.checkpointId || 0);
            const current = String(button.dataset.procedure || "").toUpperCase();
            const next = current === "V" ? "sample" : "visual";

            if (!checkpointId) {
                alert("Checkpoint id is missing.");
                return;
            }

            const originalText = button.innerText;
            button.disabled = true;
            button.innerText = "Updating...";

            try {
                const response = await fetch(`${apiRoot}/api/ihm-survey/checkpoints/${checkpointId}/procedure`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({ procedureType: next })
                });

                if (!response.ok) {
                    const message = await response.text();
                    throw new Error(message || `HTTP ${response.status}`);
                }

                // The server recalculates the ordered S/V number and marker label.
                // Reload the card list so the type, number and status are all current.
                window.location.reload();
            } catch (error) {
                console.error("Failed to change checkpoint procedure", error);
                button.disabled = false;
                button.innerText = originalText;
                alert("Unable to change this checkpoint. Please try again.");
            }
        }

        async function loadExistingMarkers() {
            try {
                const response = await fetch(`/SurveyJobs/GetIhmMarkers?jobId=${markerState.jobId}`);
                if (!response.ok) return;

                loadedMarkers = await response.json();
                        console.log("IHM markers API response", loadedMarkers);
        console.log("Current layout path", markerState.imagePath, normalizeMarkerPath(markerState.imagePath));

                        const existing = loadedMarkers.find(marker =>
                    Number(markerValue(marker, "ihmCheckpointId", "IhmCheckpointId")) === markerState.checkpointId &&
                    samePath(markerValue(marker, "imagePath", "ImagePath"), markerState.imagePath)
                );

                if (existing) {
                    markerState.xPercent = null;
                    markerState.yPercent = null;
                    document.getElementById("markerSaveBtn").disabled = true;
                    document.getElementById("markerHint").innerText =
                        "Existing marker loaded. Click another point to update.";
                } else {
                    markerState.xPercent = null;
                    markerState.yPercent = null;
                    document.getElementById("markerHint").innerText =
                        "Click on the layout image to place marker.";
                }

                renderMarkers();
            } catch {
                document.getElementById("markerHint").innerText =
                    "Click on the layout image to place marker.";
            }
        }
                      document.getElementById("markerStage").addEventListener("click", function (event) {
            if (event.target.closest(".marker-pin")) return;

            if (event.detail > 1) {
                if (markerClickTimer) {
                    clearTimeout(markerClickTimer);
                    markerClickTimer = null;
                }
                return;
            }

            markerClickTimer = setTimeout(function () {
                markerClickTimer = null;

                const img = document.getElementById("markerImage");
                const rect = img.getBoundingClientRect();

                const xPercent = Number(((event.clientX - rect.left) / rect.width).toFixed(6));
                const yPercent = Number(((event.clientY - rect.top) / rect.height).toFixed(6));

                console.log("WEB CLICK COORDINATES", { xPercent, yPercent, rect });

                if (xPercent < 0 || xPercent > 1 || yPercent < 0 || yPercent > 1) {
                    return;
                }

                setSelectedPin(xPercent, yPercent);
            }, MARKER_CLICK_DELAY);
        });


                async function saveMarker() {
            if (markerState.xPercent === null || markerState.yPercent === null) {
                alert("Please click on layout image first.");
                return;
            }

            const saveBtn = document.getElementById("markerSaveBtn");
            saveBtn.disabled = true;
            saveBtn.innerText = "Saving...";
                    if (
            markerState.xPercent < 0 || markerState.xPercent > 1 ||
            markerState.yPercent < 0 || markerState.yPercent > 1
        ) {
            alert("Invalid marker position. Please click inside the layout image again.");
            saveBtn.disabled = false;
            saveBtn.innerText = "Save Marker";
            return;
        }
                  const payload = {
            SurveyJobId: markerState.jobId,
            IhmAreaId: markerState.areaId,
            IhmCheckpointId: markerState.checkpointId,
            ImagePath: markerState.imagePath,
            XPercent: Number(markerState.xPercent.toFixed(6)),
            YPercent: Number(markerState.yPercent.toFixed(6))
        };


            console.log("IHM marker save payload", payload);

            try {
                const response = await fetch("/SurveyJobs/SaveIhmMarker", {
                    method: "POST",
                            headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            surveyJobId: payload.SurveyJobId,
            ihmAreaId: payload.IhmAreaId,
            ihmCheckpointId: payload.IhmCheckpointId,
            imagePath: payload.ImagePath,
            xPercent: payload.XPercent,
            yPercent: payload.YPercent,
            SurveyJobId: payload.SurveyJobId,
            IhmAreaId: payload.IhmAreaId,
            IhmCheckpointId: payload.IhmCheckpointId,
            ImagePath: payload.ImagePath,
            XPercent: payload.XPercent,
            YPercent: payload.YPercent
        })
                });

                const bodyText = await response.text();

                if (!response.ok) {
                    throw new Error(bodyText || "Failed to save marker.");
                }

                const savedMarker = bodyText ? JSON.parse(bodyText) : null;
                console.log("IHM marker save API response", savedMarker);

                if (savedMarker) {
                    const normalizedSaved = normalizeMarkerForState(savedMarker);

                    loadedMarkers = loadedMarkers.filter(marker =>
                        !(
                            Number(markerValue(marker, "ihmCheckpointId", "IhmCheckpointId")) === markerState.checkpointId &&
                            samePath(markerValue(marker, "imagePath", "ImagePath"), markerState.imagePath)
                        )
                    );

                    loadedMarkers.unshift(normalizedSaved);
                    markerState.xPercent = null;
                    markerState.yPercent = null;
                    renderMarkers();
                }

                document.getElementById("markerHint").innerText = "Marker saved.";
                saveBtn.innerText = "Saved";

                await loadExistingMarkers();
            } catch (error) {
                alert(error.message || "Failed to save marker.");
                saveBtn.disabled = false;
                saveBtn.innerText = "Save Marker";
            }
        }

             async function deleteMarker(markerId, askConfirm = true) {
        if (!markerId) return;

        if (askConfirm && !confirm("Are you sure you want to remove this marker?")) {
            return;
        }

        console.log("Deleting IHM marker", { markerId });

            try {
                const response = await fetch(`/SurveyJobs/DeleteIhmMarker?markerId=${markerId}`, {
                    method: "POST"
                });

                const bodyText = await response.text();
                console.log("IHM marker delete API response", {
                    markerId,
                    ok: response.ok,
                    status: response.status,
                    body: bodyText
                });

                if (!response.ok) {
                    throw new Error(bodyText || "Failed to delete marker.");
                }

                markerState.xPercent = null;
                markerState.yPercent = null;
                document.getElementById("markerSaveBtn").disabled = true;
                document.getElementById("markerSaveBtn").innerText = "Save Marker";
                document.getElementById("markerHint").innerText = "Marker removed.";

                await loadExistingMarkers();
            } catch (error) {
                alert(error.message || "Failed to delete marker.");
            }
        }
                window.addEventListener("resize", function () {
            syncMarkerOverlaySize();
            renderMarkers();
        });
    </script>
</body>
</html>
