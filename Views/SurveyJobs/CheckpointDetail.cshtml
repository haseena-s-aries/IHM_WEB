@model Survery_Certification_App_Consume.Models.IhmCheckpointOptionDto
@{
    Layout = null;

    var jobId = (int)(ViewBag.JobId ?? 0);
    var areaId = (int)(ViewBag.AreaId ?? 0);
    var areaName = ViewBag.AreaName?.ToString() ?? "Area";

    string Val(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    var result = Val(Model.Result ?? Model.CheckResult);
    var auditResult = Model.IsAudited ? "Audited" : "Pending";
    var pchmStatus = Model.IsAudited ? "Completed" : "Pending";
    var objectToCheck = $"{Val(Model.EquipmentName)} - {Val(Model.Component)}";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Audit Check Point</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef4fb;
            color: #102033;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .appbar {
            min-height: 64px;
            background: #ffffff;
            border-bottom: 1px solid #d8e3ee;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 18px;
            position: sticky;
            top: 0;
            z-index: 30;
        }

        .back-btn {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #102033;
            text-decoration: none;
            border-radius: 10px;
        }

        .title {
            margin: 0;
            font-size: 16px;
            font-weight: 900;
        }

        .sub {
            margin: 2px 0 0;
            color: #607d9a;
            font-size: 12px;
        }

        .save-btn {
            margin-left: auto;
            border: 0;
            border-radius: 10px;
            background: #20c997;
            color: #ffffff;
            font-size: 12px;
            font-weight: 900;
            padding: 9px 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            background: #ffffff;
            border-bottom: 1px solid #d8e3ee;
            position: sticky;
            top: 64px;
            z-index: 25;
        }

        .tab {
            color: #607d9a;
            text-align: center;
            padding: 12px 6px 10px;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .8px;
            text-decoration: none;
            border-bottom: 3px solid transparent;
        }

            .tab.active {
                color: #00c9a7;
                border-bottom-color: #00c9a7;
            }

            .tab i {
                display: block;
                font-size: 15px;
                margin-bottom: 4px;
            }

        .page {
            width: 100%;
            padding: 18px;
        }

        .section-title {
            margin: 18px 0 10px;
            color: #506c88;
            font-size: 13px;
            font-weight: 900;
            letter-spacing: 1.6px;
            text-transform: uppercase;
        }

        .white-card {
            background: #ffffff;
            border: 1px solid #d6e3f1;
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 12px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 130px 1fr;
            gap: 12px 24px;
            max-width: 720px;
        }

        .info-label {
            color: #506c88;
            font-size: 12px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .info-label i {
                width: 16px;
                text-align: center;
            }

        .info-value {
            color: #102033;
            font-size: 12px;
            font-weight: 900;
        }

        .hazmat-value {
            color: #ff4545;
        }

        .status-banner {
            background: #dfe6f0;
            border: 1px solid #b7c7d9;
            border-radius: 14px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 56px;
        }

        .status-icon {
            color: #506c88;
            font-size: 20px;
        }

        .status-main {
            font-size: 14px;
            font-weight: 900;
            color: #102033;
            line-height: 1.2;
        }

        .status-sub {
            color: #506c88;
            font-size: 12px;
            font-weight: 700;
            margin-top: 2px;
        }

        .form-card {
            background: #ffffff;
            border: 1px solid #d6e3f1;
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 12px;
        }

        .field-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 12px;
            align-items: center;
            margin-bottom: 12px;
        }

            .field-row:last-child {
                margin-bottom: 0;
            }

        .field-label {
            color: #506c88;
            font-size: 12px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .field-label i {
                width: 16px;
                text-align: center;
            }

        .field-value {
            color: #102033;
            font-size: 12px;
            font-weight: 900;
        }

        .select-like {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: #102033;
            font-size: 16px;
            padding: 0;
            appearance: none;
        }

        .select-wrap {
            position: relative;
        }

            .select-wrap::after {
                content: "\f0d7";
                font-family: "Font Awesome 6 Free";
                font-weight: 900;
                position: absolute;
                right: 4px;
                top: 50%;
                transform: translateY(-50%);
                color: #555;
                pointer-events: none;
            }

        .switch-row {
            background: #ffffff;
            border: 1px solid #d6e3f1;
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .flag-icon {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: #edf3f8;
            display: grid;
            place-items: center;
            color: #506c88;
            flex: 0 0 auto;
        }

        .switch-text {
            flex: 1;
        }

        .switch-title {
            font-size: 13px;
            font-weight: 900;
            color: #102033;
        }

        .switch-sub {
            font-size: 12px;
            color: #506c88;
            margin-top: 2px;
        }

        .switch {
            position: relative;
            width: 50px;
            height: 28px;
            flex: 0 0 auto;
        }

            .switch input {
                display: none;
            }

        .slider {
            position: absolute;
            inset: 0;
            background: #d7e0ea;
            border: 2px solid #8193a8;
            border-radius: 999px;
            cursor: pointer;
        }

            .slider::before {
                content: "";
                position: absolute;
                width: 18px;
                height: 18px;
                left: 4px;
                top: 3px;
                background: #506c88;
                border-radius: 50%;
                transition: .2s;
            }

        .switch input:checked + .slider {
            background: #dff7f2;
            border-color: #20c997;
        }

            .switch input:checked + .slider::before {
                transform: translateX(20px);
                background: #20c997;
            }

        .remarks-card {
            background: #ffffff;
            border: 1px solid #d6e3f1;
            border-radius: 14px;
            padding: 0;
            margin-bottom: 12px;
            overflow: hidden;
        }

        .textarea-label {
            color: #506c88;
            font-size: 12px;
            font-weight: 800;
            padding: 10px 14px 0;
        }

        .textarea-box {
            display: grid;
            grid-template-columns: 24px 1fr;
            gap: 10px;
            padding: 10px 14px 16px;
            min-height: 100px;
            align-items: start;
        }

            .textarea-box i {
                margin-top: 12px;
                color: #506c88;
                font-size: 14px;
            }

        .remarks-text {
            width: 100%;
            min-height: 80px;
            border: 0;
            outline: none;
            resize: vertical;
            background: transparent;
            font-size: 13px;
            line-height: 1.6;
            color: #102033;
            font-weight: 600;
            padding: 0;
        }

            .remarks-text::placeholder {
                color: #8ba0b7;
            }

        .location-remarks {
            display: block;
        }

        @@media(max-width: 768px) {
            .page {
                padding: 14px;
            }

            .info-grid,
            .field-row {
                grid-template-columns: 1fr;
                gap: 5px;
            }

            .save-btn span {
                display: none;
            }
        }
    </style>
</head>

<body>
    <header class="appbar">
        <a class="back-btn" href="/SurveyJobs/AreaCheckpoints?jobId=@jobId&areaId=@areaId">
            <i class="fa-solid fa-chevron-left"></i>
        </a>

        <div>
            <h1 class="title">Audit Check Point</h1>
            <p class="sub">@Val(Model.SampleNo ?? Model.Location)</p>
        </div>

        <button class="save-btn" type="submit" form="auditForm">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save</span>
        </button>
    </header>

    <nav class="tabs">
        <a class="tab active" href="#details">
            <i class="fa-regular fa-file-lines"></i>
            DETAILS
        </a>
        <a class="tab" href="#area">
            <i class="fa-solid fa-location-dot"></i>
            AREA
        </a>
        <a class="tab" href="#images">
            <i class="fa-regular fa-image"></i>
            IMAGES
        </a>
    </nav>

    <main class="page">
        <form id="auditForm" method="post" action="/SurveyJobs/SaveCheckpointAudit">
            @Html.AntiForgeryToken()

            <input type="hidden" name="JobId" value="@jobId" />
            <input type="hidden" name="AreaId" value="@areaId" />
            <input type="hidden" name="CheckpointId" value="@Model.Id" />

            <section id="details">
                <h3 class="section-title">Checkpoint Info</h3>

                <div class="white-card">
                    <div class="info-grid">
                        <div class="info-label"><i class="fa-solid fa-location-dot"></i> Area</div>
                        <div class="info-value">@areaName</div>

                        <div class="info-label"><i class="fa-solid fa-location-dot"></i> Location</div>
                        <div class="info-value">@Val(Model.Location)</div>

                        <div class="info-label"><i class="fa-solid fa-gear"></i> Equipment</div>
                        <div class="info-value">@Val(Model.EquipmentName)</div>

                        <div class="info-label"><i class="fa-solid fa-shapes"></i> Component</div>
                        <div class="info-value">@Val(Model.Component)</div>

                        <div class="info-label"><i class="fa-solid fa-magnifying-glass"></i> Object To Check</div>
                        <div class="info-value">@objectToCheck</div>

                        <div class="info-label"><i class="fa-solid fa-triangle-exclamation"></i> Hazmat</div>
                        <div class="info-value hazmat-value">@Val(Model.HazardousMaterial)</div>
                    </div>
                </div>

                <h3 class="section-title">Audit Results</h3>

                <div class="status-banner">
                    <i class="fa-solid fa-clipboard-check status-icon"></i>
                    <div>
                        <div class="status-main">@pchmStatus</div>
                        <div class="status-sub">@auditResult</div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="field-row">
                        <div class="field-label">
                            <i class="fa-regular fa-rectangle-list"></i>
                            Document Analysis
                        </div>
                        <div class="field-value">Unknown</div>
                    </div>

                    <div class="field-row">
                        <div class="field-label">
                            <i class="fa-regular fa-square-check"></i>
                            Result of Check
                        </div>
                        <div class="field-value">@result</div>
                    </div>
                </div>

                <div class="form-card">
                    <label class="textarea-label">Audit Result</label>
                    <div class="select-wrap">
                        <select name="AuditResult" class="select-like">
                            <option value="Pending" selected="@(auditResult == "Pending")">Pending</option>
                            <option value="Audited" selected="@(auditResult == "Audited")">Audited</option>
                        </select>
                    </div>
                </div>

                <h3 class="section-title">Flags & Remarks</h3>

                <div class="switch-row">
                    <div class="flag-icon">
                        <i class="fa-solid fa-flag"></i>
                    </div>

                    <div class="switch-text">
                        <div class="switch-title">Mark as PCHM</div>
                        <div class="switch-sub">Potential Concentration of Hazardous Material</div>
                    </div>

                    <label class="switch">
                        <input type="checkbox" name="IsPchm" />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="remarks-card">
                    <div class="textarea-label">Remarks</div>
                    <div class="textarea-box">
                        <i class="fa-solid fa-list-check"></i>
                        <textarea name="Remarks" class="remarks-text">Machinery Arrangement Plan & Onboard Visit</textarea>
                    </div>
                </div>

                <div class="remarks-card">

                    <div class="textarea-label">
                        Location Remarks (if any)
                    </div>

                    <div class="textarea-box">

                        <i class="fa-solid fa-location-crosshairs"></i>

                        <textarea name="LocationRemarks"
                                  class="remarks-text"
                                  rows="4"
                                  placeholder="Enter location remarks here...">@Model.LocationRemarks</textarea>

                    </div>

                </div>
            </section>


            
        </form>
    </main>
</body>
</html>