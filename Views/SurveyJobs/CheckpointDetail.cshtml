@model Survery_Certification_App_Consume.Models.IhmCheckpointOptionDto
@{
    Layout = null;

    var jobId = (int)(ViewBag.JobId ?? 0);
    var areaId = (int)(ViewBag.AreaId ?? 0);
    var areaName = ViewBag.AreaName?.ToString() ?? "Area";
    var layouts = ViewBag.Layouts as List<Survery_Certification_App_Consume.Models.IhmLayoutAttachmentDto>
        ?? new List<Survery_Certification_App_Consume.Models.IhmLayoutAttachmentDto>();
    var layoutOptionsJson = Newtonsoft.Json.JsonConvert.SerializeObject(layouts.Select(layout => new
    {
        target = layout.Target,
        originalFileName = layout.OriginalFileName,
        filePath = layout.FilePath,
        isCommon = string.Equals(layout.Target, "common", StringComparison.OrdinalIgnoreCase)
    }));
    var checkpointLabels = ViewBag.CheckpointLabels as Dictionary<int, string>
        ?? new Dictionary<int, string>();
    var checkpointLabelsJson = Newtonsoft.Json.JsonConvert.SerializeObject(checkpointLabels);
    var apiRoot = ViewBag.ApiRoot?.ToString() ?? "";

    string Val(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string Raw(string? value) => value?.Trim() ?? "";
    string NormalizeResult(string? value)
    {
        var clean = (value ?? "").Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "").Replace("-", "");
        return clean switch
        {
            "present" or "2" => "Present",
            "notpresent" or "3" => "NotPresent",
            "notapplicable" or "4" => "NotApplicable",
            "samplerequired" or "5" => "SampleRequired",
            _ => "Pending"
        };
    }

    var sampleLabel = Val(Model.SampleNo ?? Model.Location);
    var auditResult = NormalizeResult(Model.Result ?? Model.CheckResult);
    var auditComplete = auditResult != "Pending";
    var auditStatusText = auditComplete ? "Saved and completed" : "Pending";
    var layoutPath = layouts.FirstOrDefault(x =>
        string.Equals(x.Target, areaId.ToString(), StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x.Target, areaName, StringComparison.OrdinalIgnoreCase))?.FilePath
        ?? layouts.FirstOrDefault(x => string.Equals(x.Target, "common", StringComparison.OrdinalIgnoreCase))?.FilePath
        ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Audit Check Point</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f4f7fb;
            color: #102033;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .appbar {
            min-height: 64px;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 20px;
            background: #ffffff;
            border-bottom: 1px solid #d8e3ee;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .back-btn {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #102033;
            text-decoration: none;
            border-radius: 10px;
        }

        .title {
            margin: 0;
            font-size: 15px;
            font-weight: 800;
        }

        .sub {
            margin: 2px 0 0;
            color: #607d9a;
            font-size: 11px;
        }

        .save-btn {
            margin-left: auto;
            border: 0;
            border-radius: 8px;
            background: #4caf8c;
            color: #0d1b2a;
            font-size: 12px;
            font-weight: 900;
            padding: 9px 16px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            background: #ffffff;
            border-bottom: 1px solid #d8e3ee;
            position: sticky;
            top: 64px;
            z-index: 45;
        }

        .tab {
            border: 0;
            background: transparent;
            color: #607d9a;
            text-align: center;
            padding: 10px 6px 9px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .8px;
            border-bottom: 3px solid transparent;
        }

            .tab.active {
                color: #00d4aa;
                border-bottom-color: #00d4aa;
            }

            .tab i {
                display: block;
                font-size: 16px;
                margin-bottom: 4px;
            }

        .page {
            padding: 20px;
            max-width: 1480px;
            margin: 0 auto;
        }

        #areaPanel {
            margin-left: calc(50% - 50vw);
            margin-right: calc(50% - 50vw);
        }

            #areaPanel .layout-shell {
                width: min(100vw - 24px, 1500px);
                margin: 0 auto;
            }

        .tab-panel {
            display: none;
        }

            .tab-panel.active {
                display: block;
            }

        .section-label {
            margin: 0 0 12px;
            color: #607d9a;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .card-box {
            background: #ffffff;
            border: 1px solid #d8e3ee;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 18px;
        }

        .info-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 12px;
            padding-bottom: 10px;
            align-items: start;
        }

            .info-row:last-child {
                padding-bottom: 0;
            }

        .info-label {
            color: #607d9a;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .info-label i {
                width: 16px;
            }

        .info-value {
            color: #102033;
            font-size: 12px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .hazmat {
            color: #ff5252;
        }

        .audit-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-radius: 14px;
            border: 1px solid rgba(76, 175, 140, .35);
            background: rgba(76, 175, 140, .12);
            margin-bottom: 12px;
        }

            .audit-chip.pending {
                border-color: rgba(143, 168, 196, .35);
                background: rgba(143, 168, 196, .12);
            }

            .audit-chip strong {
                display: block;
                font-size: 13px;
            }

            .audit-chip small {
                color: #607d9a;
                font-size: 11px;
            }

        .field {
            width: 100%;
            border: 1px solid #d8e3ee;
            background: #eef4fb;
            color: #102033;
            border-radius: 12px;
            padding: 10px 12px;
            font-size: 13px;
            font-weight: 650;
        }

        textarea.field {
            min-height: 96px;
            resize: vertical;
            line-height: 1.5;
        }

        .field-row {
            display: grid;
            grid-template-columns: 170px 1fr;
            gap: 12px;
            align-items: center;
            margin-bottom: 12px;
        }

        .switch-row {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .switch-row .copy {
                flex: 1;
            }

        .switch-title {
            font-size: 13px;
            font-weight: 900;
        }

        .switch-sub {
            color: #607d9a;
            font-size: 12px;
        }

        .switch {
            position: relative;
            width: 50px;
            height: 28px;
            flex: 0 0 auto;
        }

            .switch input {
                display: none;
            }

        .slider {
            position: absolute;
            inset: 0;
            background: #e1e9f2;
            border: 1px solid #aab9ca;
            border-radius: 999px;
            cursor: pointer;
        }

            .slider:before {
                content: "";
                position: absolute;
                width: 20px;
                height: 20px;
                left: 4px;
                top: 3px;
                background: #607d9a;
                border-radius: 50%;
                transition: .2s;
            }

        .switch input:checked + .slider {
            background: rgba(0, 212, 170, .22);
            border-color: #00d4aa;
        }

            .switch input:checked + .slider:before {
                transform: translateX(20px);
                background: #00d4aa;
            }

        .auto-map-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin: 10px 0;
        }

        .auto-map-column {
            background: #fff;
            border: 1px solid #d8e3ee;
            border-radius: 8px;
            padding: 10px;
            min-width: 0;
        }

            .auto-map-column h4 {
                margin: 0 0 8px;
                font-size: 13px;
                font-weight: 800;
                color: #102033;
            }

        .sample-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            font-size: 12px;
        }

            .sample-list.muted {
                color: #607d9a;
            }

        .sample-pill {
            border: 1px solid #cfe0ef;
            border-radius: 999px;
            padding: 4px 8px;
            background: #f7fbff;
            font-weight: 700;
        }

            .sample-pill.mapped {
                border-color: #7bcf9b;
                background: #effaf3;
                color: #247044;
            }

            .sample-pill.pending {
                border-color: #ffc46b;
                background: #fff7e8;
                color: #8a5a00;
            }

        .pending-map-row {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .pending-map-row button {
                border: 1px solid #d8e3ee;
                background: #fff;
                color: #102033;
                border-radius: 7px;
                padding: 2px 6px;
                font-size: 10px;
                font-weight: 800;
            }

                .pending-map-row button:hover {
                    border-color: #1e90ff;
                    color: #1e90ff;
                }

        @@media (max-width: 800px) {
            .auto-map-summary {
                grid-template-columns: 1fr;
            }
        }

        .layout-shell {
            min-height: calc(100vh - 170px);
            position: relative;
            border: 1px solid #d8e3ee;
            border-radius: 14px;
            overflow: hidden;
            background: #ffffff;
        }

        .layout-toolbar {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            z-index: 4;
            display: flex;
            gap: 10px;
            align-items: center;
        }

            .layout-toolbar select {
                flex: 1;
                min-width: 0;
                background: rgba(255, 255, 255, .96);
                color: #102033;
                border: 1px solid #d8e3ee;
                border-radius: 12px;
                padding: 10px 12px;
                font-size: 12px;
                font-weight: 800;
            }

        .layout-action {
            border: 1px solid #d8e3ee;
            background: rgba(255, 255, 255, .96);
            color: #102033;
            border-radius: 12px;
            padding: 10px 12px;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

        #markerSaveBtn {
            display: none;
        }

        .layout-stage {
            min-height: calc(100vh - 170px);
            overflow: auto;
            padding: 12px 12px 54px;
            cursor: grab;
            touch-action: none;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .layout-stage.dragging {
                cursor: grabbing;
            }

        .image-wrap {
            position: relative;
            display: inline-block;
            border-radius: 12px;
            overflow: visible;
            border: 1px solid #d8e3ee;
            background: #f4f7fb;
            transform-origin: 0 0;
            will-change: transform;
        }

        .layout-stage:has(.image-wrap) {
            align-items: flex-start;
            justify-content: flex-start;
        }

        .layout-stage:not(.dragging) .image-wrap {
            margin: auto;
        }

        .layout-image {
            display: block;
            width: auto;
            max-width: none;
            height: auto;
        }

        #markerPins {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: hidden;
            contain: layout paint;
            overflow: hidden;
            contain: layout paint;
            pointer-events: none;
        }

        .marker-pin {
            position: absolute;
            width: 0;
            height: 0;
            color: #ff5252;
            --pin-color: #ff5252;
            text-align: center;
            pointer-events: auto;
        }

        .pin-content {
            position: absolute;
            left: calc(-36px * var(--pin-scale, 1));
            top: calc(-64px * var(--pin-scale, 1));
            width: 72px;
            height: 64px;
            transform: scale(var(--pin-scale, 1));
            transform-origin: 50% 0;
            filter: drop-shadow(0 2px 3px rgba(0,0,0,.35));
            white-space: nowrap;
        }

        .marker-pin.active {
            color: #1e90ff;
            --pin-color: #1e90ff;
        }

            .marker-pin.ocr-existing,
            .marker-pin.active.ocr-existing {
                color: #14a06f;
                --pin-color: #14a06f;
            }

                .marker-pin.ocr-existing .pin-label::after {
                    font-size: 9px;
                    font-weight: 800;
                }

        .pin-label {
            display: block;
            min-width: 34px;
            max-width: 74px;
            margin: 0 auto -3px;
            padding: 4px 7px;
            border: 2px solid #fff;
            border-radius: 999px;
            background: var(--pin-color);
            color: #fff;
            font-size: 11px;
            font-weight: 900;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .marker-pin i {
            font-size: 32px;
            line-height: 32px;
        }

        .layout-hint {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 16px;
            text-align: center;
            z-index: 4;
        }

            .layout-hint span {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 8px 14px;
                border-radius: 999px;
                background: rgba(255, 255, 255, .94);
                border: 1px solid #d8e3ee;
                color: #607d9a;
                font-size: 11px;
                font-weight: 800;
            }

        .empty-state {
            color: #607d9a;
            text-align: center;
            padding: 50px 16px;
            font-weight: 750;
        }

        .upload-bar {
            padding: 16px;
        }

        .upload-btn {
            width: 100%;
            height: 46px;
            border: 0;
            border-radius: 12px;
            background: #00d4aa;
            color: #0d1b2a;
            font-weight: 900;
        }

        .photo-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            padding: 0 16px 16px;
        }

        .photo-card {
            position: relative;
            aspect-ratio: 1 / .9;
            border-radius: 12px;
            overflow: hidden;
            background: #eef4fb;
            border: 1px solid #d8e3ee;
        }

            .photo-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .photo-card.image-error::after {
                content: "Image not available";
                position: absolute;
                inset: 0;
                display: grid;
                place-items: center;
                color: #607d9a;
                font-size: 12px;
                font-weight: 800;
                background: #eef4fb;
            }

        .delete-photo {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 50%;
            background: rgba(0,0,0,.58);
            color: #fff;
        }

        .alert-line {
            margin-bottom: 14px;
            border-radius: 12px;
            padding: 10px 12px;
            font-weight: 800;
        }

            .alert-line.success {
                background: rgba(76,175,140,.16);
                color: #7be0bd;
                border: 1px solid rgba(76,175,140,.35);
            }

            .alert-line.error {
                background: rgba(255,82,82,.14);
                color: #ff9c9c;
                border: 1px solid rgba(255,82,82,.35);
            }

        @@media(max-width: 760px) {
            .page {
                padding: 16px;
            }

            .info-row, .field-row {
                grid-template-columns: 1fr;
                gap: 6px;
            }

            .photo-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .save-btn span {
                display: none;
            }

            .layout-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .layout-stage {
                padding-top: 112px;
            }
        }
    </style>
</head>
<body>
    <header class="appbar">
        <a class="back-btn" href="/SurveyJobs/AreaCheckpoints?jobId=@jobId&areaId=@areaId">
            <i class="fa-solid fa-chevron-left"></i>
        </a>
        <div>
            <h1 class="title">Audit Check Point</h1>
            <p class="sub">@sampleLabel</p>
        </div>
        <button class="save-btn" type="submit" form="auditForm">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save</span>
        </button>
    </header>

    <nav class="tabs" aria-label="Checkpoint tabs">
        <button class="tab active" type="button" data-tab="details"><i class="fa-regular fa-file-lines"></i>DETAILS</button>
        <button class="tab" type="button" data-tab="area"><i class="fa-solid fa-location-dot"></i>AREA</button>
        <button class="tab" type="button" data-tab="images"><i class="fa-solid fa-camera"></i>IMAGES</button>
    </nav>

    <main class="page">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-line success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-line error">@TempData["ErrorMessage"]</div>
        }

        <form id="auditForm" method="post" action="/SurveyJobs/SaveCheckpointAudit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="JobId" value="@jobId" />
            <input type="hidden" name="AreaId" value="@areaId" />
            <input type="hidden" name="CheckpointId" value="@Model.Id" />
            <input type="hidden" name="SampleNo" value="@Raw(Model.SampleNo)" />
            <input type="hidden" name="Description" value="@Raw(Model.Description)" />
            <input type="hidden" name="TableType" value="@Raw(Model.TableType)" />
            <input type="hidden" name="Location" value="@Raw(Model.Location)" />
            <input type="hidden" name="EquipmentName" value="@Raw(Model.EquipmentName)" />
            <input type="hidden" name="Component" value="@Raw(Model.Component)" />
            <input type="hidden" name="MaterialCategory" value="@Raw(Model.MaterialCategory)" />
            <input type="hidden" name="HazardousMaterial" value="@Raw(Model.HazardousMaterial)" />
            <input type="hidden" name="QuantityUnitKg" value="@Model.QuantityUnitKg" />
            <input type="hidden" name="QuantityNo" value="@Model.QuantityNo" />
            <input type="hidden" name="QuantityTotalKg" value="@Model.QuantityTotalKg" />
            <input type="hidden" name="ManufacturerBrandName" value="@Raw(Model.ManufacturerBrandName)" />
            <input type="hidden" name="DocumentAnalysisResult" value="@Raw(Model.DocumentAnalysisResult)" />
            <input type="hidden" name="SamplingCheck" value="@Raw(Model.SamplingCheck)" />
            <input type="hidden" name="VisualCheck" value="@Raw(Model.VisualCheck)" />
            <input type="hidden" name="CheckResult" value="@Raw(Model.CheckResult)" />

            <section id="detailsPanel" class="tab-panel active">
                <h3 class="section-label">Checkpoint Info</h3>
                <div class="card-box">
                    <div class="info-row"><div class="info-label"><i class="fa-solid fa-location-dot"></i>Area</div><div class="info-value">@areaName</div></div>
                    <div class="info-row"><div class="info-label"><i class="fa-solid fa-map-pin"></i>Location</div><div class="info-value">@Val(Model.Location)</div></div>
                    <div class="info-row"><div class="info-label"><i class="fa-solid fa-gear"></i>Equipment</div><div class="info-value">@Val(Model.EquipmentName)</div></div>
                    <div class="info-row"><div class="info-label"><i class="fa-solid fa-shapes"></i>Component</div><div class="info-value">@Val(Model.Component)</div></div>
                    <div class="info-row"><div class="info-label"><i class="fa-solid fa-magnifying-glass"></i>Object To Check</div><div class="info-value">@Val(Model.Description)</div></div>
                    <div class="info-row"><div class="info-label"><i class="fa-solid fa-triangle-exclamation"></i>Hazardous material</div><div class="info-value hazmat">@Val(Model.HazardousMaterial)</div></div>
                </div>

                <h3 class="section-label">Audit Results</h3>
                <div class="audit-chip @(auditComplete ? "" : "pending")">
                    <i class="fa-solid @(auditComplete ? "fa-circle-check" : "fa-clock")"></i>
                    <div>
                        <strong id="auditResultLabel">@auditResult.Replace("Not", "Not ").Replace("SampleRequired", "Sample Required")</strong>
                        <small>@auditStatusText</small>
                    </div>
                </div>

                <div class="card-box">
                    <div class="info-row"><div class="info-label"><i class="fa-regular fa-file-lines"></i>Document Analysis</div><div class="info-value">@Val(Model.DocumentAnalysisResult)</div></div>
                    <div class="info-row"><div class="info-label"><i class="fa-regular fa-square-check"></i>Result of Check</div><div class="info-value">@Val(Model.CheckResult)</div></div>
                    <div class="field-row">
                        <div class="info-label"><i class="fa-solid fa-clipboard-check"></i>Audit Result</div>
                        <select class="field" name="AuditResult" id="auditResult">
                            @if (auditResult == "Pending")
                            {
                                <option value="Pending" selected>Pending</option>
                            }
                            else
                            {
                                <option value="Pending">Pending</option>
                            }
                            @if (auditResult == "Present")
                            {
                                <option value="Present" selected>Present</option>
                            }
                            else
                            {
                                <option value="Present">Present</option>
                            }
                            @if (auditResult == "NotPresent")
                            {
                                <option value="NotPresent" selected>Not Present</option>
                            }
                            else
                            {
                                <option value="NotPresent">Not Present</option>
                            }
                            @if (auditResult == "NotApplicable")
                            {
                                <option value="NotApplicable" selected>Not Applicable</option>
                            }
                            else
                            {
                                <option value="NotApplicable">Not Applicable</option>
                            }
                            @if (auditResult == "SampleRequired")
                            {
                                <option value="SampleRequired" selected>Sample Required</option>
                            }
                            else
                            {
                                <option value="SampleRequired">Sample Required</option>
                            }
                        </select>
                    </div>
                </div>

                <h3 class="section-label">Flags & Remarks</h3>
                <div class="card-box switch-row">
                    <span class="info-label"><i class="fa-solid fa-flag"></i></span>
                    <div class="copy">
                        <div class="switch-title">Mark as PCHM</div>
                        <div class="switch-sub">Potential Concentration of Hazardous Material</div>
                    </div>
                    <label class="switch">
                        @if (Model.IsPchm)
                        {
                            <input type="checkbox" name="IsPchm" value="true" checked />
                        }
                        else
                        {
                            <input type="checkbox" name="IsPchm" value="true" />
                        }
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="card-box">
                    <label class="section-label" for="remarks">Remarks</label>
                    <textarea id="remarks" name="Remarks" class="field" placeholder="Enter remarks...">@Raw(Model.Remarks)</textarea>
                </div>
                <div class="card-box">
                    <label class="section-label" for="locationRemarks">Location Remarks</label>
                    <textarea id="locationRemarks" name="LocationRemarks" class="field" placeholder="Enter location remarks here...">@Raw(Model.LocationRemarks)</textarea>
                </div>
            </section>
        </form>

        <section id="areaPanel" class="tab-panel">
            <div class="layout-shell">
                <button id="markerSaveBtn" class="layout-action" type="button" onclick="saveMarker()" disabled hidden>
                    <i class="fa-solid fa-floppy-disk"></i> Save Marker
                </button>
                <button id="autoMapMarkersBtn" class="layout-action" type="button" onclick="autoMapExistingMarkers()">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Auto Map Existing Markers
                </button>
                <div class="auto-map-summary">
                    <div class="auto-map-column">
                        <h4>Expected Samples</h4>
                        <div id="expectedSamplesList" class="sample-list"></div>
                    </div>
                    <div class="auto-map-column">
                        <h4>Mapped Samples</h4>
                        <div id="mappedSamplesList" class="sample-list muted">Click Auto Map</div>
                    </div>
                    <div class="auto-map-column">
                        <h4>Pending Samples</h4>
                        <div id="pendingSamplesList" class="sample-list muted">Click Auto Map</div>
                    </div>
                </div>

                <div class="layout-stage">
                    @if (string.IsNullOrWhiteSpace(layoutPath))
                    {
                        <div class="empty-state">Layout image not uploaded for this area.</div>
                    }
                    else
                    {
                        <div id="imageWrap" class="image-wrap">
                            <img id="layoutImage" class="layout-image" src="" alt="Layout" />
                            <div id="markerPins"></div>
                        </div>
                    }
                </div>
                <div class="layout-hint">
                    <span id="markerHint"><i class="fa-solid fa-hand-pointer"></i>Tap to add or update marker</span>
                </div>
            </div>
        </section>

        <section id="imagesPanel" class="tab-panel">
            <div class="card-box">
                <div class="upload-bar">
                    <input id="photoInput" type="file" accept="image/*" multiple hidden />
                    <button id="uploadBtn" class="upload-btn" type="button" onclick="document.getElementById('photoInput').click()">
                        <i class="fa-solid fa-camera"></i> Add Checkpoint Images
                    </button>
                </div>
                <div id="photoGrid" class="photo-grid"></div>
                <div id="photoEmpty" class="empty-state">No checkpoint images uploaded yet</div>
            </div>
        </section>
    </main>

    <script>
        const checkpointContext = {
            jobId: @jobId,
            areaId: @areaId,
            checkpointId: @Model.Id,
            sampleNo: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(sampleLabel)),
            initialLayoutPath: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(layoutPath))
        };
        const layoutOptions = @Html.Raw(layoutOptionsJson);

        const checkpointLabels = @Html.Raw(checkpointLabelsJson);
             const expectedSamples = Object.entries(checkpointLabels || {})
        .map(([checkpointId, label]) => ({
            checkpointId: Number(checkpointId),
            label: String(label || "").trim()
        }))
        .filter(x => x.checkpointId > 0 && x.label && x.label !== "-")
        .sort((a, b) => a.label.localeCompare(b.label, undefined, { numeric: true, sensitivity: "base" }));
        const apiRoot = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(apiRoot));
        let currentImagePath = checkpointContext.initialLayoutPath || (layoutOptions[0]?.filePath ?? "");
        let loadedMarkers = [];
        let selectedPoint = null;
                let manualMapMode = "new";
        let manualMapCheckpointId = checkpointContext.checkpointId;
        let manualMapSampleNo = checkpointContext.sampleNo;
        const mapView = {
            scale: 1,
            x: 0,
            y: 0
        };

        document.querySelectorAll(".tab").forEach(button => {
            button.addEventListener("click", () => activateTab(button.dataset.tab));
        });

        function activateTab(name) {
            document.querySelectorAll(".tab").forEach(x => x.classList.toggle("active", x.dataset.tab === name));
            document.querySelectorAll(".tab-panel").forEach(x => x.classList.toggle("active", x.id === `${name}Panel`));
            if (name === "area") initializeAreaTab();
            if (name === "images") loadPhotos();
        }

        function normalizeUrl(path) {
            if (!path) return "";
            if (path.startsWith("http")) return path;
            const cleanPath = path.startsWith("/") ? path : "/" + path;
            return apiRoot ? `${apiRoot}${cleanPath}` : cleanPath;
        }

        function normalizePathForCompare(path) {
            if (!path) return "";

            try {
                const url = path.startsWith("http")
                    ? new URL(path)
                    : new URL(normalizeUrl(path), window.location.origin);

                return url.pathname.toLowerCase().replace(/^\/+/, "");
            } catch {
                return String(path)
                    .toLowerCase()
                    .replace(/^https?:\/\/[^/]+/i, "")
                    .replace(/^\/+/, "");
            }
        }

        function samePath(left, right) {
            return normalizePathForCompare(left) === normalizePathForCompare(right);
        }
        function normalizePathForSave(path) {
            return normalizePathForCompare(path);
        }
        function getValue(row, camel, pascal) {
            return row[camel] ?? row[pascal];
        }
                function firstValue(row, names) {
            for (const name of names) {
                const value = row?.[name];
                if (value !== undefined && value !== null && value !== "") return value;
            }
            return null;
        }

        function getMarkerCoordinate(marker, axis) {
            const image = document.getElementById("layoutImage");
            const raw = Number(firstValue(
                marker,
                axis === "x"
                    ? ["xPercent", "XPercent", "markerX", "MarkerX", "posX", "PosX", "coordinateX", "CoordinateX", "x", "X"]
                    : ["yPercent", "YPercent", "markerY", "MarkerY", "posY", "PosY", "coordinateY", "CoordinateY", "y", "Y"]
            ));

            if (!Number.isFinite(raw)) return null;

            // Common format for web rendering is 0..100 percent.
            if (raw >= 0 && raw <= 1) return raw * 100;
            if (raw >= 0 && raw <= 100) return raw;

            // Old pixel fallback only. Convert once for display; do not default to 0,0.
            const size = axis === "x" ? image?.clientWidth : image?.clientHeight;
            if (size && raw > 100 && raw <= size) return (raw / size) * 100;

            return null;
        }

        function getMarkerLabel(marker, checkpointId) {
            return firstValue(marker, [
                "markerLabel", "MarkerLabel",
                "label", "Label",
                "markerCode", "MarkerCode",
                "checkpointCode", "CheckpointCode"
            ]) || checkpointLabels[checkpointId] || "";
        }
              function renderSampleList(elementId, samples, className) {
            const element = document.getElementById(elementId);
            if (!element) return;

            if (!samples.length) {
                element.className = "sample-list muted";
                element.textContent = "None";
                return;
            }

            element.className = "sample-list";

            if (elementId === "pendingSamplesList") {
                element.innerHTML = samples
                    .map(sample => `
                        <span class="sample-pill pending pending-map-row">
                            <strong>${escapeHtml(sample.label || sample)}</strong>
                            <button type="button" onclick="selectExistingMapSample(${Number(sample.checkpointId)}, '${escapeJs(sample.label)}')">Existing</button>
                        </span>
                    `)
                    .join("");
                return;
            }

            element.innerHTML = samples
                .map(sample => `<span class="sample-pill ${className || ""}">${escapeHtml(sample.label || sample)}</span>`)
                .join("");
        }




                function refreshAutoMapLists(result) {
            const mappedCheckpointIds = new Set(
                loadedMarkers
                    .map(marker => Number(getValue(marker, "ihmCheckpointId", "IhmCheckpointId")))
                    .filter(id => id > 0)
            );

            const mappedLabels = new Set(
                loadedMarkers
                    .map(marker => String(getMarkerLabel(
                        marker,
                        Number(getValue(marker, "ihmCheckpointId", "IhmCheckpointId"))
                    ) || "").trim().toUpperCase())
                    .filter(Boolean)
            );

            const mapped = expectedSamples.filter(sample =>
                mappedCheckpointIds.has(sample.checkpointId) ||
                mappedLabels.has(sample.label.toUpperCase())
            );

            const pending = expectedSamples.filter(sample =>
                !mappedCheckpointIds.has(sample.checkpointId) &&
                !mappedLabels.has(sample.label.toUpperCase())
            );

            renderSampleList("expectedSamplesList", expectedSamples, "");
            renderSampleList("mappedSamplesList", mapped, "mapped");
            renderSampleList("pendingSamplesList", pending, "pending");
        }
                function escapeJs(value) {
            return String(value || "")
                .replace(/\\/g, "\\\\")
                .replace(/'/g, "\\'")
                .replace(/\n/g, "\\n")
                .replace(/\r/g, "");
        }

        function selectExistingMapSample(checkpointId, sampleNo) {
            manualMapCheckpointId = Number(checkpointId);
            manualMapSampleNo = sampleNo;
            manualMapMode = "existing";

            selectedPoint = null;
            renderMarkers();

            document.getElementById("markerHint").innerHTML =
                `<i class="fa-solid fa-crosshairs"></i>${escapeHtml(sampleNo)}: click existing sample label/text box.`;
        }

        function resetManualMapMode() {
            manualMapMode = "new";
            manualMapCheckpointId = checkpointContext.checkpointId;
            manualMapSampleNo = checkpointContext.sampleNo;
        }
        function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value ?? "";
            return div.innerHTML;
        }

        function initializeAreaTab() {
            const image = document.getElementById("layoutImage");
            if (!image || image.dataset.ready === "true") return;



            image.src = normalizeUrl(currentImagePath);
            image.dataset.ready = "true";

            initializeMapZoom();
            loadMarkers();
            renderSampleList("expectedSamplesList", expectedSamples, "");
        }

                 function initializeMapZoom() {
            const stage = document.querySelector(".layout-stage");
            const wrap = document.getElementById("imageWrap");
            if (!stage || !wrap || stage.dataset.zoomReady === "true") return;

            stage.dataset.zoomReady = "true";
            applyMapTransform();

            let isDragging = false;
            let dragStartX = 0;
            let dragStartY = 0;
            let startScrollLeft = 0;
            let startScrollTop = 0;
            let moved = false;
            window.layoutDragMoved = false;
            stage.addEventListener("pointerdown", event => {
                if (event.button !== undefined && event.button !== 0) return;
                isDragging = true;
                moved = false;
                window.layoutDragMoved = false;
                dragStartX = event.clientX;
                dragStartY = event.clientY;
                startScrollLeft = stage.scrollLeft;
                startScrollTop = stage.scrollTop;

                stage.setPointerCapture(event.pointerId);
            });

            stage.addEventListener("pointermove", event => {
                if (!isDragging) return;

                const dx = event.clientX - dragStartX;
                const dy = event.clientY - dragStartY;

                   if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
            moved = true;
            window.layoutDragMoved = true;
            stage.classList.add("dragging");
        }

                       if (moved) {
            stage.scrollLeft = startScrollLeft - dx;
            stage.scrollTop = startScrollTop - dy;
        }
            });

                    stage.addEventListener("pointerup", event => {
            isDragging = false;
            stage.classList.remove("dragging");

            if (stage.hasPointerCapture(event.pointerId)) {
                stage.releasePointerCapture(event.pointerId);
            }

            if (moved) {
                event.preventDefault();
                event.stopPropagation();
                setTimeout(() => window.layoutDragMoved = false, 0);
                return;
            }

            handleLayoutPointerTap(event);
        });

            stage.addEventListener("wheel", event => {
                event.preventDefault();

                const oldScale = mapView.scale;
                const zoomFactor = event.deltaY < 0 ? 1.15 : 1 / 1.15;
                const nextScale = Math.max(1, Math.min(6, oldScale * zoomFactor));
                if (nextScale === oldScale) return;

                const stageRect = stage.getBoundingClientRect();
                const pointerX = event.clientX - stageRect.left;
                const pointerY = event.clientY - stageRect.top;

                const beforeX = (stage.scrollLeft + pointerX) / oldScale;
                const beforeY = (stage.scrollTop + pointerY) / oldScale;

                mapView.scale = nextScale;
                applyMapTransform();

                stage.scrollLeft = beforeX * nextScale - pointerX;
                stage.scrollTop = beforeY * nextScale - pointerY;
            }, { passive: false });
        }

        function resetMapView() {
            mapView.scale = 1;
            mapView.x = 0;
            mapView.y = 0;
            applyMapTransform();
        }

                function applyMapTransform() {
            const wrap = document.getElementById("imageWrap");
            if (!wrap) return;
                      wrap.style.zoom = "";
        wrap.style.transform = `scale(${mapView.scale})`;
            wrap.style.setProperty("--pin-scale", 1 / mapView.scale);
        }

        function setMarkerHint(message, icon = "fa-circle-info") {
            const hint = document.getElementById("markerHint");
            if (!hint) return;
            hint.innerHTML = `<i class="fa-solid ${icon}"></i>${message}`;
        }

        function markedSectionCode(item) {
            const raw = item?.sectionTypeCode ?? item?.SectionTypeCode ?? item?.sectionType ?? item?.SectionType ?? item?.sectionTypeText ?? item?.SectionTypeText;
            if (raw === null || raw === undefined) return 0;
            const numeric = Number(raw);
            if (!Number.isNaN(numeric)) return numeric;
            const text = String(raw).toLowerCase();
            if (text === "hazardous") return 1;
            if (text === "appendix4") return 2;
            return 0;
        }

        function markedStatusCode(item) {
            const raw = item?.statusCode ?? item?.StatusCode ?? item?.status ?? item?.Status ?? item?.statusText ?? item?.StatusText;
            if (raw === null || raw === undefined) return 0;
            const numeric = Number(raw);
            if (!Number.isNaN(numeric)) return numeric;
            switch (String(raw).toLowerCase()) {
                case "pending": return 1;
                case "processing": return 2;
                case "completed": return 3;
                case "failed": return 4;
                default: return 0;
            }
        }

        async function pollMarkedImageStatus() {
            setMarkerHint("Appendix 4 and I-2 images are generating...", "fa-spinner fa-spin");

            for (let attempt = 0; attempt < 30; attempt += 1) {
                const response = await fetch(`/SurveyJobs/GetMarkedImageStatus?jobId=${checkpointContext.jobId}`);

                if (!response.ok) {
                    setMarkerHint("Unable to check marked image generation status.", "fa-triangle-exclamation");
                    return;
                }

                const result = await response.json();
                const items = result.items || result.Items || [];
                const appendix4 = items.find(item => markedSectionCode(item) === 2);
                const hazardous = items.find(item => markedSectionCode(item) === 1);

            const appendixFailed = markedStatusCode(appendix4) === 4;
        if (appendixFailed) {
            setMarkerHint("Marked image update failed. Please try again.", "fa-triangle-exclamation");
            return;
        }

        // Do not show hazardous I-2 backend/Python error here.
        // It only means some expected markers are still pending.

                const appendixReady = markedStatusCode(appendix4) === 3;
                const hazardousReady = markedStatusCode(hazardous) === 3;

                if (appendixReady && hazardousReady) {
                    setMarkerHint("Appendix 4 and I-2 images are ready for PDF generation.", "fa-circle-check");
                    return;
                }

                await new Promise(resolve => setTimeout(resolve, 3000));
            }

            setMarkerHint("Marked images are still generating. You can continue after a moment.", "fa-clock");
        }

                async function autoMapExistingMarkers() {
            const button = document.getElementById("autoMapMarkersBtn");
            if (!button) return;

            button.disabled = true;
            button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Auto mapping...';

            try {
                const response = await fetch("/SurveyJobs/AutoMapLayoutMarkers", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        jobId: checkpointContext.jobId,
                        areaId: checkpointContext.areaId,
                        imagePath: normalizePathForSave(currentImagePath)
                    })
                });

                const text = await response.text();
                const result = text ? JSON.parse(text) : {};

                console.log("Auto map existing markers response", result);

                if (!response.ok) {
                    throw new Error(result.message || text || "Auto mapping failed.");
                }

                setMarkerHint(`Mapped ${result.mapped || 0} marker(s).`, "fa-circle-check");

                await loadMarkers();
                refreshAutoMapLists(result);
                pollMarkedImageStatus();

                if (result.needsReview) {
                    alert("Auto mapping completed, but detected marker count does not match sample count. Please review marker positions.");
                }
            } catch (error) {
                alert(error.message || "Auto mapping failed.");
            } finally {
                button.disabled = false;
                button.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> Auto Map Existing Markers';
            }
        }
        async function loadMarkers() {
            const response = await fetch(`/SurveyJobs/GetIhmMarkers?jobId=${checkpointContext.jobId}`);
            if (!response.ok) return;
            loadedMarkers = await response.json();
            renderMarkers();
            refreshAutoMapLists();
        }

        function renderMarkers() {
            const container = document.getElementById("markerPins");
            if (!container) return;
            container.innerHTML = "";

                    const hasUnsavedPoint = selectedPoint !== null;
        const visibleByCheckpoint = new Map();

            loadedMarkers
        .filter(marker => {
            const checkpointId = Number(getValue(marker, "ihmCheckpointId", "IhmCheckpointId"));
            return samePath(getValue(marker, "imagePath", "ImagePath"), normalizePathForSave(currentImagePath)) &&
                !(hasUnsavedPoint && checkpointId === checkpointContext.checkpointId);
        })
        .forEach((marker, index) => {
            const checkpointId = Number(getValue(marker, "ihmCheckpointId", "IhmCheckpointId"));
            const markerId = Number(getValue(marker, "id", "Id") || getValue(marker, "markerId", "MarkerId") || getValue(marker, "localId", "LocalId") || 0);
            const sortId = markerId > 0 ? markerId : index;
            const existing = visibleByCheckpoint.get(checkpointId);

            if (!existing || sortId > existing.sortId) {
                visibleByCheckpoint.set(checkpointId, { marker, markerId, sortId });
            }
        });

        [...visibleByCheckpoint.values()]
                .forEach(({ marker, markerId }) => {
                    const checkpointId = Number(getValue(marker, "ihmCheckpointId", "IhmCheckpointId"));
                            const x = getMarkerCoordinate(marker, "x");
        const y = getMarkerCoordinate(marker, "y");

        if (x === null || y === null) {
            console.warn("Skipping marker with missing/invalid coordinates", marker);
            return;
        }

                   addPin(
            x,
            y,
            getMarkerLabel(marker, checkpointId),
            checkpointId === checkpointContext.checkpointId,
            markerId,
            isExistingImageMarker(marker)
        );

                });
               if (selectedPoint) {
            addPin(
                selectedPoint.x * 100,
                selectedPoint.y * 100,
                manualMapSampleNo || checkpointContext.sampleNo,
                true,
                0,
                manualMapMode === "existing"
            );
        }
        }

            function addPin(x, y, label, active, markerId, isOcrExisting = false) {
                           if (!Number.isFinite(x) || !Number.isFinite(y)) return;
        x = Math.max(0, Math.min(100, x));
        y = Math.max(0, Math.min(100, y));
            const pin = document.createElement("div");
            pin.className = `marker-pin${active ? " active" : ""}${isOcrExisting ? " ocr-existing" : ""}`;
            pin.style.left = `${x}%`;
            pin.style.top = `${y}%`;
            pin.dataset.markerId = markerId || "";
            pin.innerHTML = `<div class="pin-content"><span class="pin-label">${escapeHtml(label || "-")}</span><i class="fa-solid fa-location-dot"></i></div>`;

                 pin.addEventListener("pointerdown", event => {
            event.stopPropagation();
        });

        pin.addEventListener("pointerup", event => {
            event.preventDefault();
            event.stopPropagation();
        });

        pin.addEventListener("click", event => {
            event.stopPropagation();
        });

        pin.addEventListener("dblclick", event => {
            event.preventDefault();
            event.stopPropagation();
            clearTimeout(layoutClickTimer);

            if (!markerId) {
                alert("Marker id missing. Please refresh and try again.");
                return;
            }

            deleteMarker(markerId, true);
        });

            document.getElementById("markerPins").appendChild(pin);
        }

                let layoutClickTimer = null;
        let lastLayoutTapTime = 0;

        function validateMarkerSelection() {
            if (!manualMapCheckpointId || Number(manualMapCheckpointId) <= 0) {
                document.getElementById("markerHint").innerHTML =
                    '<i class="fa-solid fa-circle-exclamation"></i>Select checkpoint/sample before placing marker.';
                return false;
            }

           if (!manualMapSampleNo) {
                document.getElementById("markerHint").innerHTML =
                    '<i class="fa-solid fa-circle-exclamation"></i>Marker code is missing for this checkpoint.';
                return false;
            }

            return true;
        }

                function getLayoutPoint(event) {
            const image = document.getElementById("layoutImage");
            if (!image) return null;

            const rect = image.getBoundingClientRect();

            if (
                event.clientX < rect.left ||
                event.clientX > rect.right ||
                event.clientY < rect.top ||
                event.clientY > rect.bottom ||
                !rect.width ||
                !rect.height
            ) {
                return null;
            }

            return {
                x: Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width)),
                y: Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height))
            };
        }
                 function isExistingImageMarker(marker) {
            const notes = String(firstValue(marker, ["notes", "Notes"]) || "").trim().toLowerCase();
            const source = String(firstValue(marker, ["source", "Source"]) || "").trim().toLowerCase();

            return notes.includes("ocr-existing-label") || source === "existing-image";
        }
        function getCurrentCheckpointMarker() {
            return loadedMarkers.find(marker =>
                Number(getValue(marker, "ihmCheckpointId", "IhmCheckpointId")) === Number(checkpointContext.checkpointId) &&
                samePath(getValue(marker, "imagePath", "ImagePath"), normalizePathForSave(currentImagePath))
            );
        }

        function getMarkerId(marker) {
            return Number(
                getValue(marker, "id", "Id") ||
                getValue(marker, "markerId", "MarkerId") ||
                getValue(marker, "localId", "LocalId") ||
                0
            );
        }

        function handleLayoutPointerTap(event) {
            if (event.defaultPrevented || window.layoutDragMoved) return;

            const point = getLayoutPoint(event);
            if (!point) return;

            const now = Date.now();
            const isDoubleTap = now - lastLayoutTapTime < 320;
            lastLayoutTapTime = now;

            clearTimeout(layoutClickTimer);

            if (isDoubleTap) {
                const marker = getCurrentCheckpointMarker();
                const markerId = getMarkerId(marker);

                if (!markerId) {
                    document.getElementById("markerHint").innerHTML =
                        '<i class="fa-solid fa-circle-exclamation"></i>No saved marker found to remove.';
                    return;
                }

                deleteMarker(markerId, true);
                return;
            }

            layoutClickTimer = setTimeout(() => {
                if (!validateMarkerSelection()) return;

                selectedPoint = point;
                document.getElementById("markerHint").innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i>Saving marker...';

                saveMarker();
            }, 260);
        }

            async function deleteMarker(markerId, askConfirm = true) {
        if (!markerId) return;
        if (askConfirm && !confirm("Are you sure you want to remove this marker?")) return;

            const response = await fetch(`/SurveyJobs/DeleteIhmMarker?markerId=${markerId}`, {
                method: "POST"
            });

            if (!response.ok) {
                alert(await response.text() || "Failed to delete marker.");
                return;
            }

            selectedPoint = null;
            document.getElementById("markerSaveBtn").disabled = true;
            document.getElementById("markerHint").innerHTML = '<i class="fa-solid fa-circle-check"></i>Marker removed.';
            await loadMarkers();
        }

        async function saveMarker() {
            if (!selectedPoint) return;
            const button = document.getElementById("markerSaveBtn");
            button.disabled = true;
            button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving';
            try {

                const response = await fetch("/SurveyJobs/SaveIhmMarker", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
        surveyJobId: checkpointContext.jobId,
        ihmAreaId: checkpointContext.areaId,
        ihmCheckpointId: manualMapCheckpointId,
        imagePath: normalizePathForSave(currentImagePath),
        xPercent: selectedPoint.x,
        yPercent: selectedPoint.y,
        notes: manualMapMode === "existing" ? "manual-for-existing-image" : null,
        source: manualMapMode === "existing" ? "existing-image" : "manual",
        isManualForExistingImage: manualMapMode === "existing",
        suppressRender: false
                    })
                });
                if (!response.ok) throw new Error(await response.text() || "Failed to save marker.");
                        selectedPoint = null;
                        resetManualMapMode();
                        document.getElementById("markerHint").innerHTML = '<i class="fa-solid fa-circle-check"></i>Marker saved.';
                await loadMarkers();
            } catch (error) {
                alert(error.message || "Failed to save marker.");
                button.disabled = false;
            } finally {
                button.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Marker';
            }
        }

        async function loadPhotos() {
            const grid = document.getElementById("photoGrid");
            const empty = document.getElementById("photoEmpty");
            if (grid.dataset.loaded === "true") return;
            grid.innerHTML = "";
            const response = await fetch(`/SurveyJobs/GetCheckpointPhotos?checkpointId=${checkpointContext.checkpointId}`);
            if (!response.ok) {
                empty.textContent = "Unable to load checkpoint images.";
                return;
            }
            const photos = await response.json();
            renderPhotos(photos);
            grid.dataset.loaded = "true";
        }

        function renderPhotos(photos) {
            const grid = document.getElementById("photoGrid");
            const empty = document.getElementById("photoEmpty");
            grid.innerHTML = "";
            empty.style.display = photos.length ? "none" : "block";
            photos.forEach(photo => {
                const id = getValue(photo, "id", "Id");
                const path = getValue(photo, "filePath", "FilePath");
                if (!path) return;
                const card = document.createElement("div");
                card.className = "photo-card";
                card.innerHTML = `<img src="${normalizeUrl(path)}" alt="Checkpoint image" onerror="this.parentElement.classList.add('image-error'); this.remove();" />
                    <button class="delete-photo" type="button" onclick="deletePhoto(${id})"><i class="fa-solid fa-trash"></i></button>`;
                grid.appendChild(card);
            });
        }

        document.getElementById("photoInput").addEventListener("change", async event => {
            const files = Array.from(event.target.files || []);
            if (!files.length) return;
            const button = document.getElementById("uploadBtn");
            button.disabled = true;
            button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading...';
            const formData = new FormData();
            files.forEach(file => formData.append("files", file));
            try {
                const response = await fetch(`/SurveyJobs/UploadCheckpointPhotos?jobId=${checkpointContext.jobId}&checkpointId=${checkpointContext.checkpointId}`, {
                    method: "POST",
                    body: formData
                });
                if (!response.ok) throw new Error(await response.text() || "Upload failed.");
                document.getElementById("photoGrid").dataset.loaded = "false";
                await loadPhotos();
            } catch (error) {
                alert(error.message || "Upload failed.");
            } finally {
                button.disabled = false;
                button.innerHTML = '<i class="fa-solid fa-camera"></i> Add Checkpoint Images';
                event.target.value = "";
            }
        });

        async function deletePhoto(photoId) {
            if (!confirm("Delete this checkpoint image?")) return;
            const response = await fetch(`/SurveyJobs/DeleteCheckpointPhoto?photoId=${photoId}`, { method: "POST" });
            if (!response.ok) {
                alert(await response.text() || "Delete failed.");
                return;
            }
            document.getElementById("photoGrid").dataset.loaded = "false";
            await loadPhotos();
        }
    </script>
</body>
</html>
