@model Survery_Certification_App_Consume.Models.LoginUserDto

@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="width: 400px;">
        <h2 class="text-center mb-4">Login</h2>

        <form asp-action="Login" method="post">
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Login</button>
            <div class="text-center mt-2">
    <a href="#" class="text-primary" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">Forgot Password?</a>
</div>


            <div class="text-danger mt-3 text-center">
                @Html.ValidationSummary(true)
                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <p>@ViewBag.ErrorMessage</p>
                }
            </div>

            <div class="text-center mt-3">
                <p>Don't have an account? <a href="@Url.Action("landingpage", "Home")#register-section" class="text-primary">Register Here</a></p>
            </div>

        </form>
    </div>
</div>
<!-- 🔹 Forgot Password Modal -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Forgot Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>Email:</label>
                <input type="email" id="forgotEmail" class="form-control" required>

                <button class="btn btn-primary mt-3" onclick="sendOtp()">Send OTP</button>
            </div>
        </div>
    </div>
</div>

<!-- 🔹 OTP Verification Modal -->
<div class="modal fade" id="otpModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Verify OTP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>Enter OTP:</label>
                <input type="text" id="otpCode" class="form-control" placeholder="Enter 6-digit OTP" required>

                <button class="btn btn-success mt-3 w-100" onclick="verifyOtp()">Verify OTP</button>

                <!-- 🔹 Resend OTP Button -->
                <button id="resendOtpBtn" class="btn btn-secondary mt-2 w-100" onclick="resendOtp()">Resend OTP</button>
            </div>
        </div>
    </div>
</div>
<!-- 🔹 Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>New Password:</label>
                <input type="password" id="newPassword" class="form-control" required>

                <button class="btn btn-primary mt-3" onclick="resetPassword()">Reset Password</button>
            </div>
        </div>
    </div>
</div>

<script>
    let resetEmail = "";

    function getModal(id) {
        const element = document.getElementById(id);
        if (!element) return null;

        if (window.bootstrap && window.bootstrap.Modal) {
            return window.bootstrap.Modal.getOrCreateInstance(element);
        }

        return {
            show: function () {
                element.classList.add("show");
                element.style.display = "block";
                element.removeAttribute("aria-hidden");
                element.setAttribute("aria-modal", "true");
                document.body.classList.add("modal-open");
                if (!document.querySelector(".modal-backdrop")) {
                    const backdrop = document.createElement("div");
                    backdrop.className = "modal-backdrop fade show";
                    document.body.appendChild(backdrop);
                }
            },
            hide: function () {
                element.classList.remove("show");
                element.style.display = "none";
                element.setAttribute("aria-hidden", "true");
                element.removeAttribute("aria-modal");
                document.querySelectorAll(".modal-backdrop").forEach(x => x.remove());
                if (!document.querySelector(".modal.show")) {
                    document.body.classList.remove("modal-open");
                }
            }
        };
    }

    function showModal(id) {
        const modal = getModal(id);
        if (modal) modal.show();
    }

    function hideModal(id) {
        const modal = getModal(id);
        if (modal) modal.hide();
    }

    async function postJson(url, payload) {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const contentType = response.headers.get("content-type") || "";
        const data = contentType.includes("application/json")
            ? await response.json()
            : { success: response.ok, message: await response.text() };

        if (!response.ok && data.success !== true) {
            data.success = false;
        }

        return data;
    }

    // ✅ 1️⃣ Send OTP
    async function sendOtp() {
        const email = document.getElementById("forgotEmail").value.trim();
        if (!email) { alert("Enter your email!"); return; }

        try {
            const data = await postJson('/Auth/SendOtp', { email: email });
            if (!data.success) {
                alert(data.message || "Unable to send OTP.");
                return;
            }

            resetEmail = email;
            document.getElementById("resendOtpBtn").style.display = "block";
            document.getElementById("otpCode").readOnly = false;
            document.getElementById("otpCode").value = "";
            
                alert(data.message || "OTP sent successfully!");
            hideModal('forgotPasswordModal');
            showModal('otpModal');
        } catch (error) {
            alert("Unable to send OTP. Please check API connection and try again.");
        }
    }

    // ✅ 2️⃣ Verify OTP
    async function verifyOtp() {
        const otp = document.getElementById("otpCode").value.trim();
        const email = resetEmail || document.getElementById("forgotEmail").value.trim();
        if (!otp) { alert("Enter OTP!"); return; }

        try {
            const data = await postJson('/Auth/VerifyOtp', { email: email, otp: otp });
            if (!data.success) {
                alert(data.message || "Invalid or expired OTP.");
                return;
            }

            alert(data.message || "OTP verified!");
            document.getElementById("resendOtpBtn").style.display = "none";
            document.getElementById("otpCode").readOnly = true;
                hideModal('otpModal');
            showModal('resetPasswordModal');
        } catch (error) {
            alert("Unable to verify OTP. Please try again.");
        }
    }
     // ✅ 3️⃣ Resend OTP
    async function resendOtp() {
        const email = resetEmail || document.getElementById("forgotEmail").value.trim();
        if (!email) { alert("Enter your email first!"); return; }

        try {
            const data = await postJson('/Auth/ResendOtp', { email: email });
            alert(data.message || (data.success ? "New OTP sent successfully!" : "Unable to resend OTP."));
        } catch (error) {
            alert("Unable to resend OTP. Please try again.");
        }
    }


    // ✅ 3️⃣ Reset Password
      async function resetPassword() {
        const email = resetEmail || document.getElementById("forgotEmail").value.trim();
        const newPassword = document.getElementById("newPassword").value;
        const otp = document.getElementById("otpCode").value.trim();  // ✅ Get OTP from input field

        if (!newPassword) { alert("Enter new password!"); return; }
        if (!otp) { alert("Enter OTP!"); return; }  // ✅ Ensure OTP is included

        try {
            const data = await postJson('/Auth/ResetPassword', {
                email: email,
                newPassword: newPassword,
                otp: otp
            });

            if (!data.success) {
                alert(data.message || "Unable to reset password.");
                return;
            }

            alert(data.message || "Password reset successful!");
            location.reload();
        } catch (error) {
            alert("Unable to reset password. Please try again.");
        }
    }



</script>


<style>
    body {
        background: linear-gradient(to right, #6a11cb, #2575fc);
        font-family: 'Arial', sans-serif;
    }

    .modal-content {
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    }

    .btn {
        border-radius: 8px;
        font-weight: bold;
    }

    input.form-control {
        border-radius: 8px;
        height: 45px;
        font-size: 16px;
    }
</style>
