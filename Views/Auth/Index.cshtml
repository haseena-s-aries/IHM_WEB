@model Survery_Certification_App_Consume.Models.ProfileDto
@using System.Text.Json
@{
    var profileName = Model?.FullName ?? Context.Session.GetString("UserFullName") ?? "User";
    var profileEmail = Model?.Email ?? Context.Session.GetString("UserEmail") ?? "";
    var profileRole = Model?.Role ?? Context.Session.GetString("UserRole") ?? "";
    var profileId = Model?.UserId ?? Context.Session.GetInt32("UserId") ?? 0;
    string Js(string? value) => JsonSerializer.Serialize(value ?? string.Empty);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="container mt-4">
        <h2 class="text-center mb-4">Profile</h2>
        <button type="button" class="btn btn-secondary" onclick="goBack()">Back</button>


        <table class="table table-bordered table-hover text-center">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                <tr>
                    <td>@profileName</td>
                    <td>@profileEmail</td>
                    <td>@profileRole</td>
                    <td>
                        <button class="btn btn-warning btn-sm"
                                onclick="editUser(@profileId, @Html.Raw(Js(profileName)), @Html.Raw(Js(profileEmail)), @Html.Raw(Js(profileRole)))">
                            Edit
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Edit User Modal -->
    <div class="modal fade" id="editUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="editUserForm">
                        <input type="hidden" id="editUserId" name="Id">

                        <div class="mb-3">
                            <label class="form-label">Name:</label>
                            <input type="text" id="editUserName" name="FullName" class="form-control" >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email:</label>
                            <input type="email" readonly id="editUserEmail" name="Email" class="form-control" >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Role:</label>
                            <input type="text" readonly id="editUserRole" name="Role" class="form-control" >
                        </div>

                        <button type="button" class="btn btn-primary" onclick="updateUser()">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function goBack() {
        var role = '@ViewBag.UserRole';

        if (role === 'Admin' || role === 'Manager') {
            window.location.href = '/Home/AdminDashboard';
        } else if (role === 'Surveyor') {
            window.location.href = '/Home/Index';
        } else if (role === 'Client') {
            window.location.href = '/Home/ClientDashboard';
        } else {
            window.location.href = '/Home/Dashboard'; // for regular users
        }
    }

    $(document).ready(function () {
        fetchUserProfile();
    });

        function fetchUserProfile() {
            $.ajax({
                url: "/Auth/GetProfile",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        var user = response.data;
                        var userId = user.userId || user.UserId || user.id || user.Id || 0;
                        var fullName = user.fullName || user.FullName || "";
                        var email = user.email || user.Email || "";
                        var role = user.role || user.Role || "";
                        var row = `
                            <tr>
                                <td>${fullName}</td>
                                <td>${email}</td>
                                <td>${role}</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" onclick="editUser('${userId}', '${fullName}', '${email}', '${role}')">
                                        Edit
                                    </button>
                                </td>
                            </tr>`;
                        $("#userTableBody").html(row);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert("Error fetching user data.");
                }
            });
        }
        function editUser(id, name, email, role) {
               $("#editUserId").val(id);
               $("#editUserName").val(name);
               $("#editUserEmail").val(email);
               $("#editUserRole").val(role);
               $("#editUserModal").modal("show");
           }

                      function updateUser() {
            var fullName = $("#editUserName").val();
            var email = $("#editUserEmail").val();
            var role = $("#editUserRole").val();

            $.ajax({
                url: "/Auth/UpdateProfile",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    fullName: fullName,
                    email: email,
                    role: role
                }),
                success: function (response) {
                    alert(response.message);
                    $("#editUserModal").modal("hide");
                    location.reload();
                },
                error: function (xhr) {
                    var res = JSON.parse(xhr.responseText);
                    alert("Error: " + res.message + "\n" + (res.errors || []).join(', '));
                }
            });
        }


    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
