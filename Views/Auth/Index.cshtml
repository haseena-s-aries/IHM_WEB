@model Survery_Certification_App_Consume.Models.ProfileDto
@using System.Text.Json
@{
    var profileName = Model?.FullName ?? Context.Session.GetString("UserFullName") ?? "User";
    var profileEmail = Model?.Email ?? Context.Session.GetString("UserEmail") ?? "";
    var profileRole = Model?.Role ?? Context.Session.GetString("UserRole") ?? "";
    var profileId = Model?.UserId ?? Context.Session.GetInt32("UserId") ?? 0;
    string Js(string? value) => JsonSerializer.Serialize(value ?? string.Empty);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="container py-5">
        <div class="mx-auto" style="max-width:720px;">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <div class="text-uppercase text-primary fw-bold small">Account</div>
                    <h2 class="mb-0">My Profile</h2>
                </div>
                <button type="button" class="btn btn-outline-secondary" onclick="goBack()">
                    Back
                </button>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                             style="width:58px;height:58px;font-size:24px;font-weight:800;">
                            @profileName.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <h5 class="mb-1">@profileName</h5>
                            <div class="text-muted small">@profileRole</div>
                        </div>
                    </div>

                    <form id="profileForm">
                        <input type="hidden" id="profileUserId" value="@profileId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Name</label>
                            <input id="profileNameInput"
                                   class="form-control form-control-lg"
                                   value="@profileName"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input id="profileEmailInput"
                                   class="form-control"
                                   value="@profileEmail"
                                   readonly />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Role</label>
                            <input id="profileRoleInput"
                                   class="form-control"
                                   value="@profileRole"
                                   readonly />
                        </div>

                        <div class="d-flex gap-2">
                            <button id="editProfileBtn"
                                    type="button"
                                    class="btn btn-warning">
                                Edit 
                            </button>

                            <button id="saveProfileBtn"
                                    type="button"
                                    class="btn btn-primary d-none">
                                Save Changes
                            </button>

                            <button id="cancelProfileBtn"
                                    type="button"
                                    class="btn btn-light d-none">
                                Cancel
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

   

    <script>
        function goBack() {
        var role = '@ViewBag.UserRole';

        if (role === 'Admin' || role === 'Manager') {
            window.location.href = '/Home/AdminDashboard';
        } else if (role === 'Surveyor') {
            window.location.href = '/Home/Index';
        } else if (role === 'Client') {
            window.location.href = '/Home/ClientDashboard';
        } else {
            window.location.href = '/Home/Dashboard'; // for regular users
        }
    }

            const originalName = @Html.Raw(Js(profileName));

        document.getElementById("editProfileBtn")?.addEventListener("click", function () {
            const nameInput = document.getElementById("profileNameInput");
            nameInput.removeAttribute("readonly");
            nameInput.focus();
            nameInput.select();

            document.getElementById("editProfileBtn").classList.add("d-none");
            document.getElementById("saveProfileBtn").classList.remove("d-none");
            document.getElementById("cancelProfileBtn").classList.remove("d-none");
        });

        document.getElementById("cancelProfileBtn")?.addEventListener("click", function () {
            const nameInput = document.getElementById("profileNameInput");
            nameInput.value = originalName;
            nameInput.setAttribute("readonly", "readonly");

            document.getElementById("editProfileBtn").classList.remove("d-none");
            document.getElementById("saveProfileBtn").classList.add("d-none");
            document.getElementById("cancelProfileBtn").classList.add("d-none");
        });

        document.getElementById("saveProfileBtn")?.addEventListener("click", function () {
            const fullName = document.getElementById("profileNameInput").value.trim();
            const email = document.getElementById("profileEmailInput").value;
            const role = document.getElementById("profileRoleInput").value;

            if (!fullName) {
                alert("Name is required.");
                return;
            }

            $.ajax({
                url: "/Auth/UpdateProfile",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    fullName: fullName,
                    email: email,
                    role: role
                }),
                success: function (response) {
                    alert(response.message || "Profile updated successfully.");
                    location.reload();
                },
                error: function (xhr) {
                    let message = "Profile update failed.";
                    try {
                        const res = JSON.parse(xhr.responseText);
                        message = res.message || res.Message || message;
                    } catch {}
                    alert(message);
                }
            });
        });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
