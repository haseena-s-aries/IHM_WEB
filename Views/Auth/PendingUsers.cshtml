@model List<PendingUser>

@{
    ViewBag.Title = "Pending User Approvals";
    var projects = ViewBag.Projects as List<ProjectOption> ?? new List<ProjectOption>();
}
<!-- Profile Modal -->

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Pending User Approvals</h4>
            <button type="button" class="btn btn-secondary" onclick="goBack()">Back</button>
        </div>

        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="table-responsive">
                <table class="table table-striped table-hover text-center align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Requested Role</th>
                            <th>Requested Project</th>
                            <th>Approve Project</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-muted">No pending users to approve.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>@user.RequestedRole</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.ProjectName) ? "-" : user.ProjectName)</td>
                                    <td>
                                        <select name="projectId"
                                                form="approve-form-@user.Id"
                                                class="form-select form-select-sm"
                                                required>
                                            <option value="">Select project</option>

                                            @foreach (var project in projects)
                                            {
                                                <option value="@project.Id" selected="@(project.Id == user.ProjectId)">
                                                    @project.Name
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <form id="approve-form-@user.Id" asp-action="ApproveUser" method="post">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check-circle-fill"></i> Approve
                                                </button>
                                            </form>

                                            <form asp-action="RejectUser" method="post"
                                                  onsubmit="return confirm('Are you sure you want to reject this user?');">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-x-circle-fill"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons CDN if not included -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />


<!-- Optional: Add Bootstrap Icons if not already included -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<script src="~/lib/jquery/jquery.min.js"></script>
    <script>
         function goBack() {
                if (document.referrer) {
                  window.location.href = '@Url.Action("AdminDashboard", "Home")';
                } 
            }
    $(document).ready(function () {
        fetchUserProfile();
    });
 
</script>

