@model TowageCertificate


<style>
    .card.form-step {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #212529;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.05);
        border-radius: 12px;
    }

    .card-header {
        background-color: #007bff !important;
        color: white;
        font-weight: bold;
        font-size: 1.2rem;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }

    .form-label {
        font-weight: 500;
        color: #495057;
    }

    .form-control, .form-select {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 8px;
        padding: 0.45rem 0.9rem;
        transition: border-color 0.2s ease-in-out;
    }

        .form-control:focus, .form-select:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
        }

    .form-check-input {
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #007bff;
            border-color: #007bff;
        }

    .form-check-label {
        margin-left: 0.25rem;
        color: #343a40;
    }

    .btn-secondary, .btn-primary {
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
    }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
    }

    .btn:hover {
        opacity: 0.9;
    }

    .text-danger {
        font-size: 0.85rem;
    }

    .form-step .row > div {
        margin-bottom: 1rem;
    }

    #manualCertificateTitle {
        border: 1px dashed #adb5bd;
    }

 
</style>
<form asp-action="GeneratePDF" method="post" class="row g-3">
    <input type="hidden" name="IncludeCargoDetails" value="true" />
    <input type="hidden" asp-for="PdfFilePath"
           value="@($"Towage_{DateTime.UtcNow:yyyyMMdd_HHmmss}.pdf")" />
    <input type="hidden" name="IncludeAnnexure2" value="true" />
    <!-- STEP 1 -->
    <div class="card mb-4 form-step" id="step1">
        <div class="card-header bg-primary text-white">
            1.1.1 – General Information
        </div>
        <div class="card-body row">
            <div class="form-group">
                <label>SELECT HEADER IMAGE OF CERTIFICATE</label>
                <select asp-for="HeaderImagePath" class="form-control" id="headerImageDropdown">
                    <option value="/images/blank.png" data-img="/images/blank.png">No Header</option>
                    <option value="/images/SaudiArablogo.jpg" data-img="/images/SaudiArablogo.jpg">ARIES MARINE SERVICES CO.LTD</option>
                    <option value="/images/QatarLogo.jpg" data-img="/images/QatarLogo.jpg">ARIES MARINE CO.WLL.</option>
                    <option value="/images/Baharin.W.L.L.png" data-img="/images/Baharin.W.L.L.png">ARIES BAHRAIN Marine W.L.L</option>
                    <option value="/images/MARINE.LLC.png" data-img="/images/MARINE.LLC.png">ARIES MARINE L.L.C</option>
                    <option value="/images/OILFIELDSERVICELOGO.png" data-img="/images/OILFIELDSERVICELOGO.png">Aries  Oil Field Services LLC</option>
                   
                </select>
            </div>


            <div class="col-md-6">
                <label asp-for="CertificateNumber" class="form-label">CERTIFICATE NUMBER</label>
                <input asp-for="CertificateNumber" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="CertificateNumber" class="text-danger"></span>


                <div class="col-md-6">
                    <label asp-for="JobNumber" class="form-label">JOB NUMBER</label>
                    <input asp-for="JobNumber" class="form-control"
                           oninput="this.value = this.value.toUpperCase();"
                           required />
                    <span asp-validation-for="JobNumber" class="text-danger"></span>
                </div>

            </div>
            <div class="col-md-6">
                <label asp-for="CertificateType" class="form-label">CERTIFICATE TYPE</label>

                <select id="projectTitleDropdown" class="form-control" onchange="toggleManualInput(this)" required>
                    <option value="">-- Select Certificate Title --</option>
                    <option value="ARIES MARINE SERVICES CO. LTD">ARIES MARINE SERVICES CO. LTD</option>
                    <option value="ARIES MARINE CO. WLL.">ARIES MARINE CO. WLL.</option>
                    <option value="ARIES BAHRAIN MARINE W.L.L">ARIES BAHRAIN Marine W.L.L</option>
                    <option value="ARIES MARINE L.L.C">ARIES MARINE L.L.C</option>
                    <option value="ARIES OIL FIELD SERVICES L.L.C">ARIES OIL FIELD SERVICES L.L.C</option>
                    <option value="manual">Other (Enter Manually)</option>
                </select>

                <input type="text" id="manualCertificateTitle"
                       class="form-control mt-2"
                       placeholder="Enter Certificate Title"
                       maxlength="50"
                       style="display:none;"
                       oninput="this.value = this.value.toUpperCase(); updateHiddenField(this);" />
                <!-- This will be posted to the backend -->
                <input asp-for="CertificateType" id="CertificateTitle" type="hidden" />

                <span asp-validation-for="CertificateType" class="text-danger"></span>
            </div>



            <div class="col-md-6">
                <label asp-for="ProjectTitle" class="form-label">PROJECT NAME</label>
                <input asp-for="ProjectTitle" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="ProjectTitle" class="text-danger"></span>
            </div>


            <div class="col-md-6">
                <label asp-for="ClientName" class="form-label">CLIENT</label>
                <input asp-for="ClientName" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="ClientName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TowName" class="form-label">NAME OF TOW</label>
                <input asp-for="TowName" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="TowName" class="text-danger"></span>
            </div>


            <div class="col-md-6">
                <label asp-for="TugName" class="form-label">NAME OF TUG</label>
                <input asp-for="TugName" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="TugName" class="text-danger"></span>
            </div>


            <div class="col-md-6">
                <label asp-for="Cargo" class="form-label">CARGO</label>
                <input asp-for="Cargo" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="Cargo" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DeparturePort" class="form-label">FROM LOCATION</label>
                <input asp-for="DeparturePort" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="DeparturePort" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ArrivalPort" class="form-label">TO LOCATION</label>
                <input asp-for="ArrivalPort" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="ArrivalPort" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SurveyedBy" class="form-label">SURVEYED BY</label>
                <input asp-for="SurveyedBy" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="SurveyedBy" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ReviewedBy" class="form-label">REVIEWED BY</label>
                <input asp-for="ReviewedBy" class="form-control"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="ReviewedBy" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mb-2">
                    <input asp-for="NoDateCheckbox" class="form-check-input" type="checkbox" id="noDateCheckbox" />
                    <label class="form-check-label" for="noDateCheckbox">NA</label>
                </div>

                <label asp-for="IssuedDate" class="form-label" id="issuedDateLabel">ISSUED DATE</label>
                <input asp-for="IssuedDate" class="form-control" type="date" id="issuedDateInput" />
            </div>

            <!-- your inputs like HeaderImage, CertificateNumber, etc. -->
            <div class="col-md-12 text-end mt-3">
                <button type="button" class="btn btn-secondary" onclick="goBack()">Back</button>
                <button type="button" class="btn btn-primary" onclick="nextStep(2)">Next</button>
            </div>
        </div>
    </div>



    <!-- STEP 2 -->
    <div class="card mb-4 form-step d-none" id="step2">
        <div class="card-header bg-primary text-white">

            1.1.2 – Default  Recommendations
        </div>
        <div class="form-check">
 
        </div>
   <div id="defaultrecommendations-section" class="container mt-4" style="display: block;">
            <table class="table table-bordered" id="defaultRecommendationsTable">
                <thead>
                    <tr>
                        <th>SL. No.</th>
                        <th>Recommendation</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.defaultRecommendations.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>
                                <span>@Model.defaultRecommendations[i].RecommendationText</span>
                                <input type="hidden" name="defaultRecommendations[@i].RecommendationText" value="@Model.defaultRecommendations[i].RecommendationText" />
                                <input type="hidden" name="defaultRecommendations[@i].Id" value="@Model.defaultRecommendations[i].Id" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-warning btn-sm" onclick="editRecommendation(@i)">Edit</button>
                                <button type="button" class="btn btn-danger btn-sm" onclick="removeDefaultRow(this)">Remove</button>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn-primary btn-sm" onclick="addDefaultRecommendation()">Add New Recommendation</button>
            <div id="editPanel" class="position-fixed top-0 end-0 bg-white shadow p-4"
                 style="width: 400px; height: 100vh; display: none; z-index: 1050;">
                <h5>Edit Recommendation</h5>
                <textarea id="editTextarea" class="form-control" rows="6"></textarea>
                <br />
                <button type="button" class="btn btn-primary" onclick="saveEditedRecommendation()">Save</button>
                <button type="button" class="btn btn-secondary" onclick="closeEditPanel()">Cancel</button>
            </div>


            </div>
            <!-- your Recommendations section -->
            <div class="text-end mt-3">
                <button type="button" class="btn btn-secondary" onclick="nextStep(1)">Back</button>
                <button type="button" class="btn btn-primary" onclick="nextStep(3)">Next</button>
            </div>
        </div>
    


    <!-- STEP 3 (example for cargo details) -->
    <div class="card mb-4 form-step d-none" id="step3">
        <div class="card-header bg-primary text-white">
            1.1.3 – Cargo Details
        </div>
        <div class="card-body">
            <!-- Cargo NA Checkbox -->
            <div class="form-check mb-2">
                <input type="hidden" name="IsCargoDetailsNA" value="false" />
                <input class="form-check-input" type="checkbox" id="hideCargoCheckbox"
                       name="IsCargoDetailsNA" value="true"
                       onchange="toggleCargoCheckbox()" @(Model.IsCargoDetailsNA ? "checked" : "") />
                <label class="form-check-label" for="hideCargoCheckbox">
                    Mark Cargo Details as N/A
                </label>
            </div>

            <!-- Cargo Details Table Section -->
            <div id="cargo-details-section" class="container mt-4" style="display: @(Model.IsCargoDetailsNA ? "none" : "block");">
                <div class="text-end mb-3">
                    <button type="button" class="btn btn-primary" onclick="addCargoRow()">ADD CARGO DETAIL</button>
                </div>

                <table class="table table-bordered" id="cargoTable">
                    <thead class="table-secondary text-center">
                        <tr>
                            <th>Sr.</th>
                            <th>Location</th>
                            <th>Cargo</th>
                            <th>ID Markings</th>
                            <th>Weight</th>
                            <th>Dimensions</th>
                            <th>Remarks</th>
                            <th style="width: 5%;">🗑️</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.CargoDetails.Count; i++)
                        {
                            <tr>
                                <td class="text-center">@(@i + 1)</td> <!-- Sr No. -->

                                <td>
                                    <input type="text" name="CargoDetails[@i].Location"
                                           class="form-control"
                                           value="@(Model.CargoDetails[i].Location ?? "")" />
                                </td>

                                <td>
                                    <input type="text" name="CargoDetails[@i].Cargos"
                                           class="form-control"
                                           value="@(Model.CargoDetails[i].Cargos ?? "")" />
                                </td>

                                <td>
                                    <input type="text" name="CargoDetails[@i].IDMarkings"
                                           class="form-control"
                                           value="@(Model.CargoDetails[i].IDMarkings ?? "")" />
                                </td>

                                <td>
                                    <input type="text" name="CargoDetails[@i].Weight"
                                           class="form-control"
                                           value="@(Model.CargoDetails[i].Weight ?? "")" />
                                </td>

                                <td>
                                    <input type="text" name="CargoDetails[@i].Dimensions"
                                           class="form-control"
                                           value="@(Model.CargoDetails[i].Dimensions ?? "")" />
                                </td>

                                <td>
                                    <input type="text" name="CargoDetails[@i].Remarks"
                                           class="form-control"
                                           placeholder="Optional"
                                           value="@(Model.CargoDetails[i].Remarks ?? "")" />
                                </td>
                            </tr>

                        }
                    </tbody>

                </table>
            </div>

            <!-- Navigation -->
            <div class="text-end mt-3">
                <button type="button" class="btn btn-secondary" onclick="nextStep(2)">Back</button>
                <button type="button" class="btn btn-primary" onclick="nextStep(4)">Next</button>
            </div>
        </div>
    </div>

  



   <!-- STEP 5 (Surveyor Signature) -->
<div class="card mb-4 form-step d-none" id="step4">
    <div class="card-header bg-primary text-white">
        1.1.4 – Surveyor Signature
    </div>
    <div class="card-body">

        <!-- NA Checkbox -->
        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="signatureNA" />
            <label class="form-check-label" for="signatureNA">
                Surveyor Signature Not Applicable
            </label>
        </div>

        <!-- Signature Upload Section -->
