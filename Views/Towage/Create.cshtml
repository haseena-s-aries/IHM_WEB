@{
    var apiBaseUrl = ViewBag.ApiBaseUrl;  // Get the ApiBaseUrl from the controller
}
@section Scripts {
    <script>
        let editingIndex = null;

        function editRecommendation(index) {
            editingIndex = index;
            const row = document.querySelectorAll("#defaultRecommendationsTable tbody tr")[index];
            const currentText = row.querySelector(`input[name='defaultRecommendations[${index}].RecommendationText']`).value;
            document.getElementById("editTextarea").value = currentText;
            document.getElementById("editPanel").style.display = "block";
        }

        function saveEditedRecommendation() {
            if (editingIndex === null) return;

            const newText = document.getElementById('editTextarea').value.trim();
            const formattedText = newText.replace(/\r?\n/g, "<br>");

            const row = $('#defaultRecommendationsTable tbody tr').eq(editingIndex);
            row.find('span').html(formattedText);
            row.find('input[name$=".RecommendationText"]').val(newText);

            closeEditPanel();
        }

        function closeEditPanel() {
            document.getElementById("editPanel").style.display = "none";
            document.getElementById("editTextarea").value = "";
            editingIndex = null;
        }


        function removeDefaultRow(button) {
            const row = button.closest("tr");
            row.remove();
        }

             function addDefaultRecommendation() {
            const table = document.getElementById("defaultRecommendationsTable").getElementsByTagName("tbody")[0];
            const rowCount = table.rows.length;

            if (rowCount >= 25) {
                alert("You can only add up to 25 recommendations.");
                return;
            }

            const row = table.insertRow();
            row.innerHTML = `
                <td>${rowCount + 1}</td>
                <td>
                    <input type="text" name="defaultRecommendations[${rowCount}].RecommendationText" class="form-control" />
                    <input type="hidden" name="defaultRecommendations[${rowCount}].Id" value="0" />
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeDefaultRow(this)">Remove</button>
                </td>`;
        }

             function addDefaultRecommendation() {
            const table = document.getElementById("defaultRecommendationsTable").getElementsByTagName("tbody")[0];
            const rowCount = table.rows.length;
            const row = table.insertRow();
            row.innerHTML = `
                <td>${rowCount + 1}</td>
                <td>
                    <input type="text" name="defaultRecommendations[${rowCount}].RecommendationText" class="form-control" />
                    <input type="hidden" name="defaultRecommendations[${rowCount}].Id" value="0" />
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeDefaultRow(this)">Remove</button>
                </td>`;
        }

        function removeDefaultRow(button) {
            const row = button.closest("tr");
            row.remove();
            // Optionally renumber SL. No and indexes
        }

         $(document).ready(function () {
            var currentStep = parseInt($("#CurrentStep").val()) || 1;

            if (currentStep > 1) {
                $(".step-section").hide();
                $("#step" + currentStep).show();
                $(".step-link").removeClass("active");
                $(".step-link[data-step='" + currentStep + "']").addClass("active");
            }
        });

        
        
        // =================================================================================
        

                      function toggleManualInput(select) {
            const manualInput = document.getElementById("manualCertificateTitle");
            const hiddenInput = document.getElementById("CertificateTitle");

            if (select.value === "manual") {
                manualInput.style.display = "block";
                manualInput.required = true;
                hiddenInput.value = manualInput.value.toUpperCase();
            } else {
                manualInput.style.display = "none";
                manualInput.required = false;
                manualInput.value = '';
                hiddenInput.value = select.value.toUpperCase();
            }
        }
        function updateHiddenField(input) {
               const hiddenField = document.getElementById("CertificateTitle");
               const value = input.value.toUpperCase();
               if (value.length <= 50) {
                   hiddenField.value = value;
               } else {
                   input.value = value.slice(0, 40); // Trim excess
                   hiddenField.value = input.value;
               }
           }


        // =================================================================================
         function goBack() {
            const referrer = document.referrer;
            if (referrer) {
                // Redirect to previous page and clear history
                window.location.replace(referrer);
            } else {
                // If no referrer, redirect to a default page
                window.location.replace('/default-page');
            }
        }

        // =================================================================================
                        function nextStep(stepNumber) {
            const currentStep = document.querySelector('.form-step:not(.d-none)');
            const currentStepNumber = parseInt(currentStep.id.replace("step", ""));
            const isGoingBack = stepNumber < currentStepNumber;

            // Skip validation if going back
            if (!isGoingBack) {
                      const requiredFields = Array.from(
            currentStep.querySelectorAll('input[required], select[required], textarea[required]')
        ).filter(field =>
            !field.disabled &&
            field.type !== "hidden" &&
            field.offsetParent !== null
        );

                let isValid = true;
