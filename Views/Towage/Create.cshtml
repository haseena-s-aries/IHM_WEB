                </button>
                @* <button type="submit" formaction="/Towage/GenerateWord" class="btn btn-secondary">
                    Generate Word Certificate
                </button> *@



                <button type="submit" class="btn btn-primary">Generate PDF</button>
          
                <div class="mt-4">
