        <div class="card-header bg-primary text-white">
            1.1.5 – Approver Signature block
        </div>
        <div class="card-body">
            <!-- NA Checkbox -->
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="clientSignatureNA" />
                <label class="form-check-label" for="clientSignatureNA">
                    Approver Signature Not Applicable
                </label>
            </div>

            <!-- Client Signature Upload Section -->
            <div class="mb-3" id="clientSignatureSection">
                <label for="signatureClientUpload" class="form-label">Upload Approver Signature</label>
                <input type="file" id="signatureClientUpload" class="form-control" accept=".jpg,.jpeg,.png" />

                <button type="button" onclick="uploadClientSignature()"
                        class="btn btn-sm btn-secondary mt-2">
                    Upload Approver Signature
                </button>

                <!-- hidden field to store uploaded path -->
                <input type="hidden" name="SignatureClient" id="SignatureClient" />

                <!-- optional preview -->
                <img id="clientSignaturePreview" src="" alt="Approver Signature Preview"
                     style="display:none;max-height:100px;margin-top:10px;border:1px solid #ddd;padding:4px;" />
            </div>

            <div class="text-end mt-3">
                <button type="button" class="btn btn-secondary" onclick="nextStep(4)">Back</button>
                <button type="button" class="btn btn-primary" onclick="nextStep(6)">Next</button>
            </div>
        </div>
    </div>



    <!-- STEP 6 (stamp) -->
    <div class="card mb-4 form-step d-none" id="step6">
        <div class="card-header bg-primary text-white">
            1.1.6 - Stamp
        </div>
        <div class="card-body">

            <!-- NA Checkbox -->
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="stampNA" />
                <label class="form-check-label" for="stampNA">Stamp Not Applicable</label>
            </div>

            <!-- Stamp Upload Section -->
            <div class="mb-3" id="stampSection">
